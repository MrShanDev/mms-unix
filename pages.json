{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^mms-(.*)": "@/uni_modules/mms-unix/components/mms-$1/mms-$1.uvue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "首页",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/user/user",
			"style": {
				"navigationBarTitleText": "我的",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/register/register",
			"style": {
				"navigationBarTitleText": "注册",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/forgot-password/forgot-password",
			"style": {
				"navigationBarTitleText": "找回密码",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/webview/webview",
			"style": {
				"navigationBarTitleText": "网页",
				"navigationStyle": "custom"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages_Article",
			"pages": [
				{ "path": "articleList/articleList", "style": { "navigationBarTitleText": "文章列表", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } },
				{ "path": "articleDetails/articleDetails", "style": { "navigationBarTitleText": "文章详情", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } }
			]
		},
		{
			"root": "pages_Me",
			"pages": [
				{ "path": "login/weixinLoging", "style": { "navigationBarTitleText": "登录", "navigationStyle": "custom" } },
				{ "path": "user_info/index", "style": { "navigationBarTitleText": "个人信息", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } },
				{ "path": "user_address/index", "style": { "navigationBarTitleText": "收货地址", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } },
				{ "path": "user_setting_address/user_setting_address", "style": { "navigationBarTitleText": "地址", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } },
				{ "path": "about_me/about_me", "style": { "navigationBarTitleText": "关于我们", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } }
			]
		}
	],
	"tabBar": {
		"color": "#999",
		"selectedColor": "#ff2727",
		"backgroundColor": "#fff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页",
				"iconPath": "/static/tabbar/mms-home.png",
				"selectedIconPath": "/static/tabbar/mms-home-fill.png"
			},
			{
				"pagePath": "pages/user/user",
				"text": "我的",
				"iconPath": "/static/tabbar/mms-me.png",
				"selectedIconPath": "/static/tabbar/mms-me-fill.png"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "MMS-UNIX",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {}
}
