	"tabBar": {
		"color": "#999",
		"selectedColor": "#ff0844",
		"backgroundColor": "#fff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/components/components",
				"text": "%tabbar.components%",
				"iconPath": "/static/tabbar/tab-components.png",
				"selectedIconPath": "/static/tabbar/tab-components-active.png"
			},
			{
				"pagePath": "pages/tools/tools",
				"text": "%tabbar.tools%",
				"iconPath": "/static/tabbar/tab-tools.png",
				"selectedIconPath": "/static/tabbar/tab-tools-active.png"
			},
			{
				"pagePath": "pages/templates/templates",
				"text": "%tabbar.templates%",
				"iconPath": "/static/tabbar/tab-templates.png",
				"selectedIconPath": "/static/tabbar/tab-templates-active.png"
			},
			{
				"pagePath": "pages/user/user",
				"text": "%tabbar.user%",
				"iconPath": "/static/tabbar/tab-user.png",
				"selectedIconPath": "/static/tabbar/tab-user-active.png"
			}
		]
