{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^mms-(.*)": "@/uni_modules/mms-unix/components/mms-$1/mms-$1.uvue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "%page.home%",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/user/user",
			"style": {
				"navigationBarTitleText": "%page.user%",
				"navigationStyle": "custom"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages_demo",
			"pages": [
				{ "path": "index", "style": { "navigationBarTitleText": "组件演示" } },
				{ "path": "button/button", "style": { "navigationBarTitleText": "Button 按钮" } },
				{ "path": "cell/cell", "style": { "navigationBarTitleText": "Cell 单元格" } },
				{ "path": "dialog/dialog", "style": { "navigationBarTitleText": "Dialog 弹窗" } },
				{ "path": "popup/popup", "style": { "navigationBarTitleText": "Popup 弹出层" } },
				{ "path": "toast/toast", "style": { "navigationBarTitleText": "Toast 轻提示" } },
				{ "path": "loading/loading", "style": { "navigationBarTitleText": "Loading 加载" } },
				{ "path": "empty/empty", "style": { "navigationBarTitleText": "Empty 空状态" } },
				{ "path": "icon/icon", "style": { "navigationBarTitleText": "Icon 图标" } },
				{ "path": "tag/tag", "style": { "navigationBarTitleText": "Tag 标签" } },
				{ "path": "price/price", "style": { "navigationBarTitleText": "Price 价格" } },
				{ "path": "countdown/countdown", "style": { "navigationBarTitleText": "Countdown 倒计时" } },
				{ "path": "search/search", "style": { "navigationBarTitleText": "Search 搜索" } },
				{ "path": "grid/grid", "style": { "navigationBarTitleText": "Grid 宫格" } },
				{ "path": "card/card", "style": { "navigationBarTitleText": "Card 卡片" } },
				{ "path": "upload/upload", "style": { "navigationBarTitleText": "Upload 上传" } },
				{ "path": "qrcode/qrcode", "style": { "navigationBarTitleText": "QRCode 二维码" } },
				{ "path": "watermark/watermark", "style": { "navigationBarTitleText": "Watermark 水印" } },
				{ "path": "login/login", "style": { "navigationBarTitleText": "Login 登录" } }
			]
		},
		{
			"root": "pages_Article",
			"pages": [
				{ "path": "articleList/articleList", "style": { "navigationBarTitleText": "%page.articleList%", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } },
				{ "path": "articleDetails/articleDetails", "style": { "navigationBarTitleText": "%page.articleDetails%", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } }
			]
		},
		{
			"root": "pages_Me",
			"pages": [
				{ "path": "login/login", "style": { "navigationBarTitleText": "%page.login%", "navigationStyle": "custom" } },
				{ "path": "login/weixinLoging", "style": { "navigationBarTitleText": "%page.login%", "navigationStyle": "custom" } },
				{ "path": "register", "style": { "navigationBarTitleText": "%page.register%", "navigationStyle": "custom" } },
				{ "path": "forgot-password/forgot-password", "style": { "navigationBarTitleText": "%page.forgotPassword%", "navigationStyle": "custom" } },
				{ "path": "user_info/index", "style": { "navigationBarTitleText": "%page.userInfo%", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } },
				{ "path": "user_address/index", "style": { "navigationBarTitleText": "%page.userAddress%", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } },
				{ "path": "user_setting_address/user_setting_address", "style": { "navigationBarTitleText": "%page.address%", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } },
				{ "path": "about_me/about_me", "style": { "navigationBarTitleText": "%page.aboutMe%", "navigationBarBackgroundColor": "#ff2727", "navigationBarTextStyle": "white" } }
			]
		}
	],
	"tabBar": {
		"color": "#999",
		"selectedColor": "#ff2727",
		"backgroundColor": "#fff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "%tabbar.home%",
				"iconPath": "/static/tabbar/mms-home.png",
				"selectedIconPath": "/static/tabbar/mms-home-fill.png"
			},
			{
				"pagePath": "pages/user/user",
				"text": "%tabbar.user%",
				"iconPath": "/static/tabbar/mms-me.png",
				"selectedIconPath": "/static/tabbar/mms-me-fill.png"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "%app.name%",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {}
}