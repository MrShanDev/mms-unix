<!--
 * 应用入口组件
 * 负责监听应用生命周期事件，并引入全局样式
 -->
<script setup>
	// 应用启动完成
	onLaunch(() => {
		console.log('App Launch')
		// 加载自定义字体
		loadIconFont()
		// 检查小程序版本更新
		checkForUpdate()
	})

	/**
	 * 加载自定义图标字体
	 */
	function loadIconFont() {
		uni.loadFontFace({
			family: 'iconfont',
			source: 'url("/static/iconfont/iconfont.ttf")',
			success: () => {
				console.log('图标字体加载成功')
			},
			fail: (err) => {
				console.log('图标字体加载失败', err)
			}
		})
	}

	/**
	 * 检查小程序版本更新
	 * 在小程序环境下检测是否有新版本，如果有则提示用户更新
	 */
	function checkForUpdate() {
		// 判断是否为小程序环境（使用 any 绕过类型检查，因为 canIUse 是小程序特有 API）
		const uniAny = uni as any
		if (typeof uniAny.canIUse === 'function' && uniAny.canIUse('getUpdateManager')) {
			const updateManager = uniAny.getUpdateManager()
			// 检查更新
			updateManager.onCheckForUpdate((res) => {
				console.log('检查更新结果：', res.hasUpdate)
			})
			// 有新版本下载完成
			updateManager.onUpdateReady(() => {
				uni.showModal({
					title: '更新提示',
					content: '新版本已经准备好，是否重启应用？',
					success: (modalRes) => {
						if (modalRes.confirm) {
							// 应用新版本并重启
							updateManager.applyUpdate()
						}
					}
				})
			})
			// 更新失败
			updateManager.onUpdateFailed(() => {
				uni.showModal({
					title: '更新提示',
					content: '新版本下载失败，请检查网络后重试',
					showCancel: false
				})
			})
		}
	}

	// 应用显示到前台
	onShow(() => {
		console.log('App Show')
	})

	// 应用切换到后台
	onHide(() => {
		console.log('App Hide')
	})
</script>

<style lang="scss">
// 引入 mms-unix 全局样式
@import '@/uni_modules/mms-unix/index.scss';
</style>