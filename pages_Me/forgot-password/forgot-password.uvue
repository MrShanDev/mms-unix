<template>
	<view class="forgot-page">
		<!-- 顶部渐变区域（与登录页一致） -->
		<view class="forgot-header">
			<view class="nav-back" @tap="goBack">
				<m-icon name="arrow-left" size="48rpx" color="#ffffff"></m-icon>
			</view>
			<text class="forgot-title">找回密码</text>
			<text class="forgot-desc">通过手机验证码重置密码</text>
		</view>
		<!-- 表单卡片 -->
		<view class="forgot-card">
			<view class="input-wrap">
				<input class="input" type="number" placeholder="手机号" v-model="phone" :maxlength="11" />
			</view>
			<view class="input-wrap code-wrap">
				<input class="input" type="number" placeholder="验证码" v-model="code" :maxlength="6" />
				<text :class="['get-code', { disabled: countdown > 0 }]" @tap="getCode">
					{{ countdown > 0 ? countdown + 's' : '获取验证码' }}
				</text>
			</view>
			<view class="input-wrap">
				<input class="input" type="password" placeholder="新密码" v-model="password" />
			</view>
			<view class="input-wrap">
				<input class="input" type="password" placeholder="确认新密码" v-model="confirmPassword" />
			</view>
			<button class="submit-btn" @tap="handleSubmit">确认重置</button>
			<view class="go-login" @tap="goLogin">
				<text class="go-login-text">返回登录</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { storage } from '@/uni_modules/m-unix/components/m-tools/Storage.uts'
	import { findPassword, mallSendSmsCode } from '@/common/api/baseApi'

	const phone = ref('')
	const code = ref('')
	const password = ref('')
	const confirmPassword = ref('')
	const countdown = ref(0)
	const loading = ref(false)
	let countTimer : number | null = null

	function saveLoginUser(data: any) {
		if (data != null) {
			const token = data['token']
			if (token != null && token != '') {
				storage.setToken(token as string)
			}
			storage.setUserInfo({
				id: data['id'],
				nickname: data['nickname'] ?? '',
				account: data['account'] ?? '',
				phone: data['phone'] ?? '',
			})
		}
	}

	const getCode = () => {
		if (countdown.value > 0) return
		if (phone.value == '' || phone.value.length !== 11) {
			uni.showToast({ title: '请输入正确手机号', icon: 'none' })
			return
		}
		mallSendSmsCode({ phone: phone.value, type: 3 }).then(res => {
			if (res.code == 200) {
				countdown.value = 60
				countTimer = setInterval(() => {
					countdown.value--
					if (countdown.value <= 0 && countTimer != null) {
						clearInterval(countTimer)
						countTimer = null
					}
				}, 1000)
				uni.showToast({ title: '验证码已发送', icon: 'success' })
			} else {
				uni.showToast({ title: res.msg ?? '发送失败', icon: 'none' })
			}
		}).catch(() => {
			uni.showToast({ title: '网络异常，请重试', icon: 'none' })
		})
	}

	const handleSubmit = () => {
		if (phone.value == '' || code.value == '' || password.value == '' || confirmPassword.value == '') {
			uni.showToast({ title: '请填写完整信息', icon: 'none' })
			return
		}
		if (password.value.length < 6 || password.value.length > 16) {
			uni.showToast({ title: '密码长度应在6~16位之间', icon: 'none' })
			return
		}
		if (password.value !== confirmPassword.value) {
			uni.showToast({ title: '两次密码不一致', icon: 'none' })
			return
		}
		if (loading.value) return
		loading.value = true
		findPassword({ phone: phone.value, smsCode: code.value, password: password.value }).then(res => {
			if (res.code == 200 && res.data != null) {
				saveLoginUser(res.data)
				uni.showToast({ title: '密码重置成功', icon: 'success' })
				setTimeout(() => {
					uni.navigateBack()
				}, 500)
			} else {
				uni.showToast({ title: res.msg ?? '重置失败', icon: 'none' })
			}
		}).catch(() => {
			uni.showToast({ title: '网络异常，请重试', icon: 'none' })
		}).finally(() => {
			loading.value = false
		})
	}

	const goLogin = () => {
		uni.navigateTo({ url: '/pages_Me/login/login' })
	}
	const goBack = () => {
		uni.navigateBack()
	}
</script>

<style lang="scss" scoped>
	.forgot-page {
		min-height: 100vh;
		background: linear-gradient(180deg, #ffefef 0%, #ffe8e8 50%, #f5f5f5 100%);
		display: flex;
		flex-direction: column;
		padding-bottom: 40rpx;
	}
	.forgot-header {
		height: 360rpx;
		background: linear-gradient(135deg, #ff0844 0%, #ff3d62 50%, #ff8a9e 100%);
		padding: 180rpx 40rpx 0;
		position: relative;
	}
	.nav-back {
		position: absolute;
		top: 80rpx;
		left: 30rpx;
		width: 64rpx;
		height: 64rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		z-index: 10;
	}
	.forgot-title {
		font-size: 44rpx;
		font-weight: bold;
		color: #fff;
		margin-bottom: 16rpx;
	}
	.forgot-desc {
		font-size: 28rpx;
		color: rgba(255, 255, 255, 0.9);
	}
	.forgot-card {
		margin: -60rpx 30rpx 0;
		background: #fff;
		border-radius: 24rpx;
		padding: 40rpx;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
	}
	.input-wrap {
		background: #f5f7fa;
		border-radius: 12rpx;
		padding: 24rpx 28rpx;
		margin-bottom: 24rpx;
	}
	.input-wrap.code-wrap {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.input {
		flex: 1;
		font-size: 28rpx;
	}
	.get-code {
		font-size: 28rpx;
		color: #ff0844;
		margin-left: 20rpx;
	}
	.get-code.disabled {
		color: #999;
	}
	.submit-btn {
		width: 100%;
		height: 88rpx;
		line-height: 88rpx;
		background: linear-gradient(90deg, #ff0844, #ff3d62);
		color: #fff;
		font-size: 32rpx;
		border-radius: 12rpx;
		border: none;
	}
	.go-login {
		margin-top: 30rpx;
		text-align: center;
	}
	.go-login-text {
		font-size: 28rpx;
		color: #ff0844;
	}
</style>
