<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">基础用法</text>
			<text class="section-desc">数据节点含 id、label；有 children 时可展开折叠。defaultExpandKeys 传入默认展开的节点 id。</text>
			<view class="tree-wrap">
				<m-tree
					:data="treeData"
					:default-expand-keys="defaultExpandKeys"
					@item-click="onItemClick"
					@item-toggle="onItemToggle"
				></m-tree>
			</view>
			<text v-if="lastLabel !== ''" class="demo-result">最近点击节点：{{ lastLabel }}</text>
			<text v-if="toggleHint !== ''" class="demo-result demo-result--sub">{{ toggleHint }}</text>
		</view>

		<view class="demo-section">
			<text class="section-title">多层级</text>
			<text class="section-desc">支持多级嵌套；无子节点不显示箭头，仅响应点击。</text>
			<view class="tree-wrap">
				<m-tree :data="deepTree" :default-expand-keys="deepExpandKeys" @item-click="onItemClick"></m-tree>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">默认全部折叠</text>
			<text class="section-desc">不传 defaultExpandKeys（或传空数组）时，有子节点的一开始为收起状态。</text>
			<view class="tree-wrap">
				<m-tree :data="collapsedTree" :default-expand-keys="emptyExpandKeys" @item-click="onItemClick"></m-tree>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

type TreeNode = {
	id: string
	label: string
	children?: TreeNode[]
}

const defaultExpandKeys = ['region-east']

const treeData = ref<TreeNode[]>([
	{
		id: 'region-east',
		label: '一级 · 华东',
		children: [
			{ id: 'sh', label: '二级 · 上海' },
			{ id: 'hz', label: '二级 · 杭州' },
		],
	},
	{
		id: 'region-north',
		label: '一级 · 华北',
		children: [{ id: 'bj', label: '二级 · 北京' }],
	},
])

const deepExpandKeys = ['d1']

const deepTree = ref<TreeNode[]>([
	{
		id: 'd1',
		label: '事业部 A',
		children: [
			{
				id: 'd1-1',
				label: '研发组',
				children: [
					{ id: 'd1-1-1', label: '前端' },
					{ id: 'd1-1-2', label: '后端' },
				],
			},
			{ id: 'd1-2', label: '产品组' },
		],
	},
])

const collapsedTree = ref<TreeNode[]>([
	{
		id: 'c1',
		label: '可展开目录',
		children: [
			{ id: 'c1-1', label: '子项 1' },
			{ id: 'c1-2', label: '子项 2' },
		],
	},
])

const emptyExpandKeys: string[] = []

const lastLabel = ref('')
const toggleHint = ref('')

function onItemClick(e: UTSJSONObject) {
	const item = e['item'] as UTSJSONObject | null
	if (item == null) {
		return
	}
	const lab = item['label']
	lastLabel.value = lab != null ? '' + lab : ''
}

function onItemToggle(e: UTSJSONObject) {
	const item = e['item'] as UTSJSONObject | null
	const expanded = e['expanded']
	const lab = item != null && item['label'] != null ? '' + item['label'] : ''
	const ex = expanded === true
	toggleHint.value = lab.length > 0 ? (ex ? '已展开：' : '已收起：') + lab : ''
}
</script>

<style lang="scss">
@import '../_demo-common.scss';

.section-title {
	margin-bottom: 16rpx;
}

.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.55;
	margin-bottom: 20rpx;
	display: block;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
	padding-bottom: 48rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.tree-wrap {
	border-width: 1rpx;
	border-style: solid;
	border-color: #eeeeee;
	border-radius: 12rpx;
	padding: 8rpx 0;
}

.demo-result {
	font-size: 26rpx;
	color: #333333;
	margin-top: 16rpx;
	display: block;
}

.demo-result--sub {
	font-size: 24rpx;
	color: #666666;
	margin-top: 8rpx;
}
</style>
