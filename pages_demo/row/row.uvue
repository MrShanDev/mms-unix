					</view>
				</mms-col>
			</mms-row>
		</view>

		<view class="demo-section">
			<text class="section-title">左侧偏移（offset）</text>
			<text class="section-desc">offset 为左侧空出的栅格数，再绘制当前列。</text>
			<mms-row>
				<mms-col :span="8" :offset="8">
					<view class="demo-block demo-block--a">
						<text class="demo-block-t">span=8 · offset=8</text>
					</view>
				</mms-col>
			</mms-row>
		</view>

		<view class="demo-section">
			<text class="section-title">栅格间距（gutter）</text>
			<text class="section-desc">以下 gutter=16rpx，每列 padding=8rpx，与行负边距配合形成列间隙。</text>
			<mms-row :gutter="16">
				<mms-col :span="8" padding="8">
					<view class="demo-block demo-block--b">
						<text class="demo-block-t">8</text>
					</view>
