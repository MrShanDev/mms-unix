	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
	padding-bottom: 48rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.demo-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 16rpx;
}

.demo-row--mt {
	margin-top: 16rpx;
	margin-bottom: 0;
	gap: 24rpx;
}

.demo-row__cell {
	margin-right: 16rpx;
	margin-bottom: 16rpx;
}

.demo-row__cell--tail {
	margin-right: 0;
}

.demo-result {
	font-size: 24rpx;
	color: #666666;
	margin-top: 12rpx;
	display: block;
}

.demo-preview {
	margin-bottom: 24rpx;
}

.demo-preview:last-child {
	margin-bottom: 0;
}

.demo-preview__label {
	font-size: 24rpx;
	color: #999999;
	margin-bottom: 8rpx;
	display: block;
}

.demo-list {
	border-radius: 12rpx;
	overflow: hidden;
	border-width: 1rpx;
	border-style: solid;
	border-color: #eeeeee;
	margin-bottom: 8rpx;
}

.demo-list__item {
	padding: 24rpx;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #f0f0f0;
	background-color: #fafafa;
}

.demo-list__item:last-child {
	border-bottom-width: 0;
}

.demo-list__text {
	font-size: 28rpx;
	color: #333333;
}
</style>
