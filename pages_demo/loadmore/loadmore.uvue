<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">状态与交互</text>
			<text class="section-desc">status：loading（加载中）/ nomore（无更多）/ error（失败可重试）。error 时点击文案触发 @retry。</text>
			<view class="demo-row">
				<view class="demo-row__cell">
					<m-button type="primary" btnSize="small" @tap="setLoading">loading</m-button>
				</view>
				<view class="demo-row__cell">
					<m-button type="primary" btnSize="small" @tap="setNomore">nomore</m-button>
				</view>
				<view class="demo-row__cell demo-row__cell--tail">
					<m-button type="danger" btnSize="small" @tap="setError">error</m-button>
				</view>
			</view>
			<m-loadmore
				:status="status"
				loading-text="加载中…"
				nomore-text="没有更多了"
				error-text="加载失败，点我重试"
				@retry="onRetry"
			></m-loadmore>
			<text v-if="retryCount > 0" class="demo-result">retry 次数：{{ retryCount }}</text>
		</view>

		<view class="demo-section">
			<text class="section-title">各状态外观</text>
			<text class="section-desc">同一组件三种状态并列，便于对比样式。</text>
			<view class="demo-preview">
				<text class="demo-preview__label">loading</text>
				<m-loadmore status="loading" loading-text="正在加载…"></m-loadmore>
			</view>
			<view class="demo-preview">
				<text class="demo-preview__label">nomore</text>
				<m-loadmore status="nomore" nomore-text="已经到底了"></m-loadmore>
			</view>
			<view class="demo-preview">
				<text class="demo-preview__label">error</text>
				<m-loadmore status="error" error-text="点击重新加载"></m-loadmore>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">列表底部场景</text>
			<text class="section-desc">列表下方固定放 m-loadmore，模拟上拉：先 loading，再追加条数或变为 nomore。</text>
			<view class="demo-list">
				<view v-for="n in listLen" :key="n" class="demo-list__item">
					<text class="demo-list__text">列表项 {{ n }}</text>
				</view>
			</view>
			<m-loadmore
				:status="listStatus"
				loading-text="加载更多中…"
				nomore-text="没有更多了"
				error-text="加载失败，点我重试"
				@retry="onListRetry"
			></m-loadmore>
			<view class="demo-row demo-row--mt">
				<m-button type="primary" btnSize="small" @tap="simulateLoadMore">模拟加载下一页</m-button>
				<m-button btnSize="small" @tap="resetList">重置列表</m-button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const status = ref('nomore')
const retryCount = ref(0)

const listLen = ref(5)
const listStatus = ref('nomore')

function setLoading() {
	status.value = 'loading'
}

function setNomore() {
	status.value = 'nomore'
}

function setError() {
	status.value = 'error'
}

function onRetry() {
	retryCount.value = retryCount.value + 1
	status.value = 'loading'
	setTimeout(() => {
		status.value = 'nomore'
	}, 800)
}

function onListRetry() {
	listStatus.value = 'loading'
	setTimeout(() => {
		listLen.value = listLen.value + 3
		listStatus.value = 'nomore'
	}, 600)
}

function simulateLoadMore() {
	if (listStatus.value === 'loading') {
		return
	}
	listStatus.value = 'loading'
	setTimeout(() => {
		if (listLen.value >= 12) {
			listStatus.value = 'nomore'
			return
		}
		listLen.value = listLen.value + 3
		listStatus.value = 'nomore'
	}, 700)
}

function resetList() {
	listLen.value = 5
	listStatus.value = 'nomore'
}
</script>

