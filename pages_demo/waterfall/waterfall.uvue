<template>
	<view class="page-root">
		<view class="demo-head">
			<text class="section-title">m-waterfall</text>
			<text class="section-desc">
				双列瀑布流：App 端走原生 waterflow；H5、小程序等为双列 scroll-view 兜底。列表项可提供 flowHeight（rpx）在非 App 且 layoutType=2 时参与列高估算。
			</text>
			<view class="demo-actions">
				<m-button type="primary" btnSize="small" @tap="setLayout(1)">兜底·轮流分列</m-button>
				<m-button btnSize="small" @tap="setLayout(2)">兜底·按高度平衡</m-button>
			</view>
			<text class="layout-hint">当前 layoutType={{ layoutType }}（仅非 App 生效；App 由原生排布）</text>
		</view>
		<m-waterfall
			class="wf-body"
			:list-data="list"
			:column-count="2"
			row-gap="12rpx"
			column-gap="12rpx"
			left-gap="16rpx"
			right-gap="16rpx"
			background-color="#f0f0f0"
			border-radius="12rpx"
			:layout-type="layoutType"
			lower-threshold="80"
			@scrolltolower="onScrollToLower"
		>
			<template #default="{ item, index }">
				<view class="wf-card" :style="cardStyle(item)">
					<text class="wf-card__title">{{ item.title }}</text>
					<text class="wf-card__desc">{{ item.desc }}</text>
					<text class="wf-card__meta">#{{ index }} · h={{ item.flowHeight }}rpx</text>
				</view>
			</template>
		</m-waterfall>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

type WfItem = {
	id: string
	title: string
	desc: string
	flowHeight: number
}

const layoutType = ref(1)

const list = ref<WfItem[]>(buildSeed(0, 14))

function buildSeed(offset: number, count: number): WfItem[] {
	const heights = [140, 180, 110, 200, 160, 130, 190, 150]
	const arr: WfItem[] = []
	for (let i = 0; i < count; i++) {
		const idx = offset + i
		const h = heights[idx % heights.length] as number
		arr.push({
			id: 'wf-' + idx,
			title: '卡片 ' + (idx + 1),
			desc: '示例描述，用于演示瀑布流占位高度差异。',
			flowHeight: h,
		} as WfItem)
	}
	return arr
}

function setLayout(t: number) {
	layoutType.value = t
}

function cardStyle(item: WfItem): UTSJSONObject {
	const st: UTSJSONObject = {}
	const h = item.flowHeight
	if (h != null && h > 0) {
		st['minHeight'] = h + 'rpx'
	}
	return st
}

function onScrollToLower() {
	const n = list.value.length
	if (n >= 40) {
		uni.showToast({ title: '暂无更多（演示上限）', icon: 'none' })
		return
	}
	list.value = list.value.concat(buildSeed(n, 6))
}
</script>

<style lang="scss">
@import '../_demo-common.scss';

.page-root {
	display: flex;
	flex-direction: column;
	flex: 1;
	height: 100%;
	background-color: #ffffff;
}

.demo-head {
	flex-shrink: 0;
	padding: 20rpx 20rpx 12rpx;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #eeeeee;
}

.section-title {
	margin-bottom: 12rpx;
}

.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.55;
	margin-bottom: 16rpx;
	display: block;
}

.demo-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 16rpx;
	margin-bottom: 12rpx;
}

.layout-hint {
	font-size: 22rpx;
	color: #aaaaaa;
	display: block;
}

.wf-body {
	flex: 1;
	min-height: 0;
	width: 100%;
}

.wf-card {
	background-color: #ffffff;
	border-radius: 12rpx;
	padding: 20rpx;
	border-width: 1rpx;
	border-style: solid;
	border-color: #e8e8e8;
	box-sizing: border-box;
}

.wf-card__title {
	font-size: 28rpx;
	font-weight: bold;
	color: #333333;
	display: block;
	margin-bottom: 8rpx;
}

.wf-card__desc {
	font-size: 24rpx;
	color: #666666;
	line-height: 1.4;
	display: block;
	margin-bottom: 8rpx;
}

.wf-card__meta {
	font-size: 22rpx;
	color: #999999;
	display: block;
}
</style>
