<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">基础上传</text>
			<mms-upload></mms-upload>
		</view>

		<view class="demo-section">
			<text class="section-title">限制上传数量</text>
			<mms-upload :maxCount="3"></mms-upload>
		</view>

		<view class="demo-section">
			<text class="section-title">预览已上传</text>
			<mms-upload :fileList="fileList" @afterRead="afterRead" @delete="deleteFile"></mms-upload>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

type FileItem = {
	url: string
}

const fileList = ref<FileItem[]>([
	{ url: '/static/img/heading.png' },
	{ url: '/static/img/heading.png' }
])

function afterRead(file: any) {
	fileList.value.push({ url: file.url })
}

function deleteFile(index: number) {
	fileList.value.splice(index, 1)
}
</script>

<style lang="scss">
.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.section-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #333333;
	margin-bottom: 24rpx;
	padding-left: 16rpx;
	border-left: 6rpx solid #ff2727;
}
</style>