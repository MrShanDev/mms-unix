<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">手动上传 / 自动上传（开关切换）</text>
			<text class="section-desc">
				关闭「自动上传」时需在 @afterRead 里把临时路径写入 fileList；开启后由组件请求接口并维护列表，勿在 afterRead 里再 push。切换模式会清空当前列表以免状态混乱。
			</text>
			<view class="upload-mode">
				<view class="upload-mode__row">
					<text class="upload-mode__label">自动上传</text>
					<m-switch v-model="modeAuto" color="#ff0844" @change="onAutoModeChange"></m-switch>
				</view>
				<view class="upload-mode__row">
					<text class="upload-mode__label">选图后压缩</text>
					<m-switch v-model="modeCompress" color="#ff0844"></m-switch>
				</view>
				<text class="upload-mode__hint">{{ modeHint }}</text>
			</view>
			<m-upload
				v-model:fileList="comboList"
				:autoUpload="modeAuto"
				:compress="modeCompress"
				:compressQuality="75"
				:maxCount="9"
				:columns="4"
				@afterRead="onComboAfterRead"
			></m-upload>
		</view>

		<view class="demo-section">
			<text class="section-title">基础上传（无 v-model，仅选图）</text>
			<text class="section-desc">不绑定列表，选图后仅触发 choose / afterRead，需自行接业务。</text>
			<m-upload></m-upload>
		</view>

		<view class="demo-section">
			<text class="section-title">限制数量</text>
			<m-upload :maxCount="3" :columns="4"></m-upload>
		</view>

		<view class="demo-section">
			<text class="section-title">仅回显（网络图）</text>
			<text class="section-desc">绑定服务端 URL，可预览、删除（删的是前端列表）。</text>
			<m-upload v-model:fileList="remoteList" :columns="4"></m-upload>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import { getMUiConfig } from '@/uni_modules/m-unix/config.uts'

type FileItem = {
	url: string
	status?: string
	path?: string
	serverData?: any
}

const _mUi = getMUiConfig()

/** 开关演示区：手动 / 自动 共用列表 */
const modeAuto = ref(false)
const modeCompress = ref(true)
const comboList = ref<FileItem[]>([])

const modeHint = computed((): string => {
	if (modeAuto.value) {
		return '当前：自动上传（依赖 config.api.upload.image 或 uploadUrl；失败项可点重试）'
	}
	return '当前：手动维护列表（在 afterRead 中 push 压缩后的 path）'
})

function onAutoModeChange(_next: boolean) {
	comboList.value = []
}

function onComboAfterRead(evt: { tempFiles: { path: string }[] }) {
	if (modeAuto.value) {
		return
	}
	const next = [...comboList.value]
	const tf = evt.tempFiles
	for (let i = 0; i < tf.length; i++) {
		const f = tf[i]
		next.push({ url: f.path, path: f.path })
	}
	comboList.value = next
}

const remoteList = ref<FileItem[]>([{ url: _mUi.appLogo }])
</script>

<style lang="scss">
@import '../_demo-common.scss';
.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.5;
	margin-bottom: 20rpx;
	display: block;
}

.upload-mode {
	margin-bottom: 24rpx;
	padding: 20rpx;
	background-color: #f8f8f8;
	border-radius: 12rpx;
}

.upload-mode__row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 20rpx;
}

.upload-mode__row:last-of-type {
	margin-bottom: 16rpx;
}

.upload-mode__label {
	font-size: 28rpx;
	color: #333333;
}

.upload-mode__hint {
	font-size: 22rpx;
	color: #999999;
	line-height: 1.45;
}
</style>
