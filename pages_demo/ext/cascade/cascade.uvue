<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">级联选择</text>
			<m-cascade-selection height="220px" :item-list="cascadeTree" @complete="onCascadeDone"></m-cascade-selection>
			<text class="demo-desc">{{ cascadeResult }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const leafSh = { text: '浦东', value: 111, children: [] }
const leafZj = { text: '杭州', value: 121, children: [] }
const cascadeTree = [
	{
		text: '华东',
		value: 1,
		children: [
			{ text: '上海', value: 11, children: [leafSh] },
			{ text: '浙江', value: 12, children: [leafZj] }
		]
	}
]
const cascadeResult = ref('未选择')

function onCascadeDone(e: UTSJSONObject) {
	const t = e['text']
	if (t != null) {
		cascadeResult.value = '' + (t as string)
	}
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



.demo-desc {
	font-size: 28rpx;
	color: #666666;
	margin-top: 20rpx;
	display: block;
}
</style>
