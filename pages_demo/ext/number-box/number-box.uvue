<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">步进器</text>
			<mms-number-box :value="numVal" :min="1" :max="10" @change="onNumChange"></mms-number-box>
			<text class="demo-desc">当前值：{{ numVal }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const numVal = ref(2)

function onNumChange(e: UTSJSONObject) {
	const v = e['value']
	if (v != null) {
		numVal.value = v as number
	}
}
</script>

