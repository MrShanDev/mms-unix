<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">手风琴（单开）</text>
			<m-collapse :index="0" :current="collapseCur" @click="onCollapseClick">
				<template #title>
					<view class="collapse-head">
						<text class="collapse-head-t">折叠项 A</text>
					</view>
				</template>
				<template #content>
					<text class="collapse-body">A 的内容区域。</text>
				</template>
			</m-collapse>
			<m-collapse :index="1" :current="collapseCur" @click="onCollapseClick">
				<template #title>
					<view class="collapse-head">
						<text class="collapse-head-t">折叠项 B</text>
					</view>
				</template>
				<template #content>
					<text class="collapse-body">B 的内容区域。</text>
				</template>
			</m-collapse>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const collapseCur = ref(0)

function onCollapseClick(e: UTSJSONObject) {
	const idx = e['index']
	if (idx == null) {
		return
	}
	const n = idx as number
	if (collapseCur.value === n) {
		collapseCur.value = -1
	} else {
		collapseCur.value = n
	}
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



.collapse-head {
	padding: 24rpx 0;
}

.collapse-head-t {
	font-size: 30rpx;
	color: #333333;
}

.collapse-body {
	padding: 16rpx 0 24rpx;
	font-size: 26rpx;
	color: #666666;
	line-height: 1.5;
	display: block;
}
</style>
