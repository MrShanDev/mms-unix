<template>
	<view class="ext-page pg-page">
		<scroll-view class="ext-scroll" scroll-y>
			<view class="pg-body">
				<view class="ext-section pg-doc">
					<text class="section-title">使用说明</text>
					<text class="ext-hint pg-line">
						通过 total（数据总量）与 page-size（每页条数）计算总页数；current 为当前页，建议使用 v-model:current 与组件同步。
					</text>
					<text class="ext-hint pg-line">
						点击上一页 / 下一页触发 change，参数为 { type, current }：type 为 prev 或 next，current 为切换后的页码。
					</text>
					<text class="ext-hint pg-line">
						total 为 0 时总页数按 1 页处理；当前页会被钳制在 1～总页数 之间。
					</text>
				</view>

				<view class="ext-section">
					<text class="ext-title">默认（总数 + 每页条数）</text>
					<text class="ext-hint pg-line">total=95，page-size=10，共 10 页。</text>
					<view class="pg-row">
						<mms-pagination
							:total="totalA"
							:page-size="10"
							v-model:current="pageA"
							@change="onChangeA"
						></mms-pagination>
					</view>
					<text class="pg-desc">当前页：{{ pageA }} · 最近事件：{{ lastEvtA }}</text>
				</view>

				<view class="ext-section">
					<text class="ext-title">每页条数（page-size）</text>
					<text class="ext-hint pg-line">同一总量下，page-size 越大总页数越少。</text>
					<view class="pg-row">
						<mms-pagination
							:total="100"
							:page-size="20"
							v-model:current="pageB"
						></mms-pagination>
					</view>
					<text class="pg-desc">当前页：{{ pageB }}（每页 20 条 → 共 5 页）</text>
				</view>

				<view class="ext-section">
					<text class="ext-title">仅按钮（is-page = false）</text>
					<text class="ext-hint pg-line">不展示「当前/总页」中间区域，仅保留上一页、下一页。</text>
					<view class="pg-row">
						<mms-pagination
							:total="50"
							:page-size="10"
							:is-page="false"
							v-model:current="pageC"
						></mms-pagination>
					</view>
					<text class="pg-desc">当前页：{{ pageC }}</text>
				</view>

				<view class="ext-section">
					<text class="ext-title">文案与尺寸</text>
					<text class="ext-hint pg-line">prev-text / next-text 可改按钮文案；width、height 控制按钮区域（单位与组件默认一致，多为 rpx 数值）。</text>
					<view class="pg-row">
						<mms-pagination
							:total="30"
							:page-size="10"
							prev-text="上一屏"
							next-text="下一屏"
							:width="120"
							:height="64"
							v-model:current="pageD"
						></mms-pagination>
					</view>
					<text class="pg-desc">当前页：{{ pageD }}</text>
				</view>

				<view class="ext-section">
					<text class="ext-title">颜色与圆角</text>
					<text class="ext-hint pg-line">current-color、page-color、page-font-size 控制中间页码区；按钮区用 color、background-color、border-color、radius。</text>
					<view class="pg-row">
						<mms-pagination
							:total="80"
							:page-size="8"
							current-color="#5677fc"
							page-color="#666666"
							:page-font-size="32"
							color="#333333"
							background-color="#ffffff"
							border-color="#e5e5e5"
							radius="12rpx"
							v-model:current="pageE"
						></mms-pagination>
					</view>
					<text class="pg-desc">当前页：{{ pageE }}</text>
				</view>

				<view class="ext-section">
					<text class="ext-title">自定义按钮内容（custom + 插槽）</text>
					<text class="ext-hint pg-line">custom 为 true 时，可用 prev / next 插槽替换默认文字（需自行控制可读性与禁用态表现）。</text>
					<view class="pg-row">
						<mms-pagination
							:total="40"
							:page-size="10"
							:custom="true"
							v-model:current="pageF"
						>
							<template #prev>
								<text class="pg-slot-btn">◀</text>
							</template>
							<template #next>
								<text class="pg-slot-btn">▶</text>
							</template>
						</mms-pagination>
					</view>
					<text class="pg-desc">当前页：{{ pageF }}</text>
				</view>

				<view class="ext-section pg-foot">
					<text class="ext-title">接入列表数据</text>
					<text class="ext-hint pg-line">
						请求列表时在参数中携带 current、pageSize；change 或 v-model:current 更新后重新拉取即可。首屏注意将 current 与接口返回的总条数对齐。
					</text>
				</view>
			</view>
			<view class="ext-footer-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const totalA = ref(95)
const pageA = ref(1)
const lastEvtA = ref('尚未点击')

const pageB = ref(1)
const pageC = ref(1)
const pageD = ref(1)
const pageE = ref(1)
const pageF = ref(1)

function onChangeA(e: UTSJSONObject) {
	const t = e['type']
	const c = e['current']
	const ts = t != null ? '' + t : ''
	const cs = c != null ? '' + c : ''
	lastEvtA.value = ts + ' → ' + cs
}
</script>

<style lang="scss">
@import '../_demo-common.scss';
@import '../../_demo-common.scss';

.pg-page {
	background-color: #f5f5f5;
}

.pg-page .section-title {
	margin-bottom: 12rpx;
}

.pg-line {
	display: block;
	margin-top: 12rpx;
}

.pg-body {
	padding-bottom: 24rpx;
	box-sizing: border-box;
}

.pg-row {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-top: 16rpx;
}

.pg-desc {
	font-size: 26rpx;
	color: #666666;
	margin-top: 20rpx;
	display: block;
	line-height: 1.45;
}

.pg-slot-btn {
	font-size: 28rpx;
	color: #333333;
	font-weight: bold;
}

.pg-foot {
	margin-bottom: 8rpx;
}
</style>
