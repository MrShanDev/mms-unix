<template>
	<view class="top-back-page">
		<m-top-back />
		<!-- 自定义导航场景：预留与状态栏+胶囊对齐的标题区，避免正文顶到屏幕最上 -->
		<view class="top-back-page__header" :style="headerStyle">
			<text class="top-back-page__title">顶部返回 m-top-back</text>
		</view>
		<scroll-view class="top-back-page__scroll" scroll-y>
			<view class="top-back-page__inner">
				<view class="demo-section">
					<text class="section-title">说明</text>
					<text class="section-desc">
						「顶部返回」为 fixed 定位于左上角的返回按钮，内部通过 $m.getTitleBarHeight() 对齐微信小程序胶囊区域，点击调用
						$m.back()。本页已设置 navigationStyle: custom，用于展示无系统导航栏时的典型用法。
					</text>
				</view>
				<view class="demo-section">
					<text class="section-title">向下滚动</text>
					<text class="section-desc">返回按钮始终浮在左上角，便于对照真机安全区与交互。</text>
				</view>
				<view v-for="n in 32" :key="'line-' + n" class="demo-line">
					<text class="demo-line-t">示例内容第 {{ n }} 行</text>
				</view>
				<view class="demo-footer"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import tools from '@/uni_modules/m-unix/components/m-tools/Ut.uts'

	const headerStyle = ref('padding-top:0px')

	function applyHeaderPadding() {
		const h = tools.getTitleBarHeight()
		const pad = h > 0 ? h : 88
		headerStyle.value = 'padding-top:' + pad + 'px'
	}

	onLoad(() => {
		applyHeaderPadding()
	})
</script>

