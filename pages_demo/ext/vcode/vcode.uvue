<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">图形验证码（字符）</text>
			<view class="vcode-row">
				<view class="vcode-canvas-wrap">
					<mms-vcode ref="vcodeRef" :width="120" :height="44" @change="onVcodeChange"></mms-vcode>
				</view>
				<mms-button type="default" @click="onVcodeRefresh">换一张</mms-button>
			</view>
			<text class="demo-desc">当前值：{{ vcodeStr }}</text>
		</view>

		<view class="demo-section">
			<text class="section-title">加减运算验证码</text>
			<text class="section-desc">画布显示「几加几」或「几减几」，请输入运算结果后点验证。</text>
			<view class="vcode-row">
				<view class="vcode-canvas-wrap vcode-canvas-wrap--wide">
					<mms-vcode
						ref="mathVcodeRef"
						mode="math"
						:width="200"
						:height="44"
						@change="onMathChange"
					></mms-vcode>
				</view>
				<mms-button type="default" @click="onMathRefresh">换一张</mms-button>
			</view>
			<mms-input
				v-model="mathUserInput"
				label="运算结果"
				type="number"
				placeholder="请输入答案"
				:clearable="true"
			></mms-input>
			<view class="vcode-verify-row">
				<mms-button type="primary" @click="onMathVerify">验证</mms-button>
			</view>
			<text v-if="mathVerifyHint !== ''" class="demo-desc">{{ mathVerifyHint }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const vcodeStr = ref('')
const vcodeRef = ref(null as any)

const mathUserInput = ref('')
const mathVerifyHint = ref('')
const mathVcodeRef = ref(null as any)

function onVcodeChange(e: UTSJSONObject) {
	const v = e['value']
	vcodeStr.value = v == null ? '' : '' + v
}

function onVcodeRefresh() {
	const c = vcodeRef.value as UTSJSONObject | null
	if (c == null) {
		return
	}
	const fn = c['draw']
	if (fn != null && typeof fn === 'function') {
		;(fn as () => void)()
	}
}

function onMathChange(_e: UTSJSONObject) {
	mathUserInput.value = ''
	mathVerifyHint.value = ''
}

function onMathRefresh() {
	const c = mathVcodeRef.value as UTSJSONObject | null
	if (c == null) {
		return
	}
	const fn = c['draw']
	if (fn != null && typeof fn === 'function') {
		;(fn as () => void)()
	}
}

function onMathVerify() {
	const c = mathVcodeRef.value as UTSJSONObject | null
	if (c == null) {
		return
	}
	const fn = c['verify']
	if (fn == null || typeof fn !== 'function') {
		return
	}
	const ok = (fn as (s: string) => boolean)(mathUserInput.value)
	if (ok) {
		mathVerifyHint.value = '验证通过'
		uni.showToast({ title: '验证通过', icon: 'success' })
	} else {
		mathVerifyHint.value = '答案不正确，请重试或换一张'
		uni.showToast({ title: '答案错误', icon: 'none' })
	}
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

.section-desc {
	font-size: 26rpx;
	color: #888888;
	margin-bottom: 24rpx;
	display: block;
	line-height: 1.5;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.vcode-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.vcode-canvas-wrap {
	margin-right: 20rpx;
}

.vcode-canvas-wrap--wide {
	margin-right: 20rpx;
}

.vcode-verify-row {
	margin-top: 24rpx;
}

.demo-desc {
	font-size: 26rpx;
	color: #666666;
	margin-top: 20rpx;
	display: block;
}
</style>
