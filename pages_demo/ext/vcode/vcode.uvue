<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">图形验证码</text>
			<view class="vcode-row">
				<mms-vcode ref="vcodeRef" :width="120" :height="44" @change="onVcodeChange"></mms-vcode>
				<mms-button type="default" @click="onVcodeRefresh">换一张</mms-button>
			</view>
			<text class="demo-desc">当前值：{{ vcodeStr }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const vcodeStr = ref('')
const vcodeRef = ref(null as any)

function onVcodeChange(e: UTSJSONObject) {
	const v = e['value']
	vcodeStr.value = v == null ? '' : '' + v
}

function onVcodeRefresh() {
	const c = vcodeRef.value as UTSJSONObject | null
	if (c == null) {
		return
	}
	const fn = c['draw']
	if (fn != null && typeof fn === 'function') {
		;(fn as () => void)()
	}
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



.vcode-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 20rpx;
}

.demo-desc {
	font-size: 26rpx;
	color: #666666;
	margin-top: 20rpx;
	display: block;
}
</style>
