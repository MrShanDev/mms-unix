<template>
	<view class="ext-page">
		<scroll-view class="ext-scroll" scroll-y>
			<view class="ext-section">
				<text class="ext-title">m-face-camera</text>
				<text class="ext-hint"
					>人像取景组件：正方形预览框、白色人脸辅助线、提示文案与自定义快门样式。仅 App / 微信小程序等非 Web 端可用原生 camera；部分小程序工程若把 camera 包在自定义组件内编译异常，可将同款布局拷贝到页面内使用。</text>

				<m-face-camera cam-id="faceCamDemo" @photo="onPhoto" @error="onCamErr"></m-face-camera>

				<view v-if="lastPath.length > 0" class="ext-result">
					<text class="ext-result-t">最近一次拍摄预览</text>
					<image class="ext-result-img" :src="lastPath" mode="aspectFit"></image>
				</view>
			</view>
			<view class="ext-footer-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const lastPath = ref('')

function onPhoto(path: string) {
	lastPath.value = path
	uni.showToast({ title: '已拍照', icon: 'none' })
}

function onCamErr(_e: any) {
	uni.showToast({ title: '相机调用失败', icon: 'none' })
}
</script>

