<template>
	<scroll-view class="page-scroll" scroll-y style="flex:1">
		<view class="demo-page">
			<view class="demo-section">
				<text class="section-title">应用更新（m-update）</text>
				<text class="section-desc">
					通过 checkUpdateFn 传入项目内检查更新方法（如 common/api/mallApi）。注入 common/config
					时可配置 versionCode 与下载地址。autoCheck=false 时不自动请求；点击下方按钮主动检查。无新版本时会触发 noUpdate。
				</text>
				<view class="demo-row">
					<m-button type="primary" btnSize="small" @tap="onCheckClick">检查更新</m-button>
				</view>
				<text v-if="lastEvt !== ''" class="demo-result">{{ lastEvt }}</text>
			</view>
		</view>

		<m-update
			ref="updRef"
			:auto-check="false"
			:check-update-fn="checkUpdate"
			@no-update="onNoUpdate"
			@update="onUpdate"
		></m-update>
	</scroll-view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { checkUpdate } from '@/common/api/mallApi'

const updRef = ref(null as any)
const lastEvt = ref('')

function getCheckFn(): (() => void) | null {
	const c = updRef.value as UTSJSONObject | null
	if (c == null) {
		return null
	}
	const fn = c['check']
	if (fn != null && typeof fn === 'function') {
		return fn as () => void
	}
	return null
}

function onCheckClick() {
	lastEvt.value = ''
	const fn = getCheckFn()
	if (fn != null) {
		fn()
	}
}

function onNoUpdate() {
	lastEvt.value = '事件：noUpdate（当前已是最新或接口无更新）'
}

function onUpdate(_info: UTSJSONObject) {
	lastEvt.value = '事件：update（用户确认更新流程）'
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';

.page-scroll {
	height: 100%;
}

.demo-page {
	min-height: 100%;
	background-color: #f5f5f5;
	padding: 20rpx;
	padding-bottom: 48rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.section-title {
	margin-bottom: 16rpx;
}

.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.55;
	margin-bottom: 20rpx;
	display: block;
}

.demo-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 8rpx;
}

.demo-result {
	font-size: 24rpx;
	color: #666666;
	margin-top: 16rpx;
	display: block;
	line-height: 1.5;
}
</style>
