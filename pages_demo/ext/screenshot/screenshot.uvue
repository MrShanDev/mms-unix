<template>
	<scroll-view class="page-scroll" scroll-y style="flex:1">
		<view class="demo-page">
			<view class="demo-section">
				<text class="section-title">区域截图（m-screenshot）</text>
				<text class="section-desc">
					将插槽内容绘制为图片；capture() 返回 Promise。当前实现以微信小程序节点为主，其它端可能提示 not supported。
				</text>
				<m-screenshot ref="shotRef" :delay="200" :quality="0.85">
					<view class="shot-box">
						<text class="shot-title">截图区域</text>
						<text class="shot-sub">点击下方按钮尝试生成临时路径</text>
					</view>
				</m-screenshot>
				<view class="demo-row">
					<m-button type="primary" btnSize="small" @tap="onCapture">生成截图</m-button>
				</view>
				<text v-if="lastPath !== ''" class="demo-result">{{ lastPath }}</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const shotRef = ref(null as any)
const lastPath = ref('')

function getCaptureFn(): (() => Promise<any>) | null {
	const c = shotRef.value as UTSJSONObject | null
	if (c == null) {
		return null
	}
	const fn = c['capture']
	if (fn != null && typeof fn === 'function') {
		return fn as () => Promise<any>
	}
	return null
}

function onCapture() {
	lastPath.value = ''
	const fn = getCaptureFn()
	if (fn == null) {
		uni.showToast({ title: '组件未就绪', icon: 'none' })
		return
	}
	fn()
		.then((res: any) => {
			const p = res['tempFilePath']
			lastPath.value = p != null ? 'tempFilePath: ' + p : '已生成（无路径字段）'
			uni.showToast({ title: '已生成', icon: 'none' })
		})
		.catch((e: any) => {
			const msg = e != null ? '' + e : '失败'
			lastPath.value = msg
			uni.showToast({ title: '不支持或失败', icon: 'none' })
		})
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';

.page-scroll {
	height: 100%;
}

.demo-page {
	min-height: 100%;
	background-color: #f5f5f5;
	padding: 20rpx;
	padding-bottom: 48rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.section-title {
	margin-bottom: 16rpx;
}

.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.55;
	margin-bottom: 20rpx;
	display: block;
}

.shot-box {
	background: linear-gradient(135deg, #fff0f6 0%, #e6f7ff 100%);
	border-radius: 12rpx;
	padding: 30rpx;
	margin-bottom: 20rpx;
}

.shot-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #333333;
	display: block;
	margin-bottom: 12rpx;
}

.shot-sub {
	font-size: 24rpx;
	color: #666666;
	display: block;
}

.demo-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 8rpx;
}

.demo-result {
	font-size: 22rpx;
	color: #666666;
	margin-top: 16rpx;
	display: block;
	line-height: 1.5;
	word-break: break-all;
}
</style>
