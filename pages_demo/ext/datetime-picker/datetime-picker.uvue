<template>
	<scroll-view class="page-scroll" scroll-y style="flex:1">
		<view class="demo-page">
			<view class="demo-section">
				<text class="section-title">日期时间选择（mms-datetime-picker）</text>
				<text class="section-desc">底部弹层 + picker-view；v-model:show 控制显隐，v-model:modelValue 为时间戳（毫秒）。</text>
				<text class="demo-result">当前值：{{ displayText }}</text>
				<view class="demo-row">
					<mms-button type="primary" btnSize="small" @tap="openMode('datetime')">日期+时间</mms-button>
					<mms-button type="primary" btnSize="small" @tap="openMode('date')">仅日期</mms-button>
					<mms-button type="primary" btnSize="small" @tap="openMode('time')">仅时间</mms-button>
				</view>
			</view>
		</view>

		<mms-datetime-picker
			v-model:show="pickerShow"
			v-model:model-value="tsValue"
			:mode="pickerMode"
			title="请选择"
			@confirm="onConfirm"
			@cancel="onCancel"
		></mms-datetime-picker>
	</scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'

const pickerShow = ref(false)
const pickerMode = ref('datetime')
const tsValue = ref(new Date().getTime())

const displayText = computed((): string => {
	const t = tsValue.value
	if (t <= 0) {
		return '—'
	}
	const d = new Date(t)
	return (
		d.getFullYear() +
		'-' +
		(d.getMonth() + 1) +
		'-' +
		d.getDate() +
		' ' +
		d.getHours() +
		':' +
		d.getMinutes()
	)
})

function openMode(mode: string) {
	pickerMode.value = mode
	pickerShow.value = true
}

function onConfirm(_e: UTSJSONObject) {
	uni.showToast({ title: '已确认', icon: 'none' })
}

function onCancel() {
	uni.showToast({ title: '已取消', icon: 'none' })
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';

.page-scroll {
	height: 100%;
}

.demo-page {
	min-height: 100%;
	background-color: #f5f5f5;
	padding: 20rpx;
	padding-bottom: 48rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.section-title {
	margin-bottom: 16rpx;
}

.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.55;
	margin-bottom: 16rpx;
	display: block;
}

.demo-result {
	font-size: 26rpx;
	color: #333333;
	margin-bottom: 20rpx;
	display: block;
}

.demo-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin: -8rpx -8rpx 0 0;
}

.demo-row > * {
	margin: 8rpx 8rpx 0 0;
}
</style>
