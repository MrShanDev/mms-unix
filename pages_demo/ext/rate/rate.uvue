<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">评分</text>
			<mms-rate :current="rateVal" @change="onRateChange"></mms-rate>
			<text class="demo-desc">当前星数索引：{{ rateVal }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const rateVal = ref(0)

function onRateChange(e: UTSJSONObject) {
	const idx = e['index']
	if (idx != null) {
		rateVal.value = idx as number
	}
}
</script>

