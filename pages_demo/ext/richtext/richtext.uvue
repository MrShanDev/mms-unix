<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">基础 HTML</text>
			<mms-richtext :content="richBasic"></mms-richtext>
		</view>

		<view class="demo-section">
			<text class="section-title">样式混排</text>
			<mms-richtext :content="richStyled"></mms-richtext>
		</view>

		<view class="demo-section">
			<text class="section-title">固定高度 + 内部滚动（height）</text>
			<text class="section-desc">长文、大段 HTML 可限制可视高度，内部纵向滚动；能力仍受各端 rich-text 限制。</text>
			<mms-richtext :content="richLong" :height="320" :selectable="true"></mms-richtext>
		</view>

		<view class="demo-section">
			<text class="section-title">最大高度（maxHeight）</text>
			<text class="section-desc">与 height 二选一优先 height；此处为 overflow 裁剪滚动，与 scroll-view 行为可能略有差异。</text>
			<mms-richtext :content="richLong" max-height="200rpx"></mms-richtext>
		</view>

		<view class="demo-section">
			<text class="section-title">链接、图片、表格（请真机验证）</text>
			<text class="section-desc">
				表格等标签在部分小程序端可能不支持或排版异常；图片需可访问 URL（如 https），小程序需配置下载域名。
			</text>
			<mms-richtext :content="richMedia"></mms-richtext>
		</view>

		<view class="demo-section">
			<text class="section-title">空内容占位（placeholder）</text>
			<mms-richtext content="" placeholder="暂无正文，可传入 placeholder"></mms-richtext>
		</view>
	</view>
</template>

<script setup lang="uts">
const richBasic = '<p style="color:#333;font-size:14px;">mms-richtext 在 rich-text 基础上可选 width / height / maxHeight、selectable、placeholder。</p>'

const richStyled =
	'<p style="color:#333;font-size:14px;"><b>粗体</b> 与 <span style="color:#5677fc">主题色</span> 混排；长英文单词：<span style="word-break:break-all">Supercalifragilisticexpialidocious</span></p>'

const richLong =
	'<p style="color:#333;font-size:14px;line-height:1.6;">以下重复段落用于演示 height 滚动区域。</p>' +
	'<p style="color:#666;font-size:14px;">第一段：富文本常用于活动规则、用户协议、商品详情等场景。</p>' +
	'<p style="color:#666;font-size:14px;">第二段：请根据目标平台查阅官方 rich-text 支持的标签集合。</p>' +
	'<p style="color:#666;font-size:14px;">第三段：表格、视频等复杂能力建议在业务侧降级为 WebView 或分块组件。</p>' +
	'<p style="color:#666;font-size:14px;">第四段：图片建议控制宽度，如 style="max-width:100%;height:auto;"。</p>' +
	'<p style="color:#666;font-size:14px;">第五段：链接使用 &lt;a href&gt;，点击行为因端而异。</p>'

const richMedia =
	'<p style="font-size:14px;"><a href="https://uniapp.dcloud.net.cn/" style="color:#5677fc;">DCloud uni-app 文档</a></p>' +
	'<p style="font-size:14px;"><img src="https://picsum.photos/id/1011/600/200" style="max-width:100%;height:auto;display:block;" /></p>' +
	'<table border="1" cellpadding="6" style="border-collapse:collapse;width:100%;font-size:13px;">' +
	'<tr><th>列 A</th><th>列 B</th></tr>' +
	'<tr><td>单元格 1</td><td>单元格 2</td></tr>' +
	'</table>'
</script>

