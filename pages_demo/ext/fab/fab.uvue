<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">悬浮扩展按钮</text>
			<text class="demo-desc">主按钮使用 mms-icon（more）；下方开关可控制是否可拖动、松手是否吸边；点击展开子项，可点遮罩关闭。</text>
			<view class="fab-opts">
				<view class="fab-opts__row">
					<text class="fab-opts__label">可拖动</text>
					<mms-switch v-model="fabDrag" color="#5677fc"></mms-switch>
				</view>
				<view class="fab-opts__row">
					<text class="fab-opts__label">松手吸边</text>
					<mms-switch v-model="fabSnap" color="#5677fc" :disabled="!fabDrag"></mms-switch>
				</view>
			</view>
		</view>

		<mms-fab
			icon="more"
			:icon-size="56"
			:draggable="fabDrag"
			:snap-edge="fabSnap"
			:btn-list="fabBtns"
			:mask-closable="true"
			@click="onFabClick"
		></mms-fab>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

/** 演示：是否允许拖动主按钮 */
const fabDrag = ref(true)
/** 演示：拖动结束后是否吸附到左/右边缘（需开启可拖动） */
const fabSnap = ref(true)

const fabBtns = [
	{ bgColor: '#16C2C2', text: '关于', fontSize: 28, color: '#fff' },
	{ bgColor: '#64B532', text: '分享', fontSize: 28, color: '#fff' }
]

function onFabClick(e: UTSJSONObject) {
	const i = e['index']
	uni.showToast({ title: 'fab index ' + i, icon: 'none' })
}
</script>

