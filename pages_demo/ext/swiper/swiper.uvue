<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">字符串列表</text>
			<text class="demo-desc">图片来自 Lorem Picsum（picsum.photos），需联网加载。</text>
			<mms-swiper :list="urlsSimple" :indicator="true" :height="300" :slide-padding="8"></mms-swiper>
		</view>

		<view class="demo-section">
			<text class="section-title">指示条（line）</text>
			<mms-swiper
				:list="urlsSimple"
				indicator
				indicator-mode="line"
				:autoplay="false"
				:height="280"
				:slide-padding="8"
			></mms-swiper>
		</view>

		<view class="demo-section">
			<text class="section-title">标题 + 对象列表</text>
			<mms-swiper
				:list="slidesWithTitle"
				image-key="src"
				show-title
				indicator
				:autoplay="false"
				circular
				:height="300"
				:slide-padding="8"
			></mms-swiper>
		</view>

		<view class="demo-section">
			<text class="section-title">卡片露边 + 衔接</text>
			<text class="demo-desc">首张左侧为上一张（衔接时即最后一张）。slide-padding 控制单页内图片左右留白；需至少 3 张图且开启 circular。</text>
			<mms-swiper
				:list="urlsCard"
				:previous-margin="36"
				:next-margin="36"
				:slide-padding="10"
				circular
				:autoplay="true"
				:interval="3500"
				indicator
				indicator-style="bottom:28rpx;"
				:height="260"
			></mms-swiper>
		</view>

		<view class="demo-section">
			<text class="section-title">加载态</text>
			<mms-swiper :list="urlsSimple" :loading="loadingDemo" :indicator="true" :height="240" :slide-padding="8"></mms-swiper>
			<text class="demo-desc">loading 为 true 时暂停自动轮播并显示遮罩（可将脚本中 loadingDemo 改为 true 预览）。</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const loadingDemo = ref(false)

/** 宽×高路径与官方一致：https://picsum.photos/id/{id}/宽/高 */
const PICSUM_W = 750
const PICSUM_H = 400

function picsumById(id: number): string {
	return 'https://picsum.photos/id/' + id + '/' + PICSUM_W + '/' + PICSUM_H
}

const urlsSimple = [picsumById(1011), picsumById(1015), picsumById(1018)]

const urlsCard = [picsumById(1024), picsumById(1025), picsumById(1029)]

const slidesWithTitle = [
	{ src: picsumById(1033), title: '示例标题一' },
	{ src: picsumById(1035), title: '示例标题二' },
	{ src: picsumById(1036), title: '示例标题三' }
]
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

