<template>
	<scroll-view class="page-scroll" scroll-y style="flex:1">
		<view class="demo-page">
			<view class="demo-section">
				<text class="section-title">加载更多（mms-loadmore）</text>
				<text class="section-desc">status：loading / nomore / error；error 时可点击触发 retry。</text>
				<view class="demo-row">
					<mms-button type="primary" btnSize="small" @tap="setLoading">loading</mms-button>
					<mms-button type="primary" btnSize="small" @tap="setNomore">nomore</mms-button>
					<mms-button type="danger" btnSize="small" @tap="setError">error</mms-button>
				</view>
				<mms-loadmore
					:status="status"
					loading-text="加载中…"
					nomore-text="没有更多了"
					error-text="加载失败，点我重试"
					@retry="onRetry"
				></mms-loadmore>
				<text v-if="retryCount > 0" class="demo-result">retry 次数：{{ retryCount }}</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const status = ref('nomore')
const retryCount = ref(0)

function setLoading() {
	status.value = 'loading'
}

function setNomore() {
	status.value = 'nomore'
}

function setError() {
	status.value = 'error'
}

function onRetry() {
	retryCount.value = retryCount.value + 1
	status.value = 'loading'
	setTimeout(() => {
		status.value = 'nomore'
	}, 800)
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';

.page-scroll {
	height: 100%;
}

.demo-page {
	min-height: 100%;
	background-color: #f5f5f5;
	padding: 20rpx;
	padding-bottom: 48rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.section-title {
	margin-bottom: 16rpx;
}

.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.55;
	margin-bottom: 20rpx;
	display: block;
}

.demo-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 16rpx;
	margin-bottom: 16rpx;
}

.demo-result {
	font-size: 24rpx;
	color: #666666;
	margin-top: 12rpx;
	display: block;
}
</style>
