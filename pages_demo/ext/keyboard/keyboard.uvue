<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">数字键盘</text>
			<m-button type="primary" @click="showKeyboard = true">打开键盘</m-button>
			<text class="demo-desc">用于支付密码等场景，配合顶部插槽展示掩码；本页演示为输满 6 位自动确认并关闭。</text>
		</view>

		<m-keyboard :show="showKeyboard" @close="closeKb" @click="onKeyClick">
			<view class="kb-top">
				<text class="kb-tip">请输入密码（演示）</text>
				<text class="kb-tip-sub">输满 6 位将自动确认；未满时可点面板「取消」关闭。</text>
				<view class="kb-dots">
					<view
						v-for="n in 6"
						:key="n"
						class="kb-dot"
						:class="n - 1 < numberArr.length ? 'kb-dot--filled' : 'kb-dot--empty'"
					></view>
				</view>
			</view>
		</m-keyboard>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const showKeyboard = ref(false)
const numberArr = ref([] as string[])

function closeKb() {
	showKeyboard.value = false
	numberArr.value = []
}

function onKeyClick(e: UTSJSONObject) {
	const idxRaw = e['index']
	if (idxRaw == null) {
		return
	}
	const idx = parseInt('' + idxRaw, 10)
	if (isNaN(idx) || idx < 0 || idx > 11) {
		return
	}
	const len = 6
	let nums = numberArr.value
	if (idx === 9) {
		closeKb()
		return
	}
	if (idx === 11) {
		if (nums.length > 0) {
			const nextNums = [] as string[]
			for (let i = 0; i < nums.length - 1; i++) {
				nextNums.push(nums[i])
			}
			numberArr.value = nextNums
		}
		return
	}
	if (nums.length >= len) {
		return
	}
	const digit = idx === 10 ? 0 : idx + 1
	const nextNums = [] as string[]
	for (let i = 0; i < nums.length; i++) {
		nextNums.push(nums[i])
	}
	nextNums.push('' + digit)
	numberArr.value = nextNums
	if (nextNums.length >= len) {
		uni.showToast({ title: '已确认（演示不提交真实密码）', icon: 'success' })
		showKeyboard.value = false
		setTimeout(() => {
			numberArr.value = []
		}, 400)
	}
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



.demo-desc {
	font-size: 26rpx;
	color: #666666;
	margin-top: 20rpx;
	line-height: 1.5;
	display: block;
}

.kb-top {
	padding: 32rpx;
}

.kb-tip {
	font-size: 28rpx;
	color: #333333;
	text-align: center;
	margin-bottom: 12rpx;
	display: block;
}

.kb-tip-sub {
	font-size: 24rpx;
	color: #888888;
	text-align: center;
	line-height: 1.45;
	margin-bottom: 20rpx;
	display: block;
}

.kb-dots {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.kb-dot + .kb-dot {
	margin-left: 20rpx;
}

.kb-dot {
	width: 20rpx;
	height: 20rpx;
	border-radius: 50%;
	box-sizing: border-box;
}

.kb-dot--filled {
	background-color: #333333;
}

.kb-dot--empty {
	border-width: 2rpx;
	border-style: solid;
	border-color: #cccccc;
	background-color: transparent;
}
</style>
