	padding: 24rpx;
	background-color: #fafafa;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #f0f0f0;
	box-sizing: border-box;
}

.sticky-container-panel-t {
	font-size: 28rpx;
	color: #333333;
	font-weight: bold;
	display: block;
	margin-bottom: 12rpx;
}

.sticky-container-panel-p {
	font-size: 26rpx;
	color: #666666;
	line-height: 1.5;
	display: block;
	margin-bottom: 16rpx;
}

.sticky-container-line {
	padding: 16rpx 0;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #eeeeee;
}

.sticky-container-line-t {
	font-size: 26rpx;
	color: #333333;
}

.sticky-demo-list {
	margin-top: 0;
}

.sticky-demo-row {
	padding: 24rpx 0;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #f0f0f0;
}

.sticky-demo-row-t {
	font-size: 28rpx;
	color: #333333;
	line-height: 1.5;
}

.sticky-state {
	margin-left: 24rpx;
	margin-right: 24rpx;
	margin-bottom: 16rpx;
}

