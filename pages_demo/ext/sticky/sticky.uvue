	font-size: 26rpx;
	color: #333333;
	font-weight: bold;
	display: block;
}

.sticky-state-sub {
	font-size: 24rpx;
	color: #888888;
	margin-top: 8rpx;
	display: block;
}

.sticky-between {
	margin-left: 24rpx;
	margin-right: 24rpx;
	margin-top: 24rpx;
}

