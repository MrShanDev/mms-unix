<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">基础切换</text>
			<mms-tabs :tabs="tabItems" :current-tab="tabCur" @change="onTabChange"></mms-tabs>
			<text class="demo-desc">当前索引：{{ tabCur }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const tabItems = [{ name: '今日' }, { name: '全部' }, { name: '新品' }]
const tabCur = ref(0)

function onTabChange(e: UTSJSONObject) {
	const idx = e['index']
	if (idx != null) {
		tabCur.value = idx as number
	}
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



.demo-desc {
	font-size: 26rpx;
	color: #666666;
	margin-top: 20rpx;
	display: block;
}
</style>
