<template>
	<view class="ext-page">
		<scroll-view class="ext-scroll" scroll-y>
			<view class="ext-section">
				<text class="ext-title">m-dropdown-list</text>
				<text class="ext-hint ext-dd-doc-lead">
					通过 show、top、isMask、maskBackground、@close 控制；列表区域高度由内部 scroll-view 样式决定。
				</text>
				<m-dropdown-list
					:show="dropdownShow"
					:top="94"
					:is-mask="true"
					mask-background="rgba(0, 0, 0, 0.1)"
					@close="dropdownShow = false"
				>
					<template #selectionbox>
						<view class="ext-dd-trigger-outer">
							<view
								class="ext-dd-head"
								:class="{ 'ext-dd-head--open': dropdownShow }"
								@tap="dropdownShow = !dropdownShow"
							>
								<view class="ext-dd-head-main">
									<text class="ext-dd-head-text">
										{{ selectedDd > 0 ? '已选：选项 ' + selectedDd : '点击选择内容块' }}
									</text>
									<text v-if="!dropdownShow" class="ext-dd-head-hint">下拉列表 · 支持 scroll-view</text>
								</view>
								<text
									class="ext-dd-head-arrow"
									:class="{ 'ext-dd-head-arrow--open': dropdownShow }"
								>▼</text>
							</view>
						</view>
					</template>
					<template #dropdownbox>
						<scroll-view scroll-y class="ext-dd-scroll">
							<view class="ext-dd-scroll-inner">
								<view
									class="ext-dd-item"
									v-for="n in 8"
									:key="n"
									@tap="pickDd(n)"
								>
									<text class="ext-dd-item-text">选项 {{ n }}</text>
									<text class="ext-dd-item-desc">副标题示例</text>
								</view>
							</view>
						</scroll-view>
					</template>
				</m-dropdown-list>
			</view>
			<view class="ext-footer-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const dropdownShow = ref(false)
const selectedDd = ref(0)

function pickDd(n: number) {
	selectedDd.value = n
	dropdownShow.value = false
	uni.showToast({ title: '已选选项 ' + n, icon: 'none' })
}
</script>

<style lang="scss">
@import '../_demo-common.scss';

.ext-dd-doc-lead {
	display: block;
	margin-bottom: 24rpx;
	line-height: 1.55;
}
</style>
