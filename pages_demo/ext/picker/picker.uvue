<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">联动 Picker</text>
			<mms-button type="primary" @click="pickerShow = true">打开 picker</mms-button>
			<text class="demo-desc">多列树形数据，确认后 toast 所选 labels。</text>
		</view>

		<mms-picker
			:show="pickerShow"
			:tree="pickerTree"
			@confirm="onPickerOk"
			@cancel="pickerShow = false"
		></mms-picker>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const leafSh = { text: '浦东', value: 111, children: [] }
const leafZj = { text: '杭州', value: 121, children: [] }
const pickerTree = [
	{
		text: '华东',
		value: 1,
		children: [
			{ text: '上海', value: 11, children: [leafSh] },
			{ text: '浙江', value: 12, children: [leafZj] }
		]
	}
]
const pickerShow = ref(false)

function onPickerOk(e: UTSJSONObject) {
	pickerShow.value = false
	const labels = e['labels']
	if (labels != null) {
		uni.showToast({ title: '已选 ' + JSON.stringify(labels), icon: 'none' })
	}
}
</script>

<style lang="scss">
.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.section-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #333333;
	margin-bottom: 24rpx;
	padding-left: 16rpx;
	border-left: 6rpx solid #ff0844;
}

.demo-desc {
	font-size: 26rpx;
	color: #666666;
	margin-top: 20rpx;
	line-height: 1.5;
	display: block;
}
</style>
