<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">三级联动</text>
			<m-button type="primary" @click="pickerShow = true">打开（layer=3）</m-button>
			<text class="demo-desc">pickerData / tree + 多列，确认后 toast labels 与 values。</text>
		</view>

		<view class="demo-section">
			<text class="section-title">单列</text>
			<m-button @click="singleShow = true">选择国家（layer=1）</m-button>
		</view>

		<view class="demo-section">
			<text class="section-title">双列</text>
			<m-button @click="doubleShow = true">省 / 市（layer=2）</m-button>
		</view>

		<m-picker
			:show="pickerShow"
			:pickerData="pickerTree"
			:layer="3"
			title="地区（三级）"
			confirmColor="#ff0844"
			@update:show="setPickerShow"
			@confirm="onPickerOk"
		></m-picker>

		<m-picker
			:show="singleShow"
			:pickerData="countries"
			:layer="1"
			title="国家"
			@update:show="setSingleShow"
			@confirm="onSingleOk"
		></m-picker>

		<m-picker
			:show="doubleShow"
			:pickerData="provinceCity"
			:layer="2"
			title="省市"
			@update:show="setDoubleShow"
			@confirm="onDoubleOk"
		></m-picker>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const leafSh = { text: '浦东', value: 111, children: [] }
const leafZj = { text: '杭州', value: 121, children: [] }
const pickerTree = [
	{
		text: '华东',
		value: 1,
		children: [
			{ text: '上海', value: 11, children: [leafSh] },
			{ text: '浙江', value: 12, children: [leafZj] }
		]
	}
]
const countries = [
	{ text: '中国', value: 'cn' },
	{ text: '美国', value: 'us' },
	{ text: '日本', value: 'jp' }
]
const provinceCity = [
	{
		text: '广东省',
		value: 'gd',
		children: [
			{ text: '广州市', value: 'gz' },
			{ text: '深圳市', value: 'sz' }
		]
	},
	{
		text: '浙江省',
		value: 'zj',
		children: [{ text: '杭州市', value: 'hz' }]
	}
]

const pickerShow = ref(false)
const singleShow = ref(false)
const doubleShow = ref(false)

function setPickerShow(v: boolean) {
	pickerShow.value = v
}
function setSingleShow(v: boolean) {
	singleShow.value = v
}
function setDoubleShow(v: boolean) {
	doubleShow.value = v
}

function onPickerOk(e: UTSJSONObject) {
	const labels = e['labels']
	const values = e['values']
	if (labels != null && values != null) {
		uni.showToast({ title: JSON.stringify(labels) + ' ' + JSON.stringify(values), icon: 'none' })
	}
}

function onSingleOk(e: UTSJSONObject) {
	const labels = e['labels']
	if (labels != null) {
		uni.showToast({ title: '国家 ' + JSON.stringify(labels), icon: 'none' })
	}
}

function onDoubleOk(e: UTSJSONObject) {
	const labels = e['labels']
	if (labels != null) {
		uni.showToast({ title: '省市 ' + JSON.stringify(labels), icon: 'none' })
	}
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



.demo-desc {
	font-size: 26rpx;
	color: #666666;
	margin-top: 20rpx;
	line-height: 1.5;
	display: block;
}
</style>
