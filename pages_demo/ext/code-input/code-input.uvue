<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">验证码输入框</text>
			<mms-code-input :length="4" type="number" @complete="onCodeComplete"></mms-code-input>
			<text class="code-hint">输入完成：{{ codeCompleteMsg }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const codeCompleteMsg = ref('（等待输入）')

function onCodeComplete(e: UTSJSONObject) {
	const v = e['value']
	codeCompleteMsg.value = v == null ? '' : '' + v
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



.code-hint {
	font-size: 26rpx;
	color: #666666;
	margin-top: 16rpx;
	display: block;
}
</style>
