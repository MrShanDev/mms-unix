<template>
	<view class="ext-page">
		<scroll-view class="ext-scroll" scroll-y>
			<view class="ext-section">
				<text class="ext-title">m-picture-cropper</text>
				<text class="ext-crop-hint">默认使用 mUi.demoImage（库内默认外链示例图）；也可选相册图片。裁剪区内可单指拖动、双指缩放构图，工具栏可「重置」视图。</text>
				<view class="ext-crop-actions">
					<text class="ext-crop-btn" @tap="chooseImage">选择图片</text>
					<text v-if="pickedSrc !== ''" class="ext-crop-btn ext-crop-btn--ghost" @tap="clearPicked">使用默认图</text>
				</view>
				<m-picture-cropper :image-url="displaySrc" @cropper="onCrop"></m-picture-cropper>
			</view>
			<view class="ext-footer-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import { getMUiConfig } from '@/uni_modules/m-unix/config.uts'

const pickedSrc = ref('')

const cropperDemoSrc = computed((): string => getMUiConfig().demoImage)

const displaySrc = computed((): string => {
	const p = pickedSrc.value
	if (p != null && p.trim().length > 0) {
		return p.trim()
	}
	return cropperDemoSrc.value
})

function chooseImage() {
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success(res) {
			const files = res.tempFiles as any[] | null
			if (files != null && files.length > 0) {
				const f0 = files[0] as UTSJSONObject
				const p = f0['path']
				if (p != null && ('' + p).length > 0) {
					pickedSrc.value = '' + p
					return
				}
			}
			const paths = res.tempFilePaths as string[] | null
			if (paths != null && paths.length > 0) {
				pickedSrc.value = paths[0] as string
			}
		},
		fail() {
			uni.showToast({ title: '未选择图片', icon: 'none' })
		}
	})
}

function clearPicked() {
	pickedSrc.value = ''
}

function onCrop(e: UTSJSONObject) {
	const u = e['url']
	uni.showToast({ title: '已确认，url 长度 ' + ('' + u).length, icon: 'none' })
}
</script>

<style lang="scss">
@import '../_demo-common.scss';

.ext-crop-hint {
	display: block;
	font-size: 24rpx;
	color: #888888;
	line-height: 1.5;
	margin-bottom: 20rpx;
}

.ext-crop-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 24rpx;
}

.ext-crop-actions .ext-crop-btn + .ext-crop-btn {
	margin-left: 16rpx;
}

.ext-crop-btn {
	padding: 16rpx 32rpx;
	background-color: #5677fc;
	color: #ffffff;
	font-size: 26rpx;
	border-radius: 8rpx;
}

.ext-crop-btn--ghost {
	background-color: #f0f0f0;
	color: #333333;
}
</style>
