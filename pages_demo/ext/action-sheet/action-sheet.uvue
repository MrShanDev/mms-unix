<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">操作菜单</text>
			<mms-button type="primary" @click="showSheet = true">打开 ActionSheet</mms-button>
		</view>

		<mms-action-sheet
			:show="showSheet"
			:item-list="sheetItems"
			tips="请选择操作"
			@click="onSheetItem"
			@cancel="showSheet = false"
		></mms-action-sheet>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const showSheet = ref(false)
const sheetItems = [
	{ text: '评论', color: '#2B2B2B' },
	{ text: '分享', color: '#2B2B2B' }
]

function onSheetItem(e: UTSJSONObject) {
	showSheet.value = false
	const i = e['index']
	uni.showToast({ title: '索引 ' + i, icon: 'none' })
}
</script>

<style lang="scss">
@import '../../_demo-common.scss';
.section-title {
	margin-bottom: 24rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}


</style>
