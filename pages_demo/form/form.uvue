	min-width: 140rpx;
	font-size: 32rpx;
	color: #333333;
	margin-right: 16rpx;
	flex-shrink: 0;
}

.form-gender__opt {
	font-size: 32rpx;
	color: #333333;
}

.form-hobbies {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	padding: 26rpx 30rpx;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: rgba(0, 0, 0, 0.08);
	background-color: #ffffff;
}

.form-hobbies__label {
	min-width: 140rpx;
	font-size: 32rpx;
	color: #333333;
	margin-right: 16rpx;
	flex-shrink: 0;
	padding-top: 4rpx;
}

.form-hobbies__opt {
	font-size: 32rpx;
	color: #333333;
}

.form-notify {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 26rpx 30rpx;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: rgba(0, 0, 0, 0.08);
	background-color: #ffffff;
}

.form-notify__label {
	font-size: 32rpx;
	color: #333333;
	flex-shrink: 0;
	margin-right: 24rpx;
}

.form-picker {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 26rpx 30rpx;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: rgba(0, 0, 0, 0.08);
	background-color: #ffffff;
}

.form-picker__label {
	min-width: 140rpx;
	font-size: 32rpx;
	color: #333333;
	margin-right: 16rpx;
	flex-shrink: 0;
}

.form-picker__value {
	flex: 1;
	font-size: 32rpx;
