	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 26rpx 30rpx;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: rgba(0, 0, 0, 0.08);
	background-color: #ffffff;
}

