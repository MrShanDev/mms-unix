<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">基础单行</text>
			<text class="section-desc">无左侧标题，仅占位与底部分割线</text>
			<m-input
				v-model="a1"
				placeholder="请输入内容"
				:borderBottom="true"
				:clearable="true"
			></m-input>
		</view>

		<view class="demo-section">
			<text class="section-title">带标题与清除</text>
			<text class="section-desc">label + clearable</text>
			<m-input
				v-model="a2"
				label="姓名"
				placeholder="请输入姓名"
				:clearable="true"
			></m-input>
		</view>

		<view class="demo-section">
			<text class="section-title">必填与校验文案</text>
			<text class="section-desc">required、error</text>
			<m-input
				v-model="a3"
				label="手机号"
				type="number"
				placeholder="11 位手机号"
				:required="true"
				:maxlength="11"
				:error="phoneError"
				:clearable="true"
			></m-input>
		</view>

		<view class="demo-section">
			<text class="section-title">密码与右对齐</text>
			<m-input
				v-model="a4"
				label="密码"
				placeholder="请输入密码"
				:password="true"
				:textRight="true"
				:borderBottom="false"
			></m-input>
		</view>

		<view class="demo-section">
			<text class="section-title">输入框描边（inputBorder）</text>
			<m-input
				v-model="a5"
				label="备注"
				placeholder="带边框的输入区域"
				:inputBorder="true"
				:borderTop="false"
				:borderBottom="false"
			></m-input>
		</view>
	</view>
</template>

<script lang="uts">
export default {
	data() {
		return {
			a1: '',
			a2: '',
			a3: '',
			a4: '',
			a5: '',
			phoneError: ''
		}
	},
	watch: {
		a3(val: string) {
			if (val.length > 0 && val.length < 11) {
				this.phoneError = '手机号应为 11 位'
			} else {
				this.phoneError = ''
			}
		}
	}
}
</script>

<style lang="scss">
@import '../_demo-common.scss';
.section-title {
	margin-bottom: 12rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



.section-desc {
	font-size: 24rpx;
	color: #999999;
	margin-bottom: 20rpx;
	padding-left: 16rpx;
}
</style>
