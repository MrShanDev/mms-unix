<template>
	<view class="chat-page">
		<scroll-view
			id="chat-scroll"
			class="chat-scroll"
			scroll-y
			:scroll-with-animation="true"
			:scroll-into-view="scrollIntoView"
		>
			<view class="chat-scroll__inner">
				<view class="chat-tip">
					<text class="chat-tip__text">以下为演示数据；表情 / 相册 / 视频 / 语音为本地录制与展示，接入业务时替换为上传与消息类型。语音需麦克风权限。</text>
				</view>
				<view
					v-for="msg in messages"
					:key="msg.id"
					:id="'msg-' + msg.id"
					class="msg-row"
					:class="msg.self ? 'msg-row--self' : 'msg-row--other'"
				>
					<image
						v-if="!msg.self"
						class="msg-avatar"
						:src="otherAvatar(msg)"
						mode="aspectFill"
					></image>
					<view class="msg-bubble-wrap">
						<text
							v-if="chatMode === 'group' && !msg.self && msg.senderName.length > 0"
							class="msg-sender-label"
						>{{ msg.senderName }}</text>
						<view
							class="msg-bubble"
							:class="[
								msg.self ? 'msg-bubble--self' : 'msg-bubble--other',
								msg.kind === 'image' || msg.kind === 'video' ? 'msg-bubble--media' : '',
							]"
						>
							<text v-if="msg.kind === 'text'" class="msg-bubble__text">{{ msg.text }}</text>
							<image
								v-else-if="msg.kind === 'image'"
								class="msg-bubble__image"
								:src="msg.mediaSrc"
								mode="widthFix"
								@tap="previewImage(msg.mediaSrc)"
							></image>
							<video
								v-else-if="msg.kind === 'video'"
								class="msg-bubble__video"
								:src="msg.mediaSrc"
								controls
								object-fit="contain"
							></video>
							<view
								v-else-if="msg.kind === 'voice'"
								class="msg-voice"
								:class="[
									msg.self ? 'msg-voice--self' : 'msg-voice--other',
									playingVoiceId === msg.id ? 'msg-voice--playing' : '',
								]"
								:style="voiceBubbleStyle(msg)"
								@tap.stop="playVoice(msg)"
							>
								<view class="msg-voice__inner">
									<view class="msg-voice__waves">
										<view class="msg-voice__bar"></view>
										<view class="msg-voice__bar"></view>
										<view class="msg-voice__bar"></view>
										<view class="msg-voice__bar"></view>
									</view>
									<text class="msg-voice__dur">{{ msg.text }}秒</text>
								</view>
							</view>
						</view>
						<text class="msg-meta">{{ msg.time }}</text>
					</view>
					<image
						v-if="msg.self"
						class="msg-avatar"
						:src="avatarSelf"
						mode="aspectFill"
					></image>
				</view>
				<view id="chat-bottom-anchor" class="chat-bottom-anchor"></view>
			</view>
		</scroll-view>

		<view class="chat-composer">
			<view class="chat-composer__body">
				<view class="chat-composer__tools-row">
					<view class="chat-composer__tools">
						<view
							class="chat-icon-btn"
							:class="{ 'chat-icon-btn--on': showEmojiPanel }"
							@tap="toggleEmojiPanel"
						>
							<m-icon name="smile" size="38rpx" color="#4a4a4c"></m-icon>
						</view>
						<view class="chat-icon-btn" @tap="pickImage">
							<m-icon name="picture" size="38rpx" color="#4a4a4c"></m-icon>
						</view>
						<view class="chat-icon-btn" @tap="pickVideo">
							<m-icon name="film" size="38rpx" color="#4a4a4c"></m-icon>
						</view>
						<view class="chat-icon-btn" @tap="toggleInputMode">
							<m-icon
								v-if="inputMode === 'keyboard'"
								name="telephone"
								size="38rpx"
								color="#4a4a4c"
							></m-icon>
							<m-icon v-else name="edit-filling" size="38rpx" color="#4a4a4c"></m-icon>
						</view>
					</view>
				</view>
				<view class="chat-composer__editor">
					<view v-if="inputMode === 'keyboard'" class="chat-composer__editor-row">
						<view class="chat-composer__input-shell">
							<m-input
								v-model="draft"
								label=""
								placeholder="说点什么…"
								:input-border="false"
								:border-bottom="false"
								background-color="transparent"
								padding="8rpx 20rpx"
								:radius="36"
								confirm-type="send"
								:clearable="true"
								@confirm="send"
							></m-input>
						</view>
						<m-button type="danger" btnSize="mini" class="chat-composer__send" @tap="send">发送</m-button>
					</view>
					<view v-else class="voice-hold-outer">
						<view
							class="voice-hold"
							:class="{
								'voice-hold--recording': isRecording,
								'voice-hold--cancel': isRecording && recordWillCancel,
							}"
							@touchstart="onVoiceTouchStart"
							@touchmove="onVoiceTouchMove"
							@touchend="onVoiceTouchEnd"
							@touchcancel="onVoiceTouchCancel"
						>
							<m-icon
								class="voice-hold__mic"
								name="telephone"
								size="36rpx"
								:color="voiceHoldIconColor"
							></m-icon>
							<text class="voice-hold__text">{{
								isRecording ? (recordWillCancel ? '松开 取消' : '松开 发送') : '按住 说话'
							}}</text>
						</view>
					</view>
				</view>
			</view>
			<view v-if="showEmojiPanel" class="chat-emoji-panel">
				<scroll-view class="chat-emoji-scroll" scroll-y>
					<view class="chat-emoji-grid">
						<view
							v-for="(emoji, idx) in emojiList"
							:key="'e-' + idx.toString()"
							class="chat-emoji-cell"
							@tap="insertEmoji(emoji)"
						>
							<text class="chat-emoji-char">{{ emoji }}</text>
						</view>
					</view>
				</scroll-view>
			</view>
		</view>

		<view v-if="isRecording" class="voice-overlay" @touchmove.stop.prevent="noopTouch">
			<view class="voice-overlay__hint">
				<text class="voice-overlay__emoji">🎤</text>
				<view class="voice-overlay__count-row">
					<text class="voice-overlay__count-num">{{ recordRemainSec }}</text>
					<text class="voice-overlay__count-unit">秒</text>
				</view>
				<text class="voice-overlay__sub">从 59 倒数至 0，到点自动发送</text>
				<text class="voice-overlay__text">{{
					recordWillCancel ? '松开手指，取消发送' : '手指上滑，取消发送'
				}}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, nextTick, onMounted, onUnmounted } from 'vue'

type ChatMsgKind = 'text' | 'image' | 'video' | 'voice'

type ChatMsg = {
	id: string
	self: boolean
	kind: ChatMsgKind
	text: string
	mediaSrc: string
	time: string
	/** 群聊时对方消息展示昵称；私聊为空 */
	senderName: string
}

/** 演示用头像；接入业务时换为会话成员头像 URL */
const avatarOther = ref('https://api.dicebear.com/7.x/notionists/png?seed=mUnixOther&size=128')
const avatarSelf =
	'https://api.dicebear.com/7.x/notionists/png?seed=mUnixSelf&size=128'

const chatMode = ref<'p2p' | 'group'>('p2p')

const draft = ref('')
const messages = ref<ChatMsg[]>(seedMessagesDefault())
const scrollIntoView = ref('')
const showEmojiPanel = ref(false)

/** 键盘输入 / 按住说话 */
const inputMode = ref<'keyboard' | 'voice'>('keyboard')
const isRecording = ref(false)
const recordWillCancel = ref(false)
const recordTouchStartY = ref(0)
/** 麦克风已授权后才为 true；start() 须在触摸同步栈内调用，不能在 authorize 回调里调 */
const recordPermissionReady = ref(false)
/** 录音剩余秒数（自 59 起显示，倒数至 0 自动发送） */
const recordRemainSec = ref(59)

let recorderManager: any | null = null
let recordCountdownTimer: any | null = null
let voiceStopHandler: ((path: string, durMs: number) => void) | null = null
let innerAudioCtx: any | null = null
const playingVoiceId = ref('')

/** 按住说话条左侧麦克风图标颜色（随录制/取消态变化） */
const voiceHoldIconColor = computed((): string => {
	if (isRecording.value && recordWillCancel.value) {
		return '#ffffff'
	}
	if (isRecording.value) {
		return '#333333'
	}
	return '#666666'
})

/* 常用表情（Unicode），点击插入输入框 */
const emojiList: string[] = [
	'😀',
	'😃',
	'😄',
	'😁',
	'😅',
	'😂',
	'🤣',
	'😊',
	'🙂',
	'😉',
	'😍',
	'🥰',
	'😘',
	'😋',
	'😛',
	'🤔',
	'😎',
	'😭',
	'😡',
	'👍',
	'👎',
	'👏',
	'🙏',
	'🎉',
	'❤️',
	'🔥',
	'✨',
	'⭐',
	'💯',
	'✅',
	'❌',
	'🌹',
	'🍀',
	'☕',
	'🍻',
	'🎂',
	'🎁',
	'📷',
	'📎',
]

function pad2(n: number): string {
	if (n < 10) {
		return '0' + n
	}
	return '' + n
}

function nowTimeLabel(): string {
	const d = new Date()
	return pad2(d.getHours()) + ':' + pad2(d.getMinutes())
}

function seedMessagesDefault(): ChatMsg[] {
	const t = nowTimeLabel()
	return [
		{
			id: 'm0',
			self: false,
			kind: 'text',
			text: '您好，这里是演示会话，支持文字、表情、相册图片与本地视频预览。',
			mediaSrc: '',
			time: t,
			senderName: '',
		} as ChatMsg,
		{
			id: 'm1',
			self: true,
			kind: 'text',
			text: '了解，我试一下底部工具栏。',
			mediaSrc: '',
			time: t,
			senderName: '',
		} as ChatMsg,
		{
			id: 'm2',
			self: false,
			kind: 'text',
			text: '工具条含安全区；选图选视频依赖系统相册与 uni 媒体 API，各端字段差异已在代码里归一。',
			mediaSrc: '',
			time: t,
			senderName: '',
		} as ChatMsg,
	]
}

function seedMessagesForMode(mode: 'p2p' | 'group'): ChatMsg[] {
	const t = nowTimeLabel()
	if (mode === 'group') {
		return [
			{
				id: 'm0',
				self: false,
				kind: 'text',
				text: '上午的需求评审改到下午 3 点，大家留意群公告。',
				mediaSrc: '',
				time: t,
				senderName: '小王',
			} as ChatMsg,
			{
				id: 'm1',
				self: false,
				kind: 'text',
				text: '收到，我更新一下日程表。',
				mediaSrc: '',
				time: t,
				senderName: '小李',
			} as ChatMsg,
			{
				id: 'm2',
				self: true,
				kind: 'text',
				text: '我这边没问题，准时参加。',
				mediaSrc: '',
				time: t,
				senderName: '',
			} as ChatMsg,
		]
	}
	return [
		{
			id: 'm0',
			self: false,
			kind: 'text',
			text: '在吗？有个问题想请教你一下。',
			mediaSrc: '',
			time: t,
			senderName: '',
		} as ChatMsg,
		{
			id: 'm1',
			self: true,
			kind: 'text',
			text: '在的，请说。',
			mediaSrc: '',
			time: t,
			senderName: '',
		} as ChatMsg,
		{
			id: 'm2',
			self: false,
			kind: 'text',
			text: '好的，那我整理成文档发你。',
			mediaSrc: '',
			time: t,
			senderName: '',
		} as ChatMsg,
	]
}

/** 用会话列表上的最后一条预览覆盖演示消息的最后一条，与 inbox 的 lastMsg 对齐 */
function messagesWithListLastPreview(mode: 'p2p' | 'group', lastListPreview: string): ChatMsg[] {
	const base = seedMessagesForMode(mode)
	if (lastListPreview.length === 0) {
		return base
	}
	const n = base.length
	if (n === 0) {
		return base
	}
	const t = nowTimeLabel()
	const lastPrev = base[n - 1]
	const out: ChatMsg[] = []
	for (let i = 0; i < n - 1; i++) {
		out.push(base[i])
	}
	if (mode === 'group') {
		let colon = lastListPreview.indexOf('：')
		const colonEn = lastListPreview.indexOf(':')
		if (colon < 0 || (colonEn >= 0 && colonEn < colon)) {
			colon = colonEn
		}
		if (colon > 0 && colon < lastListPreview.length - 1) {
			const name = lastListPreview.substring(0, colon).trim()
			const body = lastListPreview.substring(colon + 1).trim()
			out.push({
				id: lastPrev.id,
				self: false,
				kind: 'text',
				text: body,
				mediaSrc: '',
				time: t,
				senderName: name,
			} as ChatMsg)
		} else {
			out.push({
				id: lastPrev.id,
				self: false,
				kind: 'text',
				text: lastListPreview.trim(),
				mediaSrc: '',
				time: t,
				senderName: '',
			} as ChatMsg)
		}
	} else {
		out.push({
			id: lastPrev.id,
			self: false,
			kind: 'text',
			text: lastListPreview,
			mediaSrc: '',
			time: t,
			senderName: '',
		} as ChatMsg)
	}
	return out
}

function otherAvatar(msg: ChatMsg): string {
	if (chatMode.value === 'group' && msg.senderName.length > 0) {
		return (
			'https://api.dicebear.com/7.x/notionists/png?seed=' +
			encodeURIComponent(msg.senderName) +
			'&size=128'
		)
	}
	return avatarOther.value
}

function nextId(): string {
	return 'm' + Date.now().toString() + '-' + Math.floor(Math.random() * 1000).toString()
}

function scrollToBottom() {
	scrollIntoView.value = ''
	nextTick(() => {
		scrollIntoView.value = 'chat-bottom-anchor'
	})
}

function normalizeChooseImagePaths(res: any): string[] {
	let tempFiles = res.tempFiles as any[] | null
	if (tempFiles == null || tempFiles.length === 0) {
		const paths = res.tempFilePaths as string[] | null
		if (paths != null) {
			return paths
		}
		return []
	}
	const out: string[] = []
	for (let i = 0; i < tempFiles.length; i++) {
		const f = tempFiles[i]
		const p = f.path as string | null
		if (p != null && p.length > 0) {
			out.push(p)
		}
	}
	return out
}

function normalizeVideoPath(res: any): string {
	let path = res.tempFilePath as string | null
	if (path != null && path.length > 0) {
		return path
	}
	const tp = res.tempFilePaths as string[] | null
	if (tp != null && tp.length > 0) {
		return tp[0]
	}
	return ''
}

function toggleEmojiPanel() {
	showEmojiPanel.value = !showEmojiPanel.value
}

function insertEmoji(emoji: string) {
	draft.value = draft.value + emoji
}

function noopTouch(_e: any) {}

function toggleInputMode() {
	showEmojiPanel.value = false
	if (inputMode.value === 'keyboard') {
		inputMode.value = 'voice'
		/* 预申请麦克风：authorize 在点击手势内完成，长按里才能同步 rm.start() */
		warmRecordPermission()
	} else {
		inputMode.value = 'keyboard'
	}
}

function warmRecordPermission() {
	requestRecordAuth(() => {
		recordPermissionReady.value = true
	})
}

const RECORD_MAX_MS = 60000

function clearRecordCountdown() {
	if (recordCountdownTimer != null) {
		try {
			clearInterval(recordCountdownTimer as number)
		} catch (_e) {}
		recordCountdownTimer = null
	}
}

function startRecordCountdown() {
	clearRecordCountdown()
	recordRemainSec.value = 59
	recordCountdownTimer = setInterval(() => {
		if (!isRecording.value) {
			clearRecordCountdown()
			return
		}
		recordRemainSec.value = recordRemainSec.value - 1
		if (recordRemainSec.value <= 0) {
			clearRecordCountdown()
			/* 倒数至 0，自动停止并发送（非取消） */
			finishVoiceRecord(false)
		}
	}, 1000)
}

/** 当前运行环境是否提供录音管理器（H5 等常不可用，避免访问 undefined 报错） */
function setupRecorder(): boolean {
	if (recorderManager != null) {
		return true
	}
	const uniAny = uni as any
	if (typeof uniAny.getRecorderManager !== 'function') {
		return false
	}
	let rm: any = null
	try {
		rm = uniAny.getRecorderManager()
	} catch (_e) {
		return false
	}
	if (rm == null) {
		return false
	}
	recorderManager = rm
	rm.onStop((res: any) => {
		clearRecordCountdown()
		isRecording.value = false
		let path = ''
		let durMs = 0
		const p = res.tempFilePath as string | null
		if (p != null) {
			path = p
		}
		const d = res.duration as number | null
		if (d != null && d === d) {
			durMs = d
		}
		if (voiceStopHandler != null) {
			const fn = voiceStopHandler
			voiceStopHandler = null
			fn(path, durMs)
		}
	})
	rm.onError((err: any) => {
		clearRecordCountdown()
		isRecording.value = false
		voiceStopHandler = null
		let msg = '录音失败'
		const em = err != null ? (err.errMsg as string | null) : null
		if (em != null && em.length > 0) {
			msg = em.length > 24 ? msg : em
		}
		uni.showToast({ title: msg, icon: 'none' })
	})
	return true
}

/** 微信小程序需声明 scope.record；未配置时 authorize 会失败 */
function requestRecordAuth(onGranted: () => void) {
	const uniAny = uni as any
	if (typeof uniAny.getSetting !== 'function') {
		onGranted()
		return
	}
	uniAny.getSetting({
		success: (res: any) => {
			const auth = res.authSetting as UTSJSONObject | null
			if (auth != null) {
				const granted = auth['scope.record'] as boolean | null
				if (granted === true) {
					onGranted()
					return
				}
				if (granted === false) {
					uni.showModal({
						title: '需要麦克风权限',
						content: '请在设置中开启录音权限，以便发送语音消息。',
						confirmText: '去设置',
						success: (r: any) => {
							if (r.confirm === true) {
								uni.openSetting({})
							}
						},
					})
					return
				}
			}
			if (typeof uniAny.authorize !== 'function') {
				onGranted()
				return
			}
			uniAny.authorize({
				scope: 'scope.record',
				success: () => {
					onGranted()
				},
				fail: () => {
					uni.showToast({ title: '需要授权麦克风才能录音', icon: 'none' })
					/* App 等无微信式 scope，首次录音由系统弹窗，仍允许后续同步 start */
					try {
						const info = uni.getSystemInfoSync() as UTSJSONObject
						const plat = '' + (info['uniPlatform'] != null ? info['uniPlatform'] : '')
						if (plat !== 'mp-weixin') {
							onGranted()
						}
					} catch (_e) {
						onGranted()
					}
				},
			})
		},
		fail: () => {
			onGranted()
		},
	})
}

/**
 * 尽量使用最简参数，避免部分基础库对 encodeBitRate/format 组合校验失败。
 * 微信端默认一般为适合语音的编码。
 */
function getRecorderStartOptions(): any {
	return {
		duration: RECORD_MAX_MS,
	}
}

/** 必须在 touchstart 同步调用，且应已 recordPermissionReady */
function beginRecordingAtY(y: number) {
	if (!setupRecorder()) {
		return
	}
	recordTouchStartY.value = y
	recordWillCancel.value = false
	isRecording.value = true
	const rm = recorderManager as any
	try {
		rm.start(getRecorderStartOptions())
		startRecordCountdown()
	} catch (_e) {
		isRecording.value = false
		clearRecordCountdown()
		uni.showToast({ title: '无法开始录音', icon: 'none' })
	}
}

function onVoiceTouchStart(e: any) {
	showEmojiPanel.value = false
	if (!setupRecorder()) {
		uni.showToast({
			title: '当前环境不支持录音，请使用 App 或小程序',
			icon: 'none',
		})
		return
	}
	const ts = e.touches as any[] | null
	if (ts == null || ts.length === 0) {
		return
	}
	const t0 = ts[0]
	const y = t0.clientY as number
	if (!recordPermissionReady.value) {
		/* 未在「切到语音」时完成授权，补一次；start 仍须等下次触摸同步调用 */
		warmRecordPermission()
		uni.showToast({
			title: '请等待麦克风授权后，再次按住说话',
			icon: 'none',
			duration: 2500,
		})
		return
	}
	beginRecordingAtY(y)
}

function onVoiceTouchMove(e: any) {
	if (!isRecording.value) {
		return
	}
	const ts = e.touches as any[] | null
	if (ts == null || ts.length === 0) {
		return
	}
	const t0 = ts[0]
	const y = t0.clientY as number
	if (recordTouchStartY.value - y > 60) {
		recordWillCancel.value = true
	} else {
		recordWillCancel.value = false
	}
}

function finishVoiceRecord(cancelled: boolean) {
	clearRecordCountdown()
	if (recorderManager == null) {
		isRecording.value = false
		voiceStopHandler = null
		return
	}
	const rm = recorderManager as any
	voiceStopHandler = (path: string, durMs: number) => {
		if (cancelled) {
			return
		}
		if (durMs < 1000) {
			uni.showToast({ title: '说话时间太短', icon: 'none' })
			return
		}
		if (path.length === 0) {
			uni.showToast({ title: '未生成录音文件', icon: 'none' })
			return
		}
		const sec = Math.max(1, Math.round(durMs / 1000))
		messages.value = messages.value.concat([
			{
				id: nextId(),
				self: true,
				kind: 'voice',
				text: '' + sec,
				mediaSrc: path,
				time: nowTimeLabel(),
				senderName: '',
			} as ChatMsg,
		])
		nextTick(() => {
			scrollToBottom()
		})
	}
	try {
		rm.stop()
	} catch (_e) {
		isRecording.value = false
		voiceStopHandler = null
	}
}

function onVoiceTouchEnd(_e: any) {
	if (!isRecording.value) {
		return
	}
	const cancelled = recordWillCancel.value
	recordWillCancel.value = false
	finishVoiceRecord(cancelled)
}

function onVoiceTouchCancel(_e: any) {
	if (!isRecording.value) {
		return
	}
	recordWillCancel.value = false
	finishVoiceRecord(true)
}

function ensureInnerAudio(): any | null {
	if (innerAudioCtx != null) {
		return innerAudioCtx
	}
	const uniAny = uni as any
	if (typeof uniAny.createInnerAudioContext !== 'function') {
		return null
	}
	let ctx: any = null
	try {
		ctx = uniAny.createInnerAudioContext()
	} catch (_e) {
		return null
	}
	if (ctx == null) {
		return null
	}
	innerAudioCtx = ctx
	try {
		ctx.obeyMuteSwitch = false
	} catch (_e) {}
	ctx.onEnded(() => {
		playingVoiceId.value = ''
	})
	ctx.onStop(() => {
		playingVoiceId.value = ''
	})
	ctx.onError(() => {
		playingVoiceId.value = ''
		uni.showToast({ title: '语音播放失败', icon: 'none' })
	})
	return ctx
}

/** 仿微信：时长越长气泡略宽 */
function voiceBubbleStyle(msg: ChatMsg): string {
	let sec = 1
	if (msg.text != null && msg.text.length > 0) {
		const n = parseInt(msg.text, 10)
		if (n === n && n > 0) {
			sec = n
		}
	}
	const w = Math.min(460, Math.max(160, 110 + sec * 24))
	return 'min-width:' + w + 'rpx'
}

function playVoice(msg: ChatMsg) {
	if (msg.kind !== 'voice') {
		return
	}
	if (msg.mediaSrc.length === 0) {
		uni.showToast({ title: '无可用语音', icon: 'none' })
		return
	}
	const ctx = ensureInnerAudio()
	if (ctx == null) {
		uni.showToast({ title: '当前环境无法播放语音', icon: 'none' })
		return
	}
	if (playingVoiceId.value === msg.id) {
		try {
			ctx.stop()
		} catch (_e) {}
		playingVoiceId.value = ''
		return
	}
	try {
		ctx.stop()
	} catch (_e) {}
	const path = msg.mediaSrc
	const msgId = msg.id
	playingVoiceId.value = msgId
	ctx.src = path
	/* 小程序需在设置 src 后下一帧再 play，否则易失败 */
	nextTick(() => {
		setTimeout(() => {
			if (playingVoiceId.value !== msgId) {
				return
			}
			try {
				ctx.play()
			} catch (_e) {
				playingVoiceId.value = ''
				uni.showToast({ title: '播放失败', icon: 'none' })
			}
		}, 60)
	})
}

function previewImage(src: string) {
	if (src.length === 0) {
		return
	}
	uni.previewImage({
		urls: [src],
		current: src,
	})
}

function pickImage() {
	showEmojiPanel.value = false
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed', 'original'],
		sourceType: ['album', 'camera'],
		success: (res) => {
			const paths = normalizeChooseImagePaths(res as any)
			if (paths.length === 0) {
				uni.showToast({ title: '未获取到图片', icon: 'none' })
				return
			}
			messages.value = messages.value.concat([
				{
					id: nextId(),
					self: true,
					kind: 'image',
					text: '',
					mediaSrc: paths[0],
					time: nowTimeLabel(),
					senderName: '',
				} as ChatMsg,
			])
			nextTick(() => {
				scrollToBottom()
			})
		},
	})
}

function pickVideo() {
	showEmojiPanel.value = false
	uni.chooseVideo({
		sourceType: ['album', 'camera'],
		success: (res) => {
			const path = normalizeVideoPath(res as any)
			if (path.length === 0) {
				uni.showToast({ title: '未获取到视频', icon: 'none' })
				return
			}
			messages.value = messages.value.concat([
				{
					id: nextId(),
					self: true,
					kind: 'video',
					text: '',
					mediaSrc: path,
					time: nowTimeLabel(),
					senderName: '',
				} as ChatMsg,
			])
			nextTick(() => {
				scrollToBottom()
			})
		},
	})
}

async function send() {
	const raw = draft.value.trim()
	if (raw.length === 0) {
		uni.showToast({ title: '请输入内容', icon: 'none' })
		return
	}
	messages.value = messages.value.concat([
		{
			id: nextId(),
			self: true,
			kind: 'text',
			text: raw,
			mediaSrc: '',
			time: nowTimeLabel(),
			senderName: '',
		} as ChatMsg,
	])
	draft.value = ''
	await nextTick()
	scrollToBottom()
}

onLoad((options: any) => {
	let fromRoute = false
	let titleDecoded = ''
	let mode: 'p2p' | 'group' = 'p2p'
	let seedStr = 'mUnixOther'
	let lastListPreview = ''
	if (options != null) {
		const mo = options['mode'] as string | null
		const sd = options['seed'] as string | null
		const ti = options['title'] as string | null
		const lm = options['lastMsg'] as string | null
		if (
			(mo != null && mo.length > 0) ||
			(sd != null && sd.length > 0) ||
			(ti != null && ti.length > 0)
		) {
			fromRoute = true
		}
		if (mo != null && mo.length > 0) {
			if (mo === 'group') {
				mode = 'group'
			} else {
				mode = 'p2p'
			}
		}
		if (ti != null && ti.length > 0) {
			const t = decodeURIComponent(ti)
			titleDecoded = t != null ? t : ''
		}
		if (sd != null && sd.length > 0) {
			const s = decodeURIComponent(sd)
			seedStr = s != null ? s : 'mUnixOther'
		}
		if (lm != null && lm.length > 0) {
			const decodedLm = decodeURIComponent(lm)
			lastListPreview = decodedLm != null ? decodedLm : ''
		}
	}
	if (fromRoute) {
		chatMode.value = mode
		avatarOther.value =
			'https://api.dicebear.com/7.x/notionists/png?seed=' +
			encodeURIComponent(seedStr) +
			'&size=128'
		if (titleDecoded.length > 0) {
			uni.setNavigationBarTitle({ title: titleDecoded })
		}
		if (lastListPreview.length > 0) {
			messages.value = messagesWithListLastPreview(mode, lastListPreview)
		} else {
			messages.value = seedMessagesForMode(mode)
		}
	}
	nextTick(() => {
		scrollToBottom()
	})
})

onShow(() => {
	/* 从微信设置开启麦克风后返回，需重新拉取授权态 */
	warmRecordPermission()
})

onMounted(() => {
	nextTick(() => {
		scrollToBottom()
	})
})

onUnmounted(() => {
	clearRecordCountdown()
	recordRemainSec.value = 59
	if (innerAudioCtx != null) {
		try {
			innerAudioCtx.stop()
			innerAudioCtx.destroy()
		} catch (_e) {}
		innerAudioCtx = null
	}
	if (recorderManager != null) {
		try {
			recorderManager.stop()
		} catch (_e) {}
		recorderManager = null
	}
})
</script>

