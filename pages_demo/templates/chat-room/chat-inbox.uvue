	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 22rpx 24rpx;
	background-color: #ffffff;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #f0f0f0;
}

.session-avatar {
	width: 96rpx;
	height: 96rpx;
	border-radius: 48rpx;
	flex-shrink: 0;
	background-color: #e5e5e5;
}

.session-main {
	flex: 1;
	min-width: 0;
	margin-left: 20rpx;
	display: flex;
	flex-direction: column;
}

.session-top {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 8rpx;
}

.session-title {
	font-size: 30rpx;
	color: #333333;
	font-weight: 500;
}

.session-time {
	font-size: 22rpx;
	color: #b0b0b0;
	flex-shrink: 0;
	margin-left: 12rpx;
}

.session-bottom {
	display: flex;
	flex-direction: row;
	align-items: center;
	min-width: 0;
}

.session-badge {
	padding: 2rpx 10rpx;
	border-radius: 8rpx;
	margin-right: 10rpx;
	flex-shrink: 0;
}

.session-badge--group {
	background-color: rgba(255, 8, 68, 0.12);
}

.session-badge__text {
	font-size: 20rpx;
	color: #ff0844;
}

.session-preview {
	font-size: 26rpx;
	color: #999999;
	flex: 1;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	lines: 1;
}

.session-unread {
	display: flex;
	flex-direction: row;
	min-width: 36rpx;
	height: 36rpx;
	padding-left: 10rpx;
	padding-right: 10rpx;
	border-radius: 18rpx;
	background-color: #ff0844;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	margin-left: 12rpx;
}

.session-unread__text {
	font-size: 22rpx;
	color: #ffffff;
}

.friend-row {
	display: flex;
	flex-direction: row;
	align-items: center;
