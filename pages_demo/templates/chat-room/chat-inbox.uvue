	background-color: #ffffff;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #f0f0f0;
}

.friend-avatar {
	width: 96rpx;
	height: 96rpx;
	border-radius: 48rpx;
