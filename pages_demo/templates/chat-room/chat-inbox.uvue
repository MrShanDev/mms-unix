	margin: 20rpx 24rpx 12rpx;
	padding: 14rpx 18rpx;
	background-color: rgba(255, 255, 255, 0.92);
	border-radius: 12rpx;
	border-width: 1rpx;
	border-style: solid;
	border-color: #e0e0e0;
}

.inbox-tip__text {
	font-size: 22rpx;
	color: #888888;
	line-height: 1.45;
}

