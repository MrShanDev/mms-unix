<template>
	<scroll-view class="page-scroll" scroll-y style="flex:1">
		<view class="demo-page">
			<view class="demo-section demo-section--hint">
				<text class="hint-text">以下为 iconfont 字库中 mms-icon 已映射的全部名称（含别名）。每个格子使用 mms-clipboard 组件，点击复制一行 mms-icon 标签代码，可直接粘贴到页面使用。</text>
			</view>

			<view class="demo-section">
				<text class="section-title">筛选</text>
				<view class="search-row">
					<input
						class="search-input"
						type="text"
						:value="filterText"
						placeholder="输入英文名称关键字筛选"
						@input="onFilterInput"
					/>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">示例：颜色与尺寸</text>
				<view class="icon-row">
					<mms-icon name="setting" size="48rpx" color="#ff0844"></mms-icon>
					<mms-icon name="setting" size="48rpx" color="#1890ff"></mms-icon>
					<mms-icon name="setting" size="32rpx" color="#333333"></mms-icon>
					<mms-icon name="setting" size="64rpx" color="#52c41a"></mms-icon>
				</view>
			</view>

			<view class="demo-section" v-for="(cat, cidx) in displayCategories" :key="cidx">
				<text class="section-title">{{ cat.title }}</text>
				<text class="section-count">共 {{ cat.icons.length }} 个</text>
				<view class="icon-grid">
					<mms-clipboard
						class="icon-cell-wrap"
						:text="snippetFor(name)"
						v-for="(name, iidx) in cat.icons"
						:key="name + '-' + iidx"
					>
						<view class="icon-cell" hover-class="icon-cell-hover">
							<mms-icon :name="name" size="48rpx" color="#333333"></mms-icon>
							<text class="icon-label">{{ name }}</text>
						</view>
					</mms-clipboard>
				</view>
			</view>

			<view class="demo-footer-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { iconCategories, IconCategory } from './icon-catalog.uts'

	const filterText = ref('')

	function onFilterInput(e: any) {
		const d = e.detail
		if (d != null) {
			const v = d.value
			if (v != null) {
				filterText.value = '' + v
				return
			}
		}
		filterText.value = ''
	}

	const displayCategories = computed((): IconCategory[] => {
		const raw = filterText.value.trim()
		if (raw.length === 0) {
			return iconCategories
		}
		const q = raw.toLowerCase()
		const out: IconCategory[] = []
		for (let i = 0; i < iconCategories.length; i++) {
			const cat = iconCategories[i]
			const icons: string[] = []
			for (let j = 0; j < cat.icons.length; j++) {
				const n = cat.icons[j]
				if (n.toLowerCase().indexOf(q) >= 0) {
					icons.push(n)
				}
			}
			if (icons.length > 0) {
				out.push({ title: cat.title, icons: icons })
			}
		}
		return out
	})

	/** 供 mms-clipboard 的 text，点击后复制整行组件代码 */
	function snippetFor(name: string): string {
		return '<mms-icon name="' + name + '" size="40rpx"></mms-icon>'
	}
</script>

