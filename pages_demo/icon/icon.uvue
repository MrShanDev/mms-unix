	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}

.demo-section--hint {
	background-color: #fff7f0;
}

.hint-text {
	font-size: 26rpx;
	color: #666666;
	line-height: 1.55;
}

.section-title {
	margin-bottom: 8rpx;
}

.section-count {
	font-size: 22rpx;
	color: #999999;
	margin-bottom: 20rpx;
}

.search-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.search-input {
	flex: 1;
	height: 72rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	font-size: 28rpx;
	color: #333333;
	background-color: #f5f5f5;
	border-radius: 12rpx;
}

.icon-grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.icon-cell-wrap {
	width: 25%;
	box-sizing: border-box;
}

.icon-cell {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: flex-start;
	padding: 20rpx 8rpx;
	width: 100%;
	box-sizing: border-box;
}

.icon-cell-hover {
	opacity: 0.85;
}

.icon-label {
	font-size: 20rpx;
	color: #888888;
	margin-top: 10rpx;
	text-align: center;
	width: 100%;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.icon-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 12rpx 0;
	flex-wrap: wrap;
}

.demo-footer-space {
	height: 40rpx;
}
</style>
