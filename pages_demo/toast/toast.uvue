<template>
	<view class="demo-page">
		<text class="page-lead">
			mms-toast 组件支持显示/隐藏过渡（遮罩与内容淡入、缩放）。下方「组件示例」使用 mms-toast；「系统 API」为 uni.showToast，便于对比原生表现。
		</text>

		<view class="demo-section">
			<text class="section-title">组件示例（mms-toast）</text>
			<view class="demo-row">
				<mms-button type="primary" size="small" @click="openCmpToast({ text: '普通提示', type: '' })">纯文字</mms-button>
				<mms-button type="green" size="small" @click="openCmpToast({ text: '成功提示', type: 'success' })">成功</mms-button>
				<mms-button type="danger" size="small" @click="openCmpToast({ text: '失败提示', type: 'error' })">失败</mms-button>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">位置与时长</text>
			<view class="demo-row">
				<mms-button type="primary" size="small" @click="openCmpToast({ text: '顶部提示', position: 'top' })">顶部</mms-button>
				<mms-button type="primary" size="small" @click="openCmpToast({ text: '底部提示', position: 'bottom' })">底部</mms-button>
				<mms-button type="primary" size="small" @click="openCmpToast({ text: '持续约 3 秒的提示', duration: 3000 })">长时 3s</mms-button>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">加载 + 遮罩</text>
			<text class="section-desc">type=loading 使用内置图标；mask 为 true 时带半透明遮罩。</text>
			<view class="demo-row">
				<mms-button type="primary" size="small" @click="openLoadingCmp">加载约 2 秒</mms-button>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">系统 API（uni.showToast）</text>
			<text class="section-desc">无自定义过渡，与原生表现一致。</text>
			<view class="demo-row">
				<mms-button type="gray" size="small" @click="showUniToast('普通提示')">普通</mms-button>
				<mms-button type="gray" size="small" @click="showUniToast('成功', 'success')">成功</mms-button>
				<mms-button type="gray" size="small" @click="showUniToast('失败', 'error')">失败</mms-button>
			</view>
		</view>

		<mms-toast
			v-model:show="cmpShow"
			:text="cmpText"
			:type="cmpType"
			:mask="cmpMask"
			:position="cmpPosition"
			:transition-ms="cmpTransitionMs"
		></mms-toast>
	</view>
</template>

<script setup lang="uts">
import { ref, onBeforeUnmount } from 'vue'

const cmpShow = ref(false)
const cmpText = ref('')
const cmpType = ref('')
const cmpMask = ref(false)
const cmpPosition = ref('center')
const cmpTransitionMs = ref(220)

let toastTimer: number | null = null

function clearToastTimer() {
	if (toastTimer != null) {
		clearTimeout(toastTimer)
		toastTimer = null
	}
}

type CmpToastOpts = {
	text: string
	type?: string
	mask?: boolean
	position?: string
	duration?: number
	transitionMs?: number
}

function openCmpToast(opts: CmpToastOpts) {
	clearToastTimer()
	cmpText.value = opts.text
	cmpType.value = opts.type != null ? opts.type : ''
	cmpMask.value = opts.mask === true
	cmpPosition.value = opts.position != null ? opts.position : 'center'
	if (opts.transitionMs != null) {
		cmpTransitionMs.value = opts.transitionMs
	}
	cmpShow.value = true
	const d = opts.duration != null ? opts.duration : 1500
	toastTimer = setTimeout(() => {
		cmpShow.value = false
		toastTimer = null
	}, d) as number
}

function openLoadingCmp() {
	openCmpToast({
		text: '加载中...',
		type: 'loading',
		mask: true,
		duration: 2000
	})
}

function showUniToast(title: string, icon: string = 'none') {
	uni.showToast({
		title,
		icon: icon as 'success' | 'error' | 'loading' | 'none',
		duration: 1500
	})
}

onBeforeUnmount(() => {
	clearToastTimer()
})
</script>

<style lang="scss">
@import '../_demo-common.scss';
.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.page-lead {
	font-size: 26rpx;
	color: #666666;
	line-height: 1.5;
	margin-bottom: 24rpx;
	padding: 0 8rpx;
	display: block;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.5;
	margin-bottom: 20rpx;
	display: block;
}

.demo-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin: -8rpx -8rpx 0 0;
}

.demo-row > * {
	margin: 8rpx 8rpx 0 0;
}
</style>
