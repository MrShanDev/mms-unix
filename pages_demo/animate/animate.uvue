<template>
	<scroll-view class="page-scroll" scroll-y style="flex:1">
		<view class="demo-page">
			<view class="demo-section">
				<text class="section-title">说明</text>
				<text class="section-desc">全局样式 `libs/css/animate.scss`（由 `mms-unix/index.scss` 引入）。基于 transition 切换 class，符合 ucss 不使用 @keyframes；无限循环旋转请用 mms-loading 或脚本动画。</text>
			</view>

			<view class="demo-section">
				<text class="section-title">淡入淡出</text>
				<text class="section-desc">mms-animate + mms-fade-from / mms-fade-to</text>
				<mms-button type="primary" btnSize="small" @tap="toggleFade">{{ fadeVisible ? '隐藏' : '显示' }}</mms-button>
				<view class="demo-stage">
					<view
						class="demo-box"
						:class="['mms-animate', fadeVisible ? 'mms-fade-to' : 'mms-fade-from']"
					>
						<text class="demo-box-text">内容区</text>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">自下而上滑入</text>
				<text class="section-desc">mms-slide-up-from / mms-slide-up-to</text>
				<mms-button type="primary" btnSize="small" @tap="toggleSlideUp">{{ slideUpVisible ? '收起' : '展开' }}</mms-button>
				<view class="demo-stage">
					<view
						class="demo-box"
						:class="['mms-animate', slideUpVisible ? 'mms-slide-up-to' : 'mms-slide-up-from']"
					>
						<text class="demo-box-text">自下而上</text>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">缩放出现</text>
				<text class="section-desc">mms-scale-from / mms-scale-to</text>
				<mms-button type="primary" btnSize="small" @tap="toggleScale">{{ scaleVisible ? '缩小隐藏' : '放大显示' }}</mms-button>
				<view class="demo-stage demo-stage--center">
					<view
						class="demo-box demo-box--narrow"
						:class="['mms-animate', scaleVisible ? 'mms-scale-to' : 'mms-scale-from']"
					>
						<text class="demo-box-text">缩放</text>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">横向滑入</text>
				<text class="section-desc">mms-slide-left-from / to；mms-slide-right-from / to</text>
				<view class="demo-row-btns">
					<mms-button type="primary" btnSize="small" @tap="toggleSlideLeft">自左滑入</mms-button>
					<mms-button type="green" btnSize="small" @tap="toggleSlideRight">自右滑入</mms-button>
				</view>
				<view class="demo-stage demo-stage--row">
					<view
						class="demo-box demo-box--half"
						:class="['mms-animate', slideHVisible ? 'mms-slide-left-to' : 'mms-slide-left-from']"
					>
						<text class="demo-box-text">左</text>
					</view>
					<view
						class="demo-box demo-box--half demo-box--green"
						:class="['mms-animate', slideRightVisible ? 'mms-slide-right-to' : 'mms-slide-right-from']"
					>
						<text class="demo-box-text">右</text>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">图标旋转（单次）</text>
				<text class="section-desc">mms-animate + mms-rotate-0 / mms-rotate-180，用于展开箭头等</text>
				<mms-button type="primary" btnSize="small" @tap="toggleIcon">{{ iconOpen ? '收回' : '展开' }}</mms-button>
				<view class="demo-stage demo-stage--center">
					<view
						class="demo-icon-wrap mms-animate"
						:class="iconOpen ? 'mms-rotate-180' : 'mms-rotate-0'"
					>
						<mms-icon name="arrow-down" size="56rpx" color="#ff0844"></mms-icon>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">显隐与透明度</text>
				<text class="section-desc">mms-opacity-0 / mms-opacity-1；mms-hidden-touch 可配合过渡使用</text>
				<view class="demo-stage">
					<view class="demo-box mms-opacity-1">
						<text class="demo-box-text">opacity 1</text>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	const fadeVisible = ref(false)
	const slideUpVisible = ref(false)
	const scaleVisible = ref(false)
	const slideHVisible = ref(false)
	const slideRightVisible = ref(false)
	const iconOpen = ref(false)

	function toggleFade() {
		fadeVisible.value = !fadeVisible.value
	}

	function toggleSlideUp() {
		slideUpVisible.value = !slideUpVisible.value
	}

	function toggleScale() {
		scaleVisible.value = !scaleVisible.value
	}

	function toggleSlideLeft() {
		slideHVisible.value = !slideHVisible.value
	}

	function toggleSlideRight() {
		slideRightVisible.value = !slideRightVisible.value
	}

	function toggleIcon() {
		iconOpen.value = !iconOpen.value
	}
</script>

