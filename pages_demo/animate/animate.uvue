<template>
	<scroll-view class="page-scroll" scroll-y style="flex:1">
		<view class="demo-page">
			<view class="demo-section">
				<text class="section-title">说明</text>
				<text class="section-desc">全局样式 `libs/css/animate.scss`（由 `m-unix/index.scss` 引入）。基于 transition 切换 class，符合 ucss 不使用 @keyframes；无限循环旋转请用 m-loading 或脚本动画。</text>
			</view>

			<view class="demo-section">
				<text class="section-title">淡入淡出</text>
				<text class="section-desc">m-animate + m-fade-from / m-fade-to</text>
				<m-button type="primary" btnSize="small" @tap="toggleFade">{{ fadeVisible ? '隐藏' : '显示' }}</m-button>
				<view class="demo-stage">
					<view
						class="demo-box"
						:class="['m-animate', fadeVisible ? 'm-fade-to' : 'm-fade-from']"
					>
						<text class="demo-box-text">内容区</text>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">自下而上滑入</text>
				<text class="section-desc">m-slide-up-from / m-slide-up-to</text>
				<m-button type="primary" btnSize="small" @tap="toggleSlideUp">{{ slideUpVisible ? '收起' : '展开' }}</m-button>
				<view class="demo-stage">
					<view
						class="demo-box"
						:class="['m-animate', slideUpVisible ? 'm-slide-up-to' : 'm-slide-up-from']"
					>
						<text class="demo-box-text">自下而上</text>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">缩放出现</text>
				<text class="section-desc">m-scale-from / m-scale-to</text>
				<m-button type="primary" btnSize="small" @tap="toggleScale">{{ scaleVisible ? '缩小隐藏' : '放大显示' }}</m-button>
				<view class="demo-stage demo-stage--center">
					<view
						class="demo-box demo-box--narrow"
						:class="['m-animate', scaleVisible ? 'm-scale-to' : 'm-scale-from']"
					>
						<text class="demo-box-text">缩放</text>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">横向滑入</text>
				<text class="section-desc">m-slide-left-from / to；m-slide-right-from / to</text>
				<view class="demo-row-btns">
					<m-button type="primary" btnSize="small" @tap="toggleSlideLeft">自左滑入</m-button>
					<m-button type="green" btnSize="small" @tap="toggleSlideRight">自右滑入</m-button>
				</view>
				<view class="demo-stage demo-stage--row">
					<view
						class="demo-box demo-box--half"
						:class="['m-animate', slideHVisible ? 'm-slide-left-to' : 'm-slide-left-from']"
					>
						<text class="demo-box-text">左</text>
					</view>
					<view
						class="demo-box demo-box--half demo-box--green"
						:class="['m-animate', slideRightVisible ? 'm-slide-right-to' : 'm-slide-right-from']"
					>
						<text class="demo-box-text">右</text>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">图标旋转（单次）</text>
				<text class="section-desc">m-animate + m-rotate-0 / m-rotate-180，用于展开箭头等</text>
				<m-button type="primary" btnSize="small" @tap="toggleIcon">{{ iconOpen ? '收回' : '展开' }}</m-button>
				<view class="demo-stage demo-stage--center">
					<view
						class="demo-icon-wrap m-animate"
						:class="iconOpen ? 'm-rotate-180' : 'm-rotate-0'"
					>
						<m-icon name="arrow-down" size="56rpx" color="#ff0844"></m-icon>
					</view>
				</view>
			</view>

			<view class="demo-section">
				<text class="section-title">显隐与透明度</text>
				<text class="section-desc">m-opacity-0 / m-opacity-1；m-hidden-touch 可配合过渡使用</text>
				<view class="demo-stage">
					<view class="demo-box m-opacity-1">
						<text class="demo-box-text">opacity 1</text>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	const fadeVisible = ref(false)
	const slideUpVisible = ref(false)
	const scaleVisible = ref(false)
	const slideHVisible = ref(false)
	const slideRightVisible = ref(false)
	const iconOpen = ref(false)

	function toggleFade() {
		fadeVisible.value = !fadeVisible.value
	}

	function toggleSlideUp() {
		slideUpVisible.value = !slideUpVisible.value
	}

	function toggleScale() {
		scaleVisible.value = !scaleVisible.value
	}

	function toggleSlideLeft() {
		slideHVisible.value = !slideHVisible.value
	}

	function toggleSlideRight() {
		slideRightVisible.value = !slideRightVisible.value
	}

	function toggleIcon() {
		iconOpen.value = !iconOpen.value
	}
</script>

