<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">基础标签</text>
			<text class="section-desc">本页用子项外边距控制间距（兼容不支持 flex gap 的环境）；需要紧凑时用下方「紧凑排列」示例。</text>
			<view class="tag-row">
				<m-tag text="标签"></m-tag>
				<m-tag text="标签" type="success"></m-tag>
				<m-tag text="标签" type="warning"></m-tag>
				<m-tag text="标签" type="danger"></m-tag>
				<m-tag text="标签" type="info"></m-tag>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">镂空标签</text>
			<view class="tag-row">
				<m-tag text="标签" :plain="true"></m-tag>
				<m-tag text="标签" type="success" :plain="true"></m-tag>
				<m-tag text="标签" type="warning" :plain="true"></m-tag>
				<m-tag text="标签" type="danger" :plain="true"></m-tag>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">标签尺寸</text>
			<view class="tag-row">
				<m-tag text="小标签" size="small"></m-tag>
				<m-tag text="默认标签"></m-tag>
				<m-tag text="大标签" size="large"></m-tag>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">可关闭标签</text>
			<view class="tag-row">
				<m-tag v-for="(tag, index) in tags" :key="index" :text="tag" :closable="true" @close="closeTag(index)"></m-tag>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">紧凑排列（无间距）</text>
			<text class="section-desc">子项 margin 为 0，标签紧贴；与上方有间距的排布对比。</text>
			<view class="tag-row tag-row--tight">
				<m-tag text="热销"></m-tag>
				<m-tag text="新品" type="success"></m-tag>
				<m-tag text="满减" type="warning"></m-tag>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const tags = ref<string[]>(['标签一', '标签二', '标签三'])

function closeTag(index: number) {
	tags.value.splice(index, 1)
}
</script>

<style lang="scss">
@import '../_demo-common.scss';
.section-title {
	margin-bottom: 16rpx;
}

.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.55;
	margin-bottom: 20rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



/* 使用 gap（微信小程序 WXSS 不支持子选择器 *）；主包基础库 2.21+ 支持 flex gap */
.tag-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	gap: 10rpx;
}

.tag-row--tight {
	gap: 0;
}
</style>