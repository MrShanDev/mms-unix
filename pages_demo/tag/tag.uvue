<template>
	<view class="demo-page">
		<view class="demo-section">
			<text class="section-title">基础标签</text>
			<text class="section-desc">本页用子项外边距控制间距（兼容不支持 flex gap 的环境）；需要紧凑时用下方「紧凑排列」示例。</text>
			<view class="tag-row">
				<mms-tag text="标签"></mms-tag>
				<mms-tag text="标签" type="success"></mms-tag>
				<mms-tag text="标签" type="warning"></mms-tag>
				<mms-tag text="标签" type="danger"></mms-tag>
				<mms-tag text="标签" type="info"></mms-tag>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">镂空标签</text>
			<view class="tag-row">
				<mms-tag text="标签" :plain="true"></mms-tag>
				<mms-tag text="标签" type="success" :plain="true"></mms-tag>
				<mms-tag text="标签" type="warning" :plain="true"></mms-tag>
				<mms-tag text="标签" type="danger" :plain="true"></mms-tag>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">标签尺寸</text>
			<view class="tag-row">
				<mms-tag text="小标签" size="small"></mms-tag>
				<mms-tag text="默认标签"></mms-tag>
				<mms-tag text="大标签" size="large"></mms-tag>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">可关闭标签</text>
			<view class="tag-row">
				<mms-tag v-for="(tag, index) in tags" :key="index" :text="tag" :closable="true" @close="closeTag(index)"></mms-tag>
			</view>
		</view>

		<view class="demo-section">
			<text class="section-title">紧凑排列（无间距）</text>
			<text class="section-desc">子项 margin 为 0，标签紧贴；与上方有间距的排布对比。</text>
			<view class="tag-row tag-row--tight">
				<mms-tag text="热销"></mms-tag>
				<mms-tag text="新品" type="success"></mms-tag>
				<mms-tag text="满减" type="warning"></mms-tag>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const tags = ref<string[]>(['标签一', '标签二', '标签三'])

function closeTag(index: number) {
	tags.value.splice(index, 1)
}
</script>

<style lang="scss">
@import '../_demo-common.scss';
.section-title {
	margin-bottom: 16rpx;
}

.section-desc {
	font-size: 24rpx;
	color: #888888;
	line-height: 1.55;
	margin-bottom: 20rpx;
}

.demo-page {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.demo-section {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 24rpx;
}



/* 不用 gap：部分端 ucss 对 flex gap 支持不完整，会表现为标签贴在一起；用子项 margin + 父级负边距对齐 */
.tag-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	margin-left: -10rpx;
	margin-right: -10rpx;
	margin-top: -10rpx;
	margin-bottom: -10rpx;
}

.tag-row > * {
	margin: 10rpx;
}

.tag-row--tight {
	margin-left: 0;
	margin-right: 0;
	margin-top: 0;
	margin-bottom: 0;
}

.tag-row--tight > * {
	margin: 0;
}
</style>