interface RequestConfig {
	url: string
	method?: 'GET' | 'POST' | 'PUT' | 'DELETE'
	data?: any
	header?: Record<string, string>
	timeout?: number
}

interface RequestOptions {
	baseURL: string
	timeout: number
	showError: boolean
}

type RequestInterceptor = (config: RequestConfig) => RequestConfig
type ResponseInterceptor = (response: any) => any

let config: RequestOptions = {
	baseURL: '',
	timeout: 10000,
	showError: true
}

const requestInterceptors: RequestInterceptor[] = []
const responseInterceptors: ResponseInterceptor[] = []

export function configure(options: Partial<RequestOptions>) {
	config = {
		...config,
		...options
	}
}

export function addInterceptor(type: 'request', interceptor: RequestInterceptor): void
export function addInterceptor(type: 'response', interceptor: ResponseInterceptor): void
export function addInterceptor(type: 'request' | 'response', interceptor: any): void {
	if (type === 'request') {
		requestInterceptors.push(interceptor)
	} else {
		responseInterceptors.push(interceptor)
	}
}

function runRequestInterceptors(config: RequestConfig): RequestConfig {
	let result = config
	for (const interceptor of requestInterceptors) {
		result = interceptor(result)
	}
	return result
}

function runResponseInterceptors(response: any): any {
	let result = response
	for (const interceptor of responseInterceptors) {
		result = interceptor(result)
	}
	return result
}

function request<T = any>(options: RequestConfig): Promise<T> {
	let conf = runRequestInterceptors({
		...options,
		url: config.baseURL + options.url
	})
	return new Promise((resolve, reject) => {
		uni.request({
			url: conf.url,
			method: (conf.method || 'GET') as any,
			data: conf.data,
			header: conf.header || {},
			timeout: conf.timeout || config.timeout,
			success: (res) => {
				const data = runResponseInterceptors(res.data)
				resolve(data)
			},
			fail: (err) => {
				if (config.showError) {
					uni.showToast({
						title: '网络请求失败',
						icon: 'none'
					})
				}
				reject(err)
			}
		})
	})
}

function get<T = any>(url: string, params?: any): Promise<T> {
	return request<T>({
		url,
		method: 'GET',
		data: params
	})
}

function post<T = any>(url: string, data?: any): Promise<T> {
	return request<T>({
		url,
		method: 'POST',
		data
	})
}

function put<T = any>(url: string, data?: any): Promise<T> {
	return request<T>({
		url,
		method: 'PUT',
		data
	})
}

function del<T = any>(url: string, data?: any): Promise<T> {
	return request<T>({
		url,
		method: 'DELETE',
		data
	})
}

export default {
	request,
	get,
	post,
	put,
	delete: del
} as {
	request: typeof request
	get: typeof get
	post: typeof post
	put: typeof put
	delete: typeof del
}

export {
	request,
	get,
	post,
	put,
	del as delete
}
