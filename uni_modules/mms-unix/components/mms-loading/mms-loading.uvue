<template>
	<view class="mms-loading" :class="{'mms-loading--full': full}">
		<view class="mms-loading__spinner" :class="animClass">
			<text v-for="dot in 3" :key="dot" class="mms-loading__dot"></text>
		</view>
		<text v-if="text" class="mms-loading__text">{{ text }}</text>
	</view>
</template>

<script lang="uts">
export default {
	name: 'mmsLoading',
	props: {
		// 文字
		text: {
			type: String,
			default: '加载中...'
		},
		// 颜色
		color: {
			type: String,
			default: '#c0c4cc'
		},
		// 是否全屏
		full: {
			type: Boolean,
			default: false
		},
		// 是否动画
		anim: {
			type: Boolean,
			default: true
		}
	},
	computed: {
		animClass() {
			return this.anim ? 'mms-loading__spinner--anim' : ''
		}
	}
};
</script>

<style scoped lang="scss">
.mms-loading {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	&.mms-loading--full {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 999;
		background-color: rgba(255, 255, 255, 0.8);
	}

	.mms-loading__spinner {
		display: flex;
		align-items: center;
		height: 40rpx;

		.mms-loading__dot {
			width: 16rpx;
			height: 16rpx;
			border-radius: 50%;
			background-color: currentColor;
			margin: 0 8rpx;

			&:nth-child(1) {
				animation: mms-loading 1s infinite ease-in-out 0s;
			}
			&:nth-child(2) {
				animation: mms-loading 1s infinite ease-in-out 0.2s;
			}
			&:nth-child(3) {
				animation: mms-loading 1s infinite ease-in-out 0.4s;
			}
		}

		&.mms-loading__spinner--anim {
			animation-play-state: running;
		}
	}

	.mms-loading__text {
		margin-top: 16rpx;
		font-size: 28rpx;
		color: v-bind(color);
	}
}

@keyframes mms-loading {
	0%, 80%, 100% {
		transform: scale(0);
	}
	40% {
		transform: scale(1);
	}
}
</style>
