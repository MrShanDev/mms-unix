<template>
	<view v-if="show" class="mms-overlay" :class="{'mms-overlay--visible': show}" :style="overlayStyle" @tap="handleClick"></view>
</template>

<script lang="uts">
export default {
	name: 'mmsOverlay',
	emits: ['click'],
	props: {
		// 是否显示
		show: {
			type: Boolean,
			default: false
		},
		// 遮罩透明度
		opacity: {
			type: [Number, String],
			default: 0.5
		},
		// 层级
		zIndex: {
			type: [Number, String],
			default: 998
		},
		// 是否锁定背景滚动
		lockScroll: {
			type: Boolean,
			default: true
		}
	},
	computed: {
		overlayStyle() {
			return {
				'background-color': `rgba(0, 0, 0, ${this.opacity})`,
				'z-index': this.zIndex
			}
		}
	},
	methods: {
		handleClick(e: any) {
			this.$emit('click', e)
		}
	}
};
</script>

<style scoped lang="scss">
.mms-overlay {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	opacity: 0;
	transition: opacity 0.3s ease;

	&.mms-overlay--visible {
		opacity: 1;
	}
}
</style>
