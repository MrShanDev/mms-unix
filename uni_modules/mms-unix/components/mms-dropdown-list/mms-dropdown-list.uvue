<template>
	<view class="mms-dropdown-list" :style="{ backgroundColor: backgroundColor }">
		<view class="mms-dropdown-list__selection">
			<view class="mms-dropdown-list__anchor">
				<view class="mms-dropdown-list__trigger">
					<slot name="selectionbox"></slot>
				</view>
			</view>
		</view>
		<!-- fixed 脱离 scroll-view 裁切；面板在遮罩之上，紧贴触发条下沿 -->
		<view v-if="show" class="mms-dropdown-list__overlay">
			<view
				v-if="isMask"
				class="mms-dropdown-list__panel-mask"
				:style="{ backgroundColor: maskBackground }"
				@tap="onMaskTap"
			></view>
			<view v-if="layoutReady" class="mms-dropdown-list__panel" :style="panelFixedStyle">
				<slot name="dropdownbox"></slot>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
export default {
	name: 'mmsDropdownList',
	emits: ['close'],
	props: {
		show: {
			type: Boolean,
			default: false
		},
		backgroundColor: {
			type: String,
			default: 'transparent'
		},
		top: {
			type: Number,
			default: 0
		},
		height: {
			type: Number,
			default: 0
		},
		selectHeight: {
			type: Number,
			default: 0
		},
		isMask: {
			type: Boolean,
			default: false
		},
		maskBackground: {
			type: String,
			default: 'transparent'
		}
	},
	data() {
		return {
			panelTopPx: 0 as number,
			panelLeftPx: -1 as number,
			panelWidthPx: -1 as number,
			layoutReady: false as boolean
		}
	},
	watch: {
		show(val: boolean) {
			if (val) {
				this.layoutReady = false
				this.$nextTick(() => {
					this.measureAndShow()
				})
			} else {
				this.layoutReady = false
			}
		}
	},
	computed: {
		panelFixedStyle(): UTSJSONObject {
			const h = this.height as number
			const st = {
				position: 'fixed',
				top: this.panelTopPx + 'px',
				'z-index': '1002'
			} as UTSJSONObject
			const lw = this.panelLeftPx as number
			const ww = this.panelWidthPx as number
			if (lw >= 0 && ww > 0) {
				st['left'] = lw + 'px'
				st['width'] = ww + 'px'
				st['right'] = 'auto'
			} else {
				st['left'] = '0'
				st['right'] = '0'
				st['width'] = 'auto'
			}
			if (h > 0) {
				const px = uni.rpx2px(h)
				if (px != null && (px as number) > 0) {
					st['height'] = (px as number) + 'px'
				} else {
					st['height'] = h + 'rpx'
				}
			}
			return st
		}
	},
	methods: {
		measureAndShow() {
			const that = this
			setTimeout(function () {
				if (that.show && !that.layoutReady) {
					that.applyFallbackLayout()
					that.layoutReady = true
				}
			}, 320) as number
			const q = uni.createSelectorQuery().in(this)
			q.select('.mms-dropdown-list__trigger').boundingClientRect(function (rect) {
				if (!that.show) {
					return
				}
				if (rect != null) {
					const t = rect.top as number
					const hh = rect.height as number
					const l = rect.left as number
					const w = rect.width as number
					that.panelTopPx = t + hh
					if (w > 0) {
						that.panelLeftPx = l
						that.panelWidthPx = w
					} else {
						that.panelLeftPx = -1
						that.panelWidthPx = -1
					}
				} else {
					that.applyFallbackLayout()
				}
				that.layoutReady = true
			})
			q.exec()
		},
		applyFallbackLayout() {
			const tProp = this.top as number
			let px = uni.rpx2px(tProp > 0 ? tProp : 88)
			if (px == null || (px as number) <= 0) {
				px = 88 as number
			}
			this.panelTopPx = px as number
			this.panelLeftPx = -1
			this.panelWidthPx = -1
		},
		onMaskTap() {
			this.$emit('close')
		}
	}
}
</script>

<style lang="scss">
.mms-dropdown-list {
	position: relative;
	width: 100%;
	box-sizing: border-box;
}

.mms-dropdown-list__selection {
	width: 100%;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	justify-content: flex-start;
	align-items: flex-start;
}

.mms-dropdown-list__anchor {
	position: relative;
	max-width: 100%;
	flex-shrink: 0;
	box-sizing: border-box;
}

.mms-dropdown-list__trigger {
	width: 100%;
	box-sizing: border-box;
}

.mms-dropdown-list__overlay {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 1000;
	pointer-events: none;
	box-sizing: border-box;
}

.mms-dropdown-list__panel-mask {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 1;
	pointer-events: auto;
}

.mms-dropdown-list__panel {
	box-sizing: border-box;
	background-color: #ffffff;
	border-radius: 0 0 12rpx 12rpx;
	overflow: hidden;
	border-left-width: 1rpx;
	border-right-width: 1rpx;
	border-bottom-width: 1rpx;
	border-top-width: 0;
	border-left-style: solid;
	border-right-style: solid;
	border-bottom-style: solid;
	border-left-color: #eaeaea;
	border-right-color: #eaeaea;
	border-bottom-color: #eaeaea;
	box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
	pointer-events: auto;
}
</style>
