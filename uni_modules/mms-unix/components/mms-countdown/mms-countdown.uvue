<template>
	<view
		class="mms-countdown"
		:class="rootClass"
		@tap="onTap"
	>
		<text class="mms-countdown__text" :class="textClass">{{ displayStr }}</text>
	</view>
</template>

<script lang="uts">
export default {
	name: 'mmsCountdown',
	emits: ['change', 'finish', 'tap'],
	props: {
		// 倒计时秒数（与文档一致）
		time: {
			type: Number,
			default: 60
		},
		// 与 time 同义，演示页常用；大于 0 时覆盖 time
		seconds: {
			type: Number,
			default: 0
		},
		// 格式化 DD HH mm ss（非短信文案模式时生效）
		format: {
			type: String,
			default: 'HH:mm:ss'
		},
		// 是否自动开始
		autoStart: {
			type: Boolean,
			default: true
		},
		// 展示类型：空/text 为纯文字；button 为块状按钮样式
		type: {
			type: String,
			default: ''
		},
		// 倒计时进行中前缀数字后的文案，如「秒后重试」，显示为「59秒后重试」
		suffix: {
			type: String,
			default: ''
		},
		// 结束且可点击重置时展示（需配合 tap 或 restartOnTap）
		endText: {
			type: String,
			default: ''
		},
		// 未开始时的文案（仅 autoStart 为 false 时首帧有意义）
		startText: {
			type: String,
			default: ''
		},
		// 结束后点击是否重新开始倒计时
		restartOnTap: {
			type: Boolean,
			default: true
		}
	},
	data() {
		return {
			remaining: 0,
			timer: null as number | null,
			hasStarted: false
		}
	},
	computed: {
		duration(): number {
			const sec = this.seconds as number
			if (sec > 0) {
				return sec
			}
			return this.time as number
		},
		isSmsStyle(): boolean {
			const suf = this.suffix as string
			const end = this.endText as string
			return suf.length > 0 || end.length > 0
		},
		isButtonType(): boolean {
			return (this.type as string) === 'button'
		},
		isCounting(): boolean {
			return this.remaining > 0
		},
		rootClass(): string[] {
			const list: string[] = []
			if (this.isButtonType) {
				list.push('mms-countdown--button')
			}
			if (this.isCounting) {
				list.push('mms-countdown--counting')
			}
			if (this.canTapRestart) {
				list.push('mms-countdown--clickable')
			}
			return list
		},
		textClass(): string[] {
			const list: string[] = []
			if (this.isButtonType && this.isCounting) {
				list.push('mms-countdown__text--muted')
			}
			if (this.canTapRestart) {
				list.push('mms-countdown__text--action')
			}
			return list
		},
		canTapRestart(): boolean {
			if (!this.isSmsStyle) {
				return false
			}
			if (this.restartOnTap !== true) {
				return false
			}
			if (this.remaining > 0) {
				return false
			}
			return (this.endText as string).length > 0
		},
		clockDisplay(): string {
			let { day, hour, minute, second } = this.parseFormat(this.remaining)
			let result = this.format as string
			if (day > 0) {
				result = result.replace('DD', this.padZero(day))
			}
			result = result.replace('HH', this.padZero(hour))
			result = result.replace('mm', this.padZero(minute))
			result = result.replace('ss', this.padZero(second))
			return result
		},
		displayStr(): string {
			if (this.autoStart !== true && !this.hasStarted) {
				const st = this.startText as string
				if (st.length > 0) {
					return st
				}
			}
			if (this.isSmsStyle) {
				if (this.remaining <= 0) {
					const end = this.endText as string
					if (end.length > 0) {
						return end
					}
					return this.clockDisplay
				}
				const suf = this.suffix as string
				if (suf.length > 0) {
					return String(this.remaining) + suf
				}
				return this.clockDisplay
			}
			return this.clockDisplay
		}
	},
	created() {
		this.remaining = this.duration
	},
	mounted() {
		if (this.autoStart) {
			this.hasStarted = true
			this.start()
		}
	},
	beforeUnmount() {
		this.stop()
	},
	methods: {
		padZero(num: number): string {
			return num < 10 ? '0' + num : String(num)
		},
		parseFormat(seconds: number) {
			let sec = seconds
			const day = Math.floor(sec / (60 * 60 * 24))
			sec = sec % (60 * 60 * 24)
			const hour = Math.floor(sec / (60 * 60))
			sec = sec % (60 * 60)
			const minute = Math.floor(sec / 60)
			sec = sec % 60
			return {
				day,
				hour,
				minute,
				second: sec
			}
		},
		tick() {
			this.remaining--
			this.$emit('change', this.parseFormat(this.remaining))
			if (this.remaining <= 0) {
				this.stop()
				this.$emit('finish')
			}
		},
		start() {
			this.stop()
			this.hasStarted = true
			if (this.remaining <= 0) {
				this.$emit('finish')
				return
			}
			this.timer = setInterval(() => {
				this.tick()
			}, 1000) as unknown as number
		},
		pause() {
			this.stop()
		},
		reset() {
			this.remaining = this.duration
			this.start()
		},
		stop() {
			if (this.timer != null) {
				clearInterval(this.timer)
				this.timer = null
			}
		},
		onTap() {
			this.$emit('tap')
			if (this.canTapRestart) {
				this.remaining = this.duration
				this.start()
			}
		}
	}
};
</script>

<style scoped lang="scss">
.mms-countdown {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;

	.mms-countdown__text {
		font-size: 28rpx;
		color: #303133;
		line-height: 1.4;
	}

	&.mms-countdown--button {
		padding: 16rpx 28rpx;
		border-radius: 8rpx;
		background-color: #f5f7fa;
		border-width: 1px;
		border-style: solid;
		border-color: #dcdfe6;
		min-width: 200rpx;
	}

	&.mms-countdown--button.mms-countdown--counting {
		background-color: #f5f7fa;
	}

	&.mms-countdown--clickable {
		opacity: 1;
	}

	.mms-countdown__text--muted {
		color: #909399;
	}

	.mms-countdown__text--action {
		color: #5677fc;
	}
}
</style>
