<template>
	<view
		class="mms-segmented-control"
		:class="{ 'mms-segmented-control--disabled': disabled }"
		:style="rootStyle"
	>
		<view
			v-for="(item, idx) in valueList"
			:key="idx"
			class="mms-segmented-control__item"
			:class="{ 'mms-segmented-control__item--active': idx === innerCurrent }"
			:style="itemStyle(idx)"
			@tap="onItemTap(idx)"
		>
			<text class="mms-segmented-control__text" :style="textStyle(idx)">{{ item }}</text>
		</view>
	</view>
</template>

<script lang="uts">
export default {
	name: 'mmsSegmentedControl',
	emits: ['click', 'change', 'update:current'],
	props: {
		values: {
			type: Array,
			default(): any[] {
				return []
			}
		},
		current: {
			type: Number,
			default: 0
		},
		activeColor: {
			type: String,
			default: '#5677fc'
		},
		height: {
			type: String,
			default: '56rpx'
		},
		size: {
			type: String,
			default: '28rpx'
		},
		radius: {
			type: String,
			default: '4px'
		},
		disabled: {
			type: Boolean,
			default: false
		},
		inactiveColor: {
			type: String,
			default: '#666666'
		},
		backgroundColor: {
			type: String,
			default: '#f5f5f5'
		}
	},
	computed: {
		valueList(): string[] {
			const raw = this.values as any[]
			const out = [] as string[]
			for (let i = 0; i < raw.length; i++) {
				const v = raw[i]
				if (typeof v === 'string') {
					out.push(v)
				} else {
					out.push('' + v)
				}
			}
			return out
		},
		innerCurrent(): number {
			const c = this.current as number
			const len = this.valueList.length
			if (len === 0) {
				return 0
			}
			if (c < 0) {
				return 0
			}
			if (c >= len) {
				return len - 1
			}
			return c
		},
		rootStyle(): UTSJSONObject {
			return {
				height: this.height,
				borderRadius: this.radius,
				backgroundColor: this.backgroundColor
			}
		}
	},
	methods: {
		itemStyle(idx: number): UTSJSONObject {
			const active = idx === this.innerCurrent
			return {
				borderColor: active ? this.activeColor : 'transparent',
				backgroundColor: active ? '#ffffff' : 'transparent'
			}
		},
		textStyle(idx: number): UTSJSONObject {
			const active = idx === this.innerCurrent
			return {
				fontSize: this.size,
				color: active ? this.activeColor : this.inactiveColor
			}
		},
		onItemTap(idx: number) {
			if (this.disabled) {
				return
			}
			this.$emit('update:current', idx)
			this.$emit('click', { index: idx } as UTSJSONObject)
			this.$emit('change', { index: idx } as UTSJSONObject)
		}
	}
}
</script>

<style scoped lang="scss">
.mms-segmented-control {
	display: flex;
	flex-direction: row;
	align-items: stretch;
	box-sizing: border-box;
	padding: 4rpx;
	overflow: hidden;
}

.mms-segmented-control--disabled {
	opacity: 0.5;
}

.mms-segmented-control__item {
	flex: 1;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	border-width: 1px;
	border-style: solid;
	box-sizing: border-box;
}

.mms-segmented-control__text {
	line-height: 1.2;
}
</style>
