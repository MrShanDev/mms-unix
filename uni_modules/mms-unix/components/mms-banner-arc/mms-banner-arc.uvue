<template>
	<view class="mms-banner-arc" :style="bannerStyle">
		<view class="mms-banner-arc__inner">
			<slot></slot>
		</view>
		<view class="mms-banner-arc__arc" :style="arcStyle"></view>
	</view>
</template>

<script lang="uts">
import { toCssLength } from '@/uni_modules/mms-unix/components/mms-tools/Ut.uts'

export default {
	name: 'mmsBannerArc',
	props: {
		height: {
			type: [Number, String],
			default: 400
		},
		/** 弧形宽度相对横幅的百分比，越大弧越平，建议 ≥150 */
		percent: {
			type: [Number, String],
			default: 180
		},
		background: {
			type: String,
			default: 'linear-gradient(180deg, #5473ff 0%, #6da8ff 100%)'
		},
		/** 与下方页面衔接色，与卡片/页面底色一致时弧边才明显 */
		arcColor: {
			type: String,
			default: '#ffffff'
		},
		/** 弧形层高度（rpx），与 bottom 偏移联动，决定弧的“深度” */
		arcHeight: {
			type: [Number, String],
			default: 100
		}
	},
	computed: {
		bannerStyle(): UTSJSONObject {
			return {
				height: toCssLength(this.height as number | string),
				background: this.background as string
			}
		},
		pctNum(): number {
			const p = this.percent as number | string
			let n = 180
			if (typeof p === 'number') {
				n = p
			} else {
				const x = parseFloat(p as string)
				if (!isNaN(x)) {
					n = x
				}
			}
			if (n < 120) {
				n = 120
			}
			return n
		},
		arcHeightPxNum(): number {
			const h = this.arcHeight as number | string
			if (typeof h === 'number') {
				return h > 0 ? h : 100
			}
			const s = (h as string).trim()
			if (s.length >= 3 && s.substring(s.length - 3) === 'rpx') {
				const v = parseFloat(s.substring(0, s.length - 3))
				return !isNaN(v) && v > 0 ? v : 100
			}
			const v2 = parseFloat(s)
			return !isNaN(v2) && v2 > 0 ? v2 : 100
		},
		/** 底部外偏一半高度：椭圆中心落在横幅底边，overflow 裁出上半弧（常见弧形横幅做法） */
		arcBottomOffset(): string {
			const half = this.arcHeightPxNum / 2
			return '-' + half.toString() + 'rpx'
		},
		arcHeightStr(): string {
			return toCssLength(this.arcHeight as number | string)
		},
		arcStyle(): UTSJSONObject {
			const p = this.pctNum
			return {
				position: 'absolute',
				left: '50%',
				bottom: this.arcBottomOffset,
				width: p + '%',
				height: this.arcHeightStr,
				backgroundColor: this.arcColor as string,
				borderRadius: '50%',
				transform: 'translate3d(-50%, 0, 0)',
				zIndex: '2',
				pointerEvents: 'none'
			} as UTSJSONObject
		}
	}
}
</script>

<style scoped lang="scss">
.mms-banner-arc {
	width: 100%;
	position: relative;
	overflow: hidden;
	box-sizing: border-box;
}

.mms-banner-arc__inner {
	position: relative;
	z-index: 1;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	background-color: transparent;
}
</style>
