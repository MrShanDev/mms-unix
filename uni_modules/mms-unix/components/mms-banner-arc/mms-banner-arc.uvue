<template>
	<view class="mms-banner-arc" :class="{ 'mms-banner-arc--out': arcMode === 'out' }" :style="rootStyle">
		<view v-if="arcMode === 'out'" class="mms-banner-arc__panel" :style="panelGradientStyle"></view>
		<view class="mms-banner-arc__inner">
			<slot></slot>
		</view>
		<view v-if="arcMode === 'in'" class="mms-banner-arc__arc" :style="arcStyleIn"></view>
		<view v-if="arcMode === 'out'" class="mms-banner-arc__arc mms-banner-arc__arc--out" :style="arcStyleOut"></view>
	</view>
</template>

<script lang="uts">
import { PropType } from 'vue'
import { toCssLength } from '@/uni_modules/mms-unix/components/mms-tools/Ut.uts'

export default {
	name: 'mmsBannerArc',
	props: {
		height: {
			type: [Number, String],
			default: 400
		},
		/**
		 * 弧形方向：
		 * - in（默认）：衔接色从下方「切入」横幅，中间略向上凹（与衔接面过渡）。
		 * - out（外弧）：横幅主色向下凸出，与下方页面衔接，适合个人中心等强调外弧效果。
		 */
		arcMode: {
			type: String,
			default: 'in'
		},
		/** 弧形宽度相对横幅的百分比，越大弧越平，建议 ≥150 */
		percent: {
			type: [Number, String],
			default: 180
		},
		background: {
			type: String,
			default: 'linear-gradient(180deg, #5473ff 0%, #6da8ff 100%)'
		},
		/** 与下方页面衔接色；仅 arcMode=in 时作为底部椭圆层颜色 */
		arcColor: {
			type: String,
			default: '#ffffff'
		},
		/** 弧形层高度（rpx），与 bottom 偏移联动，决定弧的「深度」；越大弧越明显 */
		arcHeight: {
			type: [Number, String],
			default: 100
		},
		/** 根节点额外样式（合并在内置样式之后，可覆盖） */
		customStyle: {
			type: Object as PropType<UTSJSONObject>,
			default: () => ({})
		}
	},
	computed: {
		isOut(): boolean {
			return (this.arcMode as string) === 'out'
		},
		bannerHeightNum(): number {
			const h = this.height as number | string
			if (typeof h === 'number') {
				return h > 0 ? h : 400
			}
			const s = (h as string).trim()
			if (s.length >= 3 && s.substring(s.length - 3) === 'rpx') {
				const v = parseFloat(s.substring(0, s.length - 3))
				return !isNaN(v) && v > 0 ? v : 400
			}
			const v2 = parseFloat(s)
			return !isNaN(v2) && v2 > 0 ? v2 : 400
		},
		panelHeightNum(): number {
			const h = this.bannerHeightNum
			const half = this.arcHeightPxNum / 2
			const ph = h - half
			return ph > 32 ? ph : Math.floor(h * 0.82)
		},
		rootStyle(): UTSJSONObject {
			const st = {} as UTSJSONObject
			st['height'] = toCssLength(this.height as number | string)
			st['width'] = '100%'
			st['position'] = 'relative'
			st['boxSizing'] = 'border-box'
			if (this.isOut) {
				st['overflow'] = 'visible'
			} else {
				st['overflow'] = 'hidden'
				st['background'] = this.background as string
			}
			if (this.customStyle != null) {
				Object.assign(st, this.customStyle)
			}
			return st
		},
		panelGradientStyle(): UTSJSONObject {
			const st = {} as UTSJSONObject
			st['position'] = 'absolute'
			st['left'] = '0'
			st['top'] = '0'
			st['width'] = '100%'
			st['height'] = toCssLength(this.panelHeightNum)
			st['background'] = this.background as string
			st['zIndex'] = '0'
			return st
		},
		pctNum(): number {
			const p = this.percent as number | string
			let n = 180
			if (typeof p === 'number') {
				n = p
			} else {
				const x = parseFloat(p as string)
				if (!isNaN(x)) {
					n = x
				}
			}
			if (n < 120) {
				n = 120
			}
			return n
		},
		arcHeightPxNum(): number {
			const h = this.arcHeight as number | string
			if (typeof h === 'number') {
				return h > 0 ? h : 100
			}
			const s = (h as string).trim()
			if (s.length >= 3 && s.substring(s.length - 3) === 'rpx') {
				const v = parseFloat(s.substring(0, s.length - 3))
				return !isNaN(v) && v > 0 ? v : 100
			}
			const v2 = parseFloat(s)
			return !isNaN(v2) && v2 > 0 ? v2 : 100
		},
		/** 底部外偏一半高度：椭圆中心落在横幅底边 */
		arcBottomOffset(): string {
			const half = this.arcHeightPxNum / 2
			return '-' + half.toString() + 'rpx'
		},
		arcHeightStr(): string {
			return toCssLength(this.arcHeight as number | string)
		},
		arcStyleIn(): UTSJSONObject {
			const p = this.pctNum
			return {
				position: 'absolute',
				left: '50%',
				bottom: this.arcBottomOffset,
				width: p + '%',
				height: this.arcHeightStr,
				backgroundColor: this.arcColor as string,
				borderRadius: '50%',
				transform: 'translate3d(-50%, 0, 0)',
				zIndex: '2',
				pointerEvents: 'none'
			} as UTSJSONObject
		},
		/** 外弧：与主色同渐变的椭圆向下凸出，与衔接色形成外弧形 */
		arcStyleOut(): UTSJSONObject {
			const p = this.pctNum
			return {
				position: 'absolute',
				left: '50%',
				bottom: this.arcBottomOffset,
				width: p + '%',
				height: this.arcHeightStr,
				background: this.background as string,
				borderRadius: '50%',
				transform: 'translate3d(-50%, 0, 0)',
				zIndex: '2',
				pointerEvents: 'none'
			} as UTSJSONObject
		}
	}
}
</script>

<style scoped lang="scss">
.mms-banner-arc {
	width: 100%;
	box-sizing: border-box;
}

.mms-banner-arc--out {
	/* 外弧下半椭圆伸出容器，由页面底色衬托 */
	overflow: visible;
}

.mms-banner-arc__panel {
	box-sizing: border-box;
}

.mms-banner-arc__inner {
	position: relative;
	z-index: 3;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	background-color: transparent;
}

.mms-banner-arc__arc--out {
	z-index: 2;
}
</style>
