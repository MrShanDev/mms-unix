<template>
	<view>
		<view
			v-if="expanded && maskClosable"
			class="mms-fab__mask"
			:style="{ zIndex: maskZIndex }"
			@tap="collapse"
		></view>
		<view class="mms-fab__wrap" :style="wrapStyle">
			<view class="mms-fab__subs" v-if="btnList.length > 0">
				<view
					v-for="(btn, idx) in btnList"
					:key="idx"
					v-show="expanded"
					class="mms-fab__sub"
					:style="subStyle(btn)"
					@tap.stop="onSubTap(idx)"
				>
					<image
						v-if="subImg(btn) !== ''"
						class="mms-fab__sub-img"
						:src="subImg(btn)"
						mode="aspectFit"
					></image>
					<text class="mms-fab__sub-text" :style="{ color: subColor(btn), fontSize: subFontSize(btn) + 'rpx' }">{{ subText(btn) }}</text>
				</view>
			</view>
			<view
				class="mms-fab__main"
				:style="mainStyle"
				@tap="onMainTap"
			>
				<slot v-if="custom"></slot>
				<text v-else class="mms-fab__plus" :style="{ color: color }">+</text>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
type FabBtn = UTSJSONObject

export default {
	name: 'mmsFab',
	emits: ['click'],
	props: {
		left: {
			type: [Number, String],
			default: 0
		},
		right: {
			type: [Number, String],
			default: 80
		},
		bottom: {
			type: [Number, String],
			default: 100
		},
		top: {
			type: [Number, String],
			default: 0
		},
		zIndex: {
			type: [Number, String],
			default: 997
		},
		width: {
			type: [Number, String],
			default: 108
		},
		height: {
			type: [Number, String],
			default: 108
		},
		radius: {
			type: String,
			default: '50%'
		},
		custom: {
			type: Boolean,
			default: false
		},
		bgColor: {
			type: String,
			default: '#5677fc'
		},
		color: {
			type: String,
			default: '#ffffff'
		},
		btnList: {
			type: Array,
			default(): any[] {
				return []
			}
		},
		textField: {
			type: String,
			default: 'text'
		},
		imgField: {
			type: String,
			default: 'imgUrl'
		},
		size: {
			type: [Number, String],
			default: 28
		},
		maskClosable: {
			type: Boolean,
			default: false
		}
	},
	data() {
		return {
			expanded: false as boolean
		}
	},
	computed: {
		baseZ(): number {
			const zi = this.zIndex
			const n = typeof zi === 'number' ? zi as number : parseInt('' + zi)
			return isNaN(n) ? 997 : n
		},
		maskZIndex(): number {
			return this.baseZ - 1
		},
		wrapStyle(): UTSJSONObject {
			const st = {} as UTSJSONObject
			st['zIndex'] = this.baseZ
			st['position'] = 'fixed'
			const t = this.top as number | string
			const tp = typeof t === 'number' ? t as number : parseInt('' + t)
			if (!isNaN(tp) && tp > 0) {
				st['top'] = t + 'rpx'
				st['bottom'] = 'auto'
			} else {
				st['bottom'] = this.bottom + 'rpx'
			}
			const l = this.left as number | string
			const ln = typeof l === 'number' ? l as number : parseInt('' + l)
			if (!isNaN(ln) && ln > 0) {
				st['left'] = l + 'rpx'
				st['right'] = 'auto'
			} else {
				st['right'] = this.right + 'rpx'
				st['left'] = 'auto'
			}
			st['display'] = 'flex'
			st['flexDirection'] = 'column'
			st['alignItems'] = 'flex-end'
			return st
		},
		mainStyle(): UTSJSONObject {
			const st = {} as UTSJSONObject
			st['width'] = this.width + 'rpx'
			st['height'] = this.height + 'rpx'
			st['borderRadius'] = this.radius as string
			st['backgroundColor'] = this.bgColor as string
			return st
		}
	},
	methods: {
		subText(btn: FabBtn): string {
			const k = this.textField as string
			const v = btn[k]
			return v == null ? '' : '' + v
		},
		subImg(btn: FabBtn): string {
			const k = this.imgField as string
			const v = btn[k]
			return v == null ? '' : '' + v
		},
		subColor(btn: FabBtn): string {
			const c = btn['color']
			return c == null ? '#ffffff' : '' + c
		},
		subFontSize(btn: FabBtn): number {
			const fs = btn['fontSize']
			if (fs != null) {
				const n = typeof fs === 'number' ? fs as number : parseInt('' + fs)
				if (!isNaN(n)) {
					return n
				}
			}
			const d = this.size
			return typeof d === 'number' ? d as number : parseInt('' + d)
		},
		subStyle(btn: FabBtn): UTSJSONObject {
			const st = {} as UTSJSONObject
			const bg = btn['bgColor']
			st['backgroundColor'] = bg == null ? '#16c2c2' : '' + bg
			return st
		},
		collapse() {
			this.expanded = false
		},
		onMainTap() {
			const list = this.btnList as any[]
			if (list.length > 0) {
				this.expanded = !this.expanded
				this.$emit('click', { index: 0 })
				return
			}
			this.$emit('click', { index: 0 })
		},
		onSubTap(idx: number) {
			this.$emit('click', { index: idx + 1 })
			this.expanded = false
		}
	}
}
</script>

<style lang="scss">
.mms-fab__mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.2);
}

.mms-fab__subs {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	margin-bottom: 24rpx;
}

.mms-fab__sub {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 16rpx 28rpx;
	border-radius: 40rpx;
	margin-bottom: 16rpx;
}

.mms-fab__sub-img {
	width: 40rpx;
	height: 40rpx;
	margin-right: 12rpx;
}

.mms-fab__sub-text {
	font-size: 28rpx;
}

.mms-fab__main {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.mms-fab__plus {
	font-size: 64rpx;
	line-height: 1;
}
</style>
