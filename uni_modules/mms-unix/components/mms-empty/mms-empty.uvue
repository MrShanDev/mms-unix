<template>
	<view class="mms-empty" :style="{ paddingTop: paddingTopCss }">
		<image v-if="image !== ''" class="mms-empty__image" :src="image" mode="aspectFit"></image>
		<view v-if="showIconBlock" class="mms-empty__icon">
			<slot name="icon">
				<mms-icon :name="resolvedIconName" size="96rpx" color="#c0c4cc"></mms-icon>
			</slot>
		</view>
		<view class="mms-empty__text">
			<text class="mms-empty__description">{{ displayText }}</text>
		</view>
		<view v-if="hasBottomSlot" class="mms-empty__bottom">
			<slot name="footer"></slot>
			<slot></slot>
		</view>
	</view>
</template>

<script lang="uts">
import { toCssLength } from '@/uni_modules/mms-unix/components/mms-tools/Ut.uts'

export default {
	name: 'mmsEmpty',
	props: {
		// 图片地址
		image: {
			type: String,
			default: ''
		},
		// 提示文字
		description: {
			type: String,
			default: '暂无数据'
		},
		// 与 description 相同含义，非空时优先于 description（便于简写）
		text: {
			type: String,
			default: ''
		},
		/** mms-icon 的 name；不传 image 时未指定 icon 则使用内置默认图标 file-common-filling */
		icon: {
			type: String,
			default: ''
		},
		// 图片距离顶部的距离
		paddingTop: {
			type: [Number, String],
			default: 200
		}
	},
	computed: {
		paddingTopCss(): string {
			return toCssLength(this.paddingTop as number | string)
		},
		displayText(): string {
			const t = (this.text as string).trim()
			if (t.length > 0) {
				return t
			}
			return this.description as string
		},
		/** 未传 icon 时使用字库内「文档」类填充图标，避免依赖 /static 插图缺失导致无图 */
		resolvedIconName(): string {
			const ic = (this.icon as string).trim()
			if (ic.length > 0) {
				return ic
			}
			return 'file-common-filling'
		},
		showIconBlock(): boolean {
			return (this.image as string).trim().length === 0
		},
		hasBottomSlot(): boolean {
			return this.$slots['footer'] != null || this.$slots.default != null
		}
	}
};
</script>

<style scoped lang="scss">
.mms-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	box-sizing: border-box;

	.mms-empty__image {
		width: 320rpx;
		height: 240rpx;
	}

	.mms-empty__icon {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.mms-empty__text {
		margin-top: 16rpx;
	}

	.mms-empty__description {
		font-size: 28rpx;
		color: #c0c4cc;
		line-height: 1.5;
	}

	.mms-empty__bottom {
		margin-top: 30rpx;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		width: 100%;
		box-sizing: border-box;
	}
}
</style>
