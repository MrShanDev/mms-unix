<template>
	<view
		class="mms-notice-bar"
		:class="{ 'mms-notice-bar--fixed': isFixed, 'mms-notice-bar--wrapable': wrapable && !single && !scrollable }"
		:style="rootStyle"
		@tap="onBarTap"
	>
		<view v-if="showLeftCol" class="mms-notice-bar__left" @tap.stop="onLeftTap">
			<slot name="icon">
				<mms-icon v-if="showIcon" name="volume" color="#ff7900" :size="iconSizeNum"></mms-icon>
			</slot>
		</view>
		<view class="mms-notice-bar__body">
			<view v-if="scrollable" class="mms-notice-bar__marquee">
				<view class="mms-notice-bar__track" :style="marqueeTrackStyle">
					<slot>
						<text class="mms-notice-bar__dup">{{ displayText }}</text>
						<text class="mms-notice-bar__dup">{{ displayText }}</text>
					</slot>
				</view>
			</view>
			<view
				v-else
				class="mms-notice-bar__content"
				:class="{
					'mms-notice-bar__content--single': single,
					'mms-notice-bar__content--wrap': wrapable && !single
				}"
				:style="contentTextStyle"
			>
				<slot>
					<text class="mms-notice-bar__text">{{ displayText }}</text>
				</slot>
			</view>
		</view>
		<view v-if="showRightCol" class="mms-notice-bar__right" @tap.stop="onRightTap">
			<slot name="right">
				<view v-if="showRight" class="mms-notice-bar__more">
					<text>更多</text>
					<mms-icon name="arrow-right" color="#c0c4cc" size="26rpx"></mms-icon>
				</view>
			</slot>
		</view>
	</view>
</template>

<script lang="uts">
import { toCssLength } from '@/uni_modules/mms-unix/components/mms-tools/Ut.uts'

export default {
	name: 'mmsNoticeBar',
	emits: ['click', 'leftClick', 'rightClick'],
	props: {
		text: {
			type: String,
			default: ''
		},
		content: {
			type: String,
			default: ''
		},
		showIcon: {
			type: Boolean,
			default: true
		},
		showRight: {
			type: Boolean,
			default: false
		},
		scrollable: {
			type: Boolean,
			default: true
		},
		wrapable: {
			type: Boolean,
			default: false
		},
		single: {
			type: Boolean,
			default: false
		},
		bgColor: {
			type: String,
			default: ''
		},
		backgroundColor: {
			type: String,
			default: '#fff8d5'
		},
		textColor: {
			type: String,
			default: ''
		},
		color: {
			type: String,
			default: '#ff7900'
		},
		height: {
			type: [Number, String],
			default: 72
		},
		size: {
			type: [Number, String],
			default: 28
		},
		bold: {
			type: Boolean,
			default: false
		},
		padding: {
			type: Array,
			default(): any[] {
				return []
			}
		},
		isLeft: {
			type: Boolean,
			default: false
		},
		isRight: {
			type: Boolean,
			default: false
		},
		isFixed: {
			type: Boolean,
			default: false
		},
		top: {
			type: String,
			default: '0px'
		},
		params: {
			type: [Number, String],
			default: 0
		},
		duration: {
			type: Number,
			default: 18
		}
	},
	computed: {
		displayText(): string {
			const c = this.content as string
			if (c != null && c.length > 0) {
				return c
			}
			return this.text as string
		},
		resolvedBg(): string {
			const b = this.bgColor as string
			if (b != null && b.length > 0) {
				return b
			}
			return this.backgroundColor as string
		},
		resolvedColor(): string {
			const t = this.textColor as string
			if (t != null && t.length > 0) {
				return t
			}
			return this.color as string
		},
		showLeftCol(): boolean {
			if (this.isLeft as boolean) {
				return true
			}
			return this.showIcon as boolean
		},
		showRightCol(): boolean {
			if (this.isRight as boolean) {
				return true
			}
			return this.showRight as boolean
		},
		iconSizeNum(): number {
			const s = this.size as number | string
			if (typeof s === 'number') {
				return s > 0 ? s : 28
			}
			const n = parseInt(s as string)
			return isNaN(n) ? 28 : n
		},
		paddingCss(): string {
			const arr = this.padding as any[]
			if (arr == null || arr.length === 0) {
				return ''
			}
			const parts = [] as string[]
			for (let i = 0; i < arr.length; i++) {
				parts.push(toCssLength(arr[i] as number | string))
			}
			if (parts.length === 1) {
				return parts[0]
			}
			if (parts.length === 2) {
				return parts[0] + ' ' + parts[1]
			}
			if (parts.length === 3) {
				return parts[0] + ' ' + parts[1] + ' ' + parts[2]
			}
			return parts[0] + ' ' + parts[1] + ' ' + parts[2] + ' ' + parts[3]
		},
		rootStyle(): UTSJSONObject {
			const h = toCssLength(this.height as number | string)
			const style = {
				backgroundColor: this.resolvedBg,
				minHeight: h
			} as UTSJSONObject
			if (this.isFixed as boolean) {
				style['position'] = 'fixed'
				style['left'] = '0'
				style['right'] = '0'
				style['top'] = this.top as string
				style['zIndex'] = '900'
			}
			const pad = this.paddingCss
			if (pad.length > 0) {
				style['padding'] = pad
			}
			return style
		},
		contentTextStyle(): UTSJSONObject {
			const fs = toCssLength(this.size as number | string)
			const bold = this.bold as boolean
			return {
				color: this.resolvedColor,
				fontSize: fs,
				fontWeight: bold ? 'bold' : 'normal'
			}
		},
		marqueeTrackStyle(): UTSJSONObject {
			const dur = this.duration as number
			const fs = toCssLength(this.size as number | string)
			const bold = this.bold as boolean
			return {
				animationDuration: dur + 's',
				color: this.resolvedColor,
				fontSize: fs,
				fontWeight: bold ? 'bold' : 'normal'
			}
		}
	},
	methods: {
		onBarTap() {
			this.$emit('click', { params: this.params } as UTSJSONObject)
		},
		onLeftTap() {
			this.$emit('leftClick', { params: this.params } as UTSJSONObject)
		},
		onRightTap() {
			this.$emit('rightClick', { params: this.params } as UTSJSONObject)
		}
	}
}
</script>

<style scoped lang="scss">
.mms-notice-bar {
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	padding: 18rpx 24rpx;
	border-radius: 8rpx;
}

.mms-notice-bar__left {
	margin-right: 8rpx;
	flex-shrink: 0;
}

.mms-notice-bar__body {
	flex: 1;
	min-width: 0;
	overflow: hidden;
}

.mms-notice-bar__marquee {
	overflow: hidden;
	width: 100%;
}

.mms-notice-bar__track {
	display: flex;
	flex-direction: row;
	flex-wrap: nowrap;
	width: max-content;
	animation: mms-notice-marquee linear infinite;
}

.mms-notice-bar__dup {
	white-space: nowrap;
	padding-right: 48rpx;
	line-height: 1.6;
}

.mms-notice-bar__content {
	line-height: 1.6;
	overflow: hidden;
}

.mms-notice-bar__text {
	line-height: inherit;
}

.mms-notice-bar__content--single {
	white-space: nowrap;
	text-overflow: ellipsis;
}

.mms-notice-bar__content--wrap {
	white-space: normal;
}

.mms-notice-bar__right {
	margin-left: 16rpx;
	flex-shrink: 0;

	.mms-notice-bar__more {
		display: flex;
		flex-direction: row;
		align-items: center;
		font-size: 26rpx;
		color: #c0c4cc;
	}
}

.mms-notice-bar--wrapable {
	.mms-notice-bar__content {
		white-space: normal;
	}
}

@keyframes mms-notice-marquee {
	0% {
		transform: translateX(0);
	}
	100% {
		transform: translateX(-50%);
	}
}
</style>
