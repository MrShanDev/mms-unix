 <template>
	<view class="mms-wx-login" @click="handleLogin">
		<view class="mms-wx-login__icon">
			<text class="iconfont icon-wechat"></text>
		</view>
		<view class="mms-wx-login__text">{{ text }}</view>
	</view>
</template>

<script lang="uts">
export default {
	name: 'mmsWxLogin',
	emits: ['success', 'fail', 'login'],
	props: {
		// 按钮文字
		text: {
			type: String,
			default: '微信一键登录'
		},
		// 按钮类型，code 获取code，userInfo 获取用户信息
		type: {
			type: String,
			default: 'code'
		}
	},
	methods: {
		handleLogin() {
			this.$emit('login')
			if (this.type === 'code') {
				// 微信小程序获取code
				// #ifdef MP-WEIXIN
				uni.login({
					provider: 'weixin',
					success: (res) => {
						this.$emit('success', {
							code: res.code
						})
					},
					fail: (err) => {
						this.$emit('fail', err)
						uni.showToast({
							title: '登录失败',
							icon: 'none'
						})
					}
				})
				// #endif
			} else if (this.type === 'userInfo') {
				// 获取用户信息
				// #ifdef MP-WEIXIN
				uni.getUserProfile({
					desc: '用于完善会员资料',
					success: (res) => {
						this.$emit('success', {
							userInfo: res.userInfo
						})
					},
					fail: (err) => {
						this.$emit('fail', err)
						uni.showToast({
							title: '获取用户信息失败',
							icon: 'none'
						})
					}
				})
				// #endif
			}
		}
	}
};
</script>

<style scoped lang="scss">
.mms-wx-login {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 90rpx;
	background-color: #07c160;
	border-radius: 45rpx;
	box-sizing: border-box;

	.mms-wx-login__icon {
		font-size: 36rpx;
		color: #fff;
		margin-right: 10rpx;
		line-height: 1;
	}

	.mms-wx-login__text {
		font-size: 32rpx;
		color: #fff;
		font-weight: 500;
		line-height: 1;
	}
}
</style>
