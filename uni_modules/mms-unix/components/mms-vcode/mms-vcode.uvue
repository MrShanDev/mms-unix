<template>
	<view class="mms-vcode" @tap="draw">
		<canvas :canvas-id="canvasId" class="mms-vcode__canvas" :style="canvasCss"></canvas>
	</view>
</template>

<script lang="uts">
import { parseCssNumber } from '@/uni_modules/mms-unix/components/mms-tools/Ut.uts'

export default {
	name: 'mmsVcode',
	emits: ['change'],
	props: {
		vcodeStr: {
			type: String,
			default: 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
		},
		length: {
			type: [Number, String],
			default: 4
		},
		width: {
			type: [Number, String],
			default: 100
		},
		height: {
			type: [Number, String],
			default: 36
		},
		bgColor: {
			type: String,
			default: ''
		},
		fontColor: {
			type: String,
			default: ''
		},
		hasPoint: {
			type: Boolean,
			default: true
		},
		hasLine: {
			type: Boolean,
			default: true
		}
	},
	data() {
		return {
			canvasId: '',
			currentValue: ''
		}
	},
	computed: {
		wPx(): number {
			return parseCssNumber(this.width as number | string)
		},
		hPx(): number {
			return parseCssNumber(this.height as number | string)
		},
		lenNum(): number {
			const l = this.length as number | string
			if (typeof l === 'number') {
				return l < 1 ? 4 : l
			}
			const n = parseInt(l as string)
			if (isNaN(n) || n < 1) {
				return 4
			}
			return n
		},
		canvasCss(): UTSJSONObject {
			return {
				width: this.wPx + 'px',
				height: this.hPx + 'px'
			}
		}
	},
	created() {
		this.canvasId = 'mms-vcode-' + Date.now() + '-' + Math.floor(Math.random() * 100000)
	},
	mounted() {
		this.$nextTick(() => {
			this.draw()
		})
	},
	methods: {
		randomChar(): string {
			const pool = this.vcodeStr as string
			if (pool.length === 0) {
				return 'A'
			}
			const i = Math.floor(Math.random() * pool.length)
			return pool.charAt(i)
		},
		randomColor(): string {
			const r = Math.floor(50 + Math.random() * 180)
			const g = Math.floor(50 + Math.random() * 180)
			const b = Math.floor(50 + Math.random() * 180)
			return 'rgb(' + r + ',' + g + ',' + b + ')'
		},
		draw() {
			const w = this.wPx
			const h = this.hPx
			if (w <= 0 || h <= 0) {
				return
			}
			let code = ''
			for (let i = 0; i < this.lenNum; i++) {
				code += this.randomChar()
			}
			this.currentValue = code
			const ctx = uni.createCanvasContext(this.canvasId, this)
			const bg = (this.bgColor as string).trim()
			if (bg.length > 0) {
				ctx.setFillStyle(bg as any)
			} else {
				ctx.setFillStyle(this.randomColor() as any)
			}
			ctx.fillRect(0, 0, w, h)
			if (this.hasLine) {
				for (let n = 0; n < 3; n++) {
					ctx.beginPath()
					ctx.setStrokeStyle(this.randomColor() as any)
					ctx.moveTo(Math.random() * w, Math.random() * h)
					ctx.lineTo(Math.random() * w, Math.random() * h)
					ctx.stroke()
				}
			}
			if (this.hasPoint) {
				for (let p = 0; p < 20; p++) {
					ctx.beginPath()
					ctx.setFillStyle(this.randomColor() as any)
					const x = Math.random() * w
					const y = Math.random() * h
					ctx.arc(x, y, 1, 0, 2 * Math.PI)
					ctx.fill()
				}
			}
			const fc = (this.fontColor as string).trim()
			const fontPx = Math.max(14, Math.floor(h * 0.72))
			ctx.setFontSize(fontPx)
			const step = w / (this.lenNum + 1)
			for (let j = 0; j < code.length; j++) {
				const ch = code.charAt(j)
				const useC = fc.length > 0 ? fc : this.randomColor()
				ctx.setFillStyle(useC as any)
				const x = step * (j + 0.45) + Math.random() * 3
				const y = h * 0.72 + Math.random() * 2
				ctx.fillText(ch, x, y)
			}
			ctx.draw(false, () => {
				this.$emit('change', { value: code } as UTSJSONObject)
			})
		}
	}
}
</script>

<style scoped lang="scss">
.mms-vcode {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-start;
}

.mms-vcode__canvas {
	display: block;
}
</style>
