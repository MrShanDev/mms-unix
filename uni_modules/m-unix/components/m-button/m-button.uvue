<template>
	<!-- 微信快捷登录组件 -->
	
	<view class="m-button__wrap"
		:class="[shouldFill ? 'm-btn__flex-1' : '',getShapeClass(shape, plain),!disabled?'m-button__hover':'']"
		:style="wrapStyle">
		<!-- #ifdef MP-WEIXIN -->
		
		<button class="m-btn" :class="[
				plain ? 'm-' + resolvedType(type) + '-outline' : 'm-btn-' + resolvedType(type),
				getDisabledClass(disabled, type, plain),
				getShapeClass(shape, plain),
				bold ? 'm-text-bold' : '',
				link ? 'm-btn__link' : ''
		]" :style="buttonMergedStyle"
			:loading="loading" :form-type="formType" :open-type="openType" :app-parameter="appParameter"
			@getuserinfo="bindgetuserinfo" @getphonenumber="bindgetphonenumber" @contact="bindcontact"
			@error="binderror" @chooseavatar="bindchooseavatar" @launchapp="bindlaunchapp" :disabled="disabled"
			@tap="handleClick">
			<text class="m-btn__text" :style="textMergedStyle"><slot></slot></text>
		</button>
		<!-- #endif -->
		<!-- #ifndef MP-WEIXIN -->
		<button class="m-btn" :class="[
				plain ? 'm-' + resolvedType(type) + '-outline' : 'm-btn-' + resolvedType(type),
				getDisabledClass(disabled, type, plain),
				getShapeClass(shape, plain),
				bold ? 'm-text-bold' : '',
				link ? 'm-btn__link' : '',
				loading ? 'm-btn--loading' : ''
		]" :style="buttonMergedStyle"
			:form-type="formType" :disabled="disabled" @tap="handleClick">
			<view class="m-btn__inner" :style="innerMergedStyle">
				<view v-if="loading" class="m-btn__loading" :style="loadingStyle">
					<m-loading text="" size="14rpx" :color="loadingSpinnerColor" />
				</view>
				<slot></slot>
			</view>
		</button>
		<!-- #endif -->
		<view class="m-button__border" :class="[getShapeClass(shape, plain),getDisabledClass(disabled, type, plain)]"
			:style="borderMergedStyle" v-if="!link && plain"></view>
	</view>
	
</template>

	<script lang="uts">
		import {GlobalColor} from '@/uni_modules/m-unix/components/m-tools/utype/type.uts'
		import { toCssLength } from '@/uni_modules/m-unix/components/m-tools/Ut.uts'

		function stringProp(value: any | null, fallback: string): string {
			if (value == null) return fallback
			const text = '' + value
			return text !== '' ? text : fallback
		}

		function objectProp(value: any | null): UTSJSONObject {
			if (value != null && typeof value === 'object') {
				return value as UTSJSONObject
			}
			return new UTSJSONObject()
		}

		function colorByKey(colors: UTSJSONObject, key: string, fallback: string): string {
			const value = colors[key]
			return value != null && value !== '' ? stringProp(value, fallback) : fallback
		}

		function eventDetail(event: any | null): any {
			if (event != null && typeof event === 'object') {
				const target = event as UTSJSONObject
				const detail = target['detail']
				return detail != null ? detail : new UTSJSONObject()
			}
			return new UTSJSONObject()
		}

		export default {
		name: 'mButton',
		emits: ['click', 'getuserinfo', 'contact', 'getphonenumber', 'error','chooseavatar','launchapp'],
		// #ifdef MP-WEIXIN
		behaviors: ['wx://form-field-button'],
		// #endif
		// #ifdef MP-BAIDU
		behaviors: ['swan://form-field'],
		// #endif
		// #ifdef MP-QQ
		behaviors: ['qq://form-field'],
		// #endif
		// #ifdef H5
		behaviors: ['uni://form-field'],
		// #endif
		props: {
			//样式类型 primary, white, danger, warning, green,blue, gray，black,brown,gray-primary,gray-danger,gray-warning,gray-green
			type: {
				type: String as unknown as PropType<string>,
				default: 'primary'
			},
			//是否加阴影 移除
			shadow: {
				type: Boolean,
				default: false
			},
			// 宽度 rpx或 %
			width: {
				type: String as unknown as PropType<string>,
				default: '100%'
			},
			//高度 rpx
			height: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			// medium / small / mini / tiny（超级迷你，较 mini 更小）
			btnSize: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			//字体大小 rpx
			size: {
				type: [Number, String] as unknown as PropType<number | string>,
				default: 0
			},
			bold: {
				type: Boolean,
				default: false
			},
			margin: {
				type: String as unknown as PropType<string>,
				default: '0'
			},
			// 自定义背景色，优先于 type
			bgColor: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			// 自定义文字颜色，优先于 type
			textColor: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			// 自定义圆角
			radius: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			customStyle: {
				type: Object as unknown as PropType<UTSJSONObject>,
				default: () => ({})
			},
			buttonStyle: {
				type: Object as unknown as PropType<UTSJSONObject>,
				default: () => ({})
			},
			innerStyle: {
				type: Object as unknown as PropType<UTSJSONObject>,
				default: () => ({})
			},
			textStyle: {
				type: Object as unknown as PropType<UTSJSONObject>,
				default: () => ({})
			},
			borderColor: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			borderWidth: {
				type: String as unknown as PropType<string>,
				default: '1px'
			},
			paddingX: {
				type: String as unknown as PropType<string>,
				default: '0'
			},
			paddingY: {
				type: String as unknown as PropType<string>,
				default: '0'
			},
			loadingGap: {
				type: String as unknown as PropType<string>,
				default: '8rpx'
			},
			loadingColor: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			//形状 circle(圆角), square(默认方形)，rightAngle(平角)
			shape: {
				type: String as unknown as PropType<string>,
				default: 'square'
			},
			plain: {
				type: Boolean,
				default: false
			},
			//link样式，去掉边框，结合plain一起使用
			link: {
				type: Boolean,
				default: false
			},
			disabled: {
				type: Boolean,
				default: false
			},
			//禁用后背景是否为灰色 （非空心button生效）
			disabledGray: {
				type: Boolean,
				default: false
			},
			loading: {
				type: Boolean,
				default: false
			},
			formType: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			openType: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			appParameter: {
				type: String as unknown as PropType<string>,
				default: ''
			},
			index: {
				type: [Number, String] as unknown as PropType<number | string>,
				default: 0
			},
			//是否需要阻止重复点击【默认200ms】
			preventClick: {
				type: Boolean,
				default: false
			}
		},
		computed: {
				getWidth(): string {
					//medium 184*40 / small 120 40/ mini 58*32
					let width = stringProp(this.width, '100%');
				// console.log(this.btnSize)
				if (this.btnSize !== '') {
					if (this.btnSize === 'medium') {
						width = '368rpx'
					} else if (this.btnSize === 'small') {
						width = '240rpx'
					} else if (this.btnSize === 'mini') {
						width = '116rpx'
					} else if (this.btnSize === 'tiny') {
						width = '112rpx'
					}
				}
				return width
			},
				getHeight(): string {
					//medium 184*40 / small 120 40/ mini 58*32
					let height = stringProp(this.height, '') !== '' ? stringProp(this.height, '') : '96rpx';
				if (this.btnSize !== '') {
					if (this.btnSize === 'medium') {
						height = '80rpx'
					} else if (this.btnSize === 'small') {
						height = '80rpx'
					} else if (this.btnSize === 'mini') {
						height = '64rpx'
					} else if (this.btnSize === 'tiny') {
						height = '48rpx'
					}
				}
				return height
			},
			getSize() {
				// 显式传入 size（非 0）时优先；否则按 btnSize。btnSize 做 trim+小写，避免模板/端上大小写不一致导致档位不生效。
				const sz = this.size
				if (typeof sz === 'number') {
					if (sz !== 0) {
						return sz
					}
				} else {
					const s = ('' + sz).trim()
					if (s.length > 0) {
						const n = parseFloat(s)
						if (!isNaN(n) && n !== 0) {
							return s
						}
					}
				}
				const bs = ('' + this.btnSize).trim().toLowerCase()
				if (bs === 'large') {
					return 34
				}
				if (bs === 'medium') {
					return 30
				}
				if (bs === 'small') {
					return 26
				}
				if (bs === 'mini') {
					return 18
				}
				if (bs === 'tiny') {
					return 12
				}
				return 28
			},
			fontSizeCss(): string {
				return toCssLength(this.getSize as number | string)
			},
				getRadius(): string {
					return stringProp(this.radius, '6rpx')
				},
			shouldFill(): boolean {
				return (this.width === '100%' || this.width === '') && this.height === '' && this.btnSize === ''
			},
			wrapStyle(): UTSJSONObject {
				const st: UTSJSONObject = {
					width: this.getWidth,
					height: this.getHeight,
						margin: stringProp(this.margin, '0')
					}
					Object.assign(st, objectProp(this.customStyle))
				return st
			},
			buttonMergedStyle(): UTSJSONObject {
				const st: UTSJSONObject = {
					width: this.getWidth,
					height: this.getHeight,
					'line-height': '1',
					'font-size': this.fontSizeCss,
					background: this.getButtonBgColor(this.type as string, this.plain as boolean),
					color: this.getButtonTextColor(this.type as string, this.plain as boolean),
					'border-radius': this.getRadius,
					'box-shadow': this.shadow ? this.getShadow(this.type as string, this.plain as boolean) : 'none',
						'padding-left': stringProp(this.paddingX, '0'),
						'padding-right': stringProp(this.paddingX, '0'),
						'padding-top': stringProp(this.paddingY, '0'),
						'padding-bottom': stringProp(this.paddingY, '0')
					}
					Object.assign(st, objectProp(this.buttonStyle))
				return st
			},
			innerMergedStyle(): UTSJSONObject {
				const st: UTSJSONObject = {
					'font-size': this.fontSizeCss
				}
					Object.assign(st, objectProp(this.innerStyle))
				return st
			},
			textMergedStyle(): UTSJSONObject {
				const st: UTSJSONObject = {
					'font-size': this.fontSizeCss,
					color: this.getButtonTextColor(this.type as string, this.plain as boolean),
					'line-height': '1'
				}
					Object.assign(st, objectProp(this.textStyle))
				return st
			},
			borderMergedStyle(): UTSJSONObject {
				return {
						'border-color': stringProp(this.borderColor, '') !== '' ? stringProp(this.borderColor, '') : this.getBgColor(this.type as string, true),
						'border-width': stringProp(this.borderWidth, '1px'),
					'border-radius': this.getRadius
				}
			},
			/** 非微信端 loading 小圆点与按钮字色一致 */
				loadingSpinnerColor(): string {
					const loadingText = stringProp(this.loadingColor, '')
					return loadingText !== '' ? loadingText : stringProp(this.getColor(this.type as string, this.plain as boolean), '#ffffff')
			},
			loadingStyle(): UTSJSONObject {
				return {
						'margin-right': stringProp(this.loadingGap, '8rpx')
				}
			}
		},
		data() {
			return {
				time: 0
			};
		},
		methods: {
			resolvedType(type:any | null): string {
				return stringProp(type, 'primary')
			},
			hexToRGB(hex:string) {
				if (hex.length === 4) {
					let text = hex.substring(1, 4);
					hex = '#' + text + text;
				}
				let result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
				if (result == null) {
					return {}
				}
				return {
					r: parseInt(stringProp(result[1], '00'), 16),
					g: parseInt(stringProp(result[2], '00'), 16),
					b: parseInt(stringProp(result[3], '00'), 16)
				};
			},
			getColorByType(type:any | null, isText?:boolean, plain?:boolean): string {
				const finalType = this.resolvedType(type)
				// 默认主题颜色
				let color = ''
			const colors = {
				'primary': '#5677fc',
				'white': '#fff',
				'danger': '#EB0909',
				'warning': '#ff7900',
				'green': '#07c160',
				'blue': '#007aff',
				'gray': '#bfbfbf',
				'black': '#333333',
				'brown': '#ac9157',
				'gray-primary': '#f2f2f2',
				'gray-danger': '#f2f2f2',
				'gray-warning': '#f2f2f2',
				'gray-green': '#f2f2f2'
			}
				if (isText === true) {
					if (finalType !== '' && finalType.indexOf('gray-') >= 0) {
						const tp = finalType.replace('gray-', '')
						if (tp in colors){
							color = colorByKey(colors, tp, '#fff')
						}
					} else if (finalType === 'white') {
						color = '#333'
					} else {
						if (plain === true) {
							color = colorByKey(colors, finalType, '#fff')
						} else {
							color = '#fff'
						}
					}
				} else {
					color = colorByKey(colors, finalType, colorByKey(colors, 'primary', '#5677fc'))
				}
				return color;
			},
			getShadow(type:any | null, plain:boolean) {
				const color = this.getColorByType(type, false, plain)
				if (plain || color == null || color === '') return 'none';
				const rgb = this.hexToRGB(color)
				return `0 10rpx 14rpx 0 rgba(${rgb['r']}, ${rgb['g']}, ${rgb['b']}, 0.2)`
			},
			getBgColor(type:any | null, plain:boolean) {
				return plain ? 'transparent' : this.getColorByType(type, false, plain)
			},
			getColor(type:any | null, plain:boolean) {
				return this.getColorByType(type, true, plain)
			},
			getButtonBgColor(type:any | null, plain:boolean) {
				const bg = stringProp(this.bgColor, '')
				return bg !== '' ? bg : this.getBgColor(type, plain)
			},
			getButtonTextColor(type:any | null, plain:boolean) {
				const color = stringProp(this.textColor, '')
				return color !== '' ? color : this.getColor(type, plain)
			},
			handleClick() {
				if (this.disabled) return;
				if (this.loading) return;
				if (this.preventClick) {
					if (new Date().getTime() - this.time <= 200) return;
					this.time = new Date().getTime();
					setTimeout(() => {
						this.time = 0;
					}, 200);
				}
				this.$emit('click', {
					index: parseFloat('' + this.index)
				});
			},
			bindgetuserinfo(event: any | null) {
				this.$emit('getuserinfo', eventDetail(event));
			},
			bindcontact(event: any | null) {
				this.$emit('contact', eventDetail(event));
			},
			bindgetphonenumber(event: any | null) {
				this.$emit('getphonenumber', eventDetail(event));
			},
			binderror(event: any | null) {
				this.$emit('error', eventDetail(event));
			},
			bindchooseavatar(event: any | null) {
				this.$emit('chooseavatar', eventDetail(event));
			},
			bindlaunchapp(event: any | null) {
				this.$emit('launchapp', eventDetail(event));
			},
			getDisabledClass: function(disabled:any | null, type:any | null, plain:any | null) {
				let className = '';
				const finalType = this.resolvedType(type)
				if (disabled === true && finalType != 'white' && finalType.indexOf('-') == -1) {
					let classVal = this.disabledGray ? 'm-gray-disabled' : 'm-dark-disabled';
					className = plain === true ? 'm-dark-disabled-outline' : classVal;
				}
				return className;
			},
			getShapeClass: function(shape:any | null, plain:any | null) {
				let className = '';
				const finalShape = shape != null ? shape : 'square'
				if (finalShape == 'circle') {
					className = plain === true ? 'm-outline-fillet' : 'm-fillet';
				} else if (finalShape == 'rightAngle') {
					className = plain === true ? 'm-outline-rightAngle' : 'm-rightAngle';
				}
				return className;
			},
			getHoverClass: function(disabled:any | null, type:any | null, plain:any | null) {
				let className = '';
				if (disabled !== true) {
					className = plain === true ? 'm-outline-hover' : 'm-' + this.resolvedType(type) + '-hover';
				}
				return className;
			}
		}
	};
</script>

<style scoped lang="scss">
	.m-button__wrap {
		position: relative;
		overflow: visible;
		box-sizing: border-box;
	}

	/* button start*/

	.m-btn {
		width: 100%;
		position: relative;
		border: 0 !important;
		box-sizing: border-box;
		border-radius: 6rpx;
		padding-left: 0;
		padding-right: 0;
		overflow: visible;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.m-btn__inner {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}

	.m-btn--loading {
		pointer-events: none;
	}

	.m-btn__loading {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.m-btn__flex-1 {
		flex: 1;
	}

	/* 镂空边框：与内容区同尺寸，避免 200% + scale(0.5) 在部分端右侧被裁切 */
	.m-button__border {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		height: 100%;
		box-sizing: border-box;
		border-radius: 6rpx;
		border: 1px solid transparent;
		pointer-events: none;
	}

	.m-text-bold {
		font-weight: bold;
	}

	.m-dark-disabled {
		opacity: 0.6 !important;
		color: #fafbfc !important;
	}

	.m-dark-disabled-outline {
		opacity: 0.5 !important;
	}

	.m-gray-disabled {
		background: #f3f3f3 !important;
		color: #919191 !important;
		box-shadow: none;
	}

	/*圆角 */

	.m-fillet {
		border-radius: 220rpx !important;
	}

	.m-outline-fillet {
		border-radius: 220rpx !important;
	}

	/*平角*/
	.m-rightAngle {
		border-radius: 0 !important;
	}

	.m-outline-rightAngle {
		border-radius: 0 !important;
	}
	</style>
