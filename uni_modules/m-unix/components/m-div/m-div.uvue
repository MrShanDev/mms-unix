<template>
	<view class="m-div" :class="getDividerClass" :style="{ backgroundColor: backgroundColor, height: height }">
		<view v-if="contentPosition !== 'center'" class="m-div__content" :class="[`m-div__content--${contentPosition}`, textClass ? textClass : '']" :style="{ color: textColor, 'font-size': resolvedFontSize }">
			<slot></slot>
			<text v-if="text">{{ text }}</text>
		</view>
		<view v-else class="m-div__content m-div__content--center" :class="[textClass ? textClass : '']" :style="{ color: textColor, 'font-size': resolvedFontSize }">
			<slot></slot>
			<text v-if="text">{{ text }}</text>
		</view>
	</view>
</template>

<script lang="uts">
import { toCssLength } from '@/uni_modules/m-unix/components/m-tools/Ut.uts'

export default {
	name: 'mDiv',
	props: {
		// 分割线颜色
		backgroundColor: {
			type: String,
			default: ''
		},
		// 文字颜色
		textColor: {
			type: String,
			default: '#909399'
		},
		// 文字大小
		fontSize: {
			type: [Number, String],
			default: 28
		},
		// 分割线高度
		height: {
			type: String,
			default: '1rpx'
		},
		// 文字位置 left/center/right
		contentPosition: {
			type: String,
			default: 'center'
		},
		// 文字内容
		text: {
			type: String,
			default: ''
		},
		// 文字自定义类名
		textClass: {
			type: String,
			default: ''
		}
	},
	computed: {
		getDividerClass() {
			const classes: string[] = ['m-div']
			if (this.text || this.$slots.default) {
				classes.push('m-div--has-text')
			}
			return classes.join(' ')
		},
		resolvedFontSize(): string {
			return toCssLength(this.fontSize as number | string)
		}
	}
};
</script>

<style scoped lang="scss">
.m-div {
	position: relative;
	box-sizing: border-box;
	background-color: #e4e7ed;

	.m-div__content {
		position: absolute;
		background-color: #ffffff;
		padding: 0 16rpx;
		transform: translateY(-50%);
		color: #909399;

		&.m-div__content--left {
			left: 20rpx;
		}

		&.m-div__content--center {
			left: 50%;
			transform: translate(-50%, -50%);
		}

		&.m-div__content--right {
			right: 20rpx;
		}
	}

	&.m-div--has-text {
		background-color: transparent;
	}
}
</style>
