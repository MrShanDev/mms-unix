<template>
	<view class="mms-login-mask" @tap="handleClose">
		<view class="mms-login-modal" @tap.stop="">
			<view class="modal-header">
				<text class="modal-title">温馨提示</text>
				<text class="modal-close" @tap="handleClose">×</text>
			</view>
			<view class="modal-body">
				<text class="modal-desc">请先登录后使用完整功能</text>
			</view>
			<view class="modal-footer">
				<view class="btn cancel" @tap="handleClose">暂不登录</view>
				<view class="btn primary" @tap="goLogin">去登录</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	const emit = defineEmits(['close'])

	function handleClose() {
		emit('close')
	}

	function goLogin() {
		emit('close')
		uni.navigateTo({ url: '/pages/login/login' })
	}
</script>

