/**
 * 认证相关 API - 对接后端接口示例
 */
import { http, request } from '@/uni_modules/mms-unix/components/mms-tools/Request.uts'

/** 快捷登录（验证码） */
export function loginByCode(phone: string, code: string) {
	return http.post('/api/auth/login/code', {
		phone,
		code,
	})
}

/** 账号密码登录 */
export function loginByPassword(account: string, password: string) {
	return http.post('/api/auth/login/password', {
		account,
		password,
	})
}

/** 发送验证码 */
export function sendSmsCode(phone: string, type: string) {
	return http.post('/api/auth/sms/send', { phone, type })
}

/** 注册 */
export function register(params: {
	phone: string
	code: string
	username: string
	password: string
}) {
	return http.post('/api/auth/register', params)
}

/** 找回密码 */
export function resetPassword(phone: string, code: string, password: string) {
	return http.post('/api/auth/password/reset', { phone, code, password })
}

/** Token 登录（静默校验，不跳转登录页） */
export function tokenLogin() {
	return request({
		url: '/api/auth/token/login',
		method: 'GET',
		withToken: true,
		showError: false,
		redirectOnUnauthorized: false
	})
}

/** 退出登录 */
export function logout() {
	return http.post('/api/auth/logout')
}