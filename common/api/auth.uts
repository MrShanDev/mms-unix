/**
 * 认证相关 API 示例 — 与 `mms-api-unix` `/api/member/v1`、`/api/base/v1` 对齐。
 * 请求体字段请以服务端 OpenAPI / 源码为准；详见 `docs/mms-api-unix-接口适配.md`。
 */
import { http, request } from '@/uni_modules/m-unix/components/m-tools/Request.uts'

/** 手机号 + 短信验证码登录（`StoreMemberLoginPhoneBo`） */
export function loginByCode(phone: string, code: string) {
	return http.post('/api/member/v1/login', {
		phone,
		smsCode: code
	})
}

/** 账号密码登录（邮箱账号 `StoreMemberEmailLoginBo`：`email`、`password`） */
export function loginByPassword(account: string, password: string) {
	return http.post('/api/member/v1/account-login', {
		email: account,
		password: password
	})
}

/** 发送短信验证码（`type` 与后端枚举一致：1 注册 2 登录 …） */
export function sendSmsCode(phone: string, type: number) {
	return http.post('/api/base/v1/sms-code', { phone, type })
}

/** 注册（与手机号登录同接口时，请直接调用 loginByCode 或 `mallApi.phoneSmsLogin`） */
export function register(params: {
	phone: string
	code: string
	username: string
	password: string
}) {
	return http.post('/api/member/v1/login', params)
}

/** 找回密码（`StoreMemberSetPasswordBo`，字段以后端为准） */
export function resetPassword(phone: string, code: string, password: string) {
	return http.post('/api/member/v1/find-password', { phone, code, password })
}

/** Token 登录（静默校验，不跳转登录页） */
export function tokenLogin() {
	return request({
		url: '/api/member/v1/token-login',
		method: 'GET',
		withToken: true,
		showError: false,
		redirectOnUnauthorized: false
	})
}

/** 退出登录 */
export function logout() {
	return http.post('/api/member/v1/logout')
}
