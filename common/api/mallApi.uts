/**
 * 商城/会员等业务 API — 与 mms-plus **mms-open-api**（`/api/{模块}/v1/...`）对齐。
 * 适配说明见 mms-doc「网站模块 / 开放接口」及服务端约定。
 */
import { config } from '@/common/config'
import { request, ApiResponse, http, AnyRecord } from '@/uni_modules/m-unix/components/m-tools/Request.uts'

const apiBase = config.baseUrl

function mallApi<T = any>(
	path: string,
	method: 'GET' | 'POST',
	data?: UTSJSONObject,
	needLogin: boolean = false,
	showError: boolean = true
): Promise<ApiResponse<T>> {
	return request<T>({
		url: path,
		method,
		data: data as AnyRecord,
		baseUrl: apiBase,
		withToken: true,
		showError,
		redirectOnUnauthorized: needLogin,
		unauthorizedCodes: [401, 403]
	})
}

function publicApi<T = any>(
	path: string,
	method: 'GET' | 'POST',
	data?: UTSJSONObject
): Promise<ApiResponse<T>> {
	return request<T>({
		url: path,
		method,
		data: data as AnyRecord,
		baseUrl: apiBase,
		withToken: true,
		showError: true,
		redirectOnUnauthorized: false
	})
}

// ========== 公开接口（无需登录）==========

/** 根据广告位编码查询广告；Query：`advertisingCode`，可选 `size` */
export function selectByAdvertisingCode(params: UTSJSONObject) {
	return publicApi('/api/ad/v1/by-code', 'GET', params)
}

/** 获取藏品列表（当前 mms-open-api 未提供，需其它微服务或网关；保留旧路径便于自建网关转发） */
export function collectionList(params: UTSJSONObject) {
	return publicApi('/v1/collection/list', 'POST', params)
}

/** 文章列表：GET，Query 与后端一致：`cateId`、`pageNum`、`pageSize` 等 */
export function articleList(params: UTSJSONObject) {
	return publicApi('/api/article/v1/articles', 'GET', params)
}

/** 商品列表（当前 mms-open-api 未提供对应接口） */
export function productListPage(params: UTSJSONObject) {
	return publicApi('/api/v1/storeProduct/productList', 'GET', params)
}

/** 藏品详情 */
export function collectionDetails(id: string) {
	return publicApi(`/v1/collection/${id}`, 'GET')
}

/** 藏品证书查询 */
export function selectController(params: UTSJSONObject) {
	return publicApi('/v1/collection/selectController', 'GET', params)
}

/** 文章详情 */
export function articleDetails(id: string) {
	return publicApi('/api/article/v1/articles/detail', 'GET', {
		id: id
	} as UTSJSONObject)
}

/** 区域列表（省市区） */
export function storeToolAreaList(params?: UTSJSONObject) {
	return publicApi('/api/base/v1/store-tool-areas', 'GET', params)
}

/** 发送短信验证码；Body：`phone`、`type`（1 注册 2 登录 … 见后端枚举） */
export function mallSendSmsCode(params: UTSJSONObject) {
	return publicApi('/api/base/v1/sms-code', 'POST', params)
}

/**
 * 账号注册（若业务等同于「手机号 + 验证码注册并登录」，与 `phoneSmsLogin` 同为 `/api/member/v1/login`）
 */
export function accountRegister(params: UTSJSONObject) {
	return publicApi('/api/member/v1/login', 'POST', params)
}

/** 找回密码 */
export function findPassword(params: UTSJSONObject) {
	return publicApi('/api/member/v1/find-password', 'POST', params)
}

/**
 * 检查版本更新；GET `/api/app/v1/upgrade-check`，Query：`type`（1=iOS，2=Android，默认 2）。
 * 仍附加 `currentVersionCode` 供网关或兼容旧后端。
 */
export function checkUpdate(currentVersionCode: number) {
	let platformType = 2
	// #ifdef APP-IOS
	platformType = 1
	// #endif
	const q: UTSJSONObject = {
		type: platformType
	} as UTSJSONObject
	if (currentVersionCode > 0) {
		q['currentVersionCode'] = currentVersionCode
	}
	return publicApi(config.api.update.checkUpdate, 'GET', q)
}

// ========== 登录相关（无需跳转登录页）==========

/** token 登录（静默校验） */
export function tokenLogin(params: UTSJSONObject) {
	return request({
		url: config.api.login.tokenLogin,
		method: 'GET',
		data: params as AnyRecord,
		baseUrl: apiBase,
		withToken: true,
		showError: false,
		redirectOnUnauthorized: false
	})
}

/** 微信手机号登录/注册 */
export function weixinLogin(params: UTSJSONObject) {
	return request({
		url: config.api.login.codeGetPhoneRegisterOrLogin,
		method: 'GET',
		data: params as AnyRecord,
		baseUrl: apiBase,
		withToken: false,
		showError: true,
		redirectOnUnauthorized: false
	})
}

/** 账号+密码登录 */
export function mallAccountLogin(params: UTSJSONObject) {
	return request({
		url: '/api/member/v1/account-login',
		method: 'POST',
		data: params as AnyRecord,
		baseUrl: apiBase,
		withToken: false,
		showError: true,
		redirectOnUnauthorized: false
	})
}

/** 手机号+验证码登录 */
export function phoneSmsLogin(params: UTSJSONObject) {
	return request({
		url: '/api/member/v1/login',
		method: 'POST',
		data: params as AnyRecord,
		baseUrl: apiBase,
		withToken: false,
		showError: true,
		redirectOnUnauthorized: false
	})
}

