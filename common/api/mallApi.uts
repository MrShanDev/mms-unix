/**
 * 商城/托管 API - 使用统一请求工具
 */
import { config } from '@/common/config'
import { request, ApiResponse, http, AnyRecord } from '@/uni_modules/mms-unix/components/mms-tools/Request.uts'

// 商城 API 基础地址（与 env 解析后的 config.baseUrl 一致）
const apiBase = config.baseUrl

/**
 * 商城请求封装
 * @param path 接口路径
 * @param method 请求方法
 * @param data 请求数据
 * @param needLogin 是否需要登录（true 则未登录跳转登录页）
 * @param showError 是否显示错误提示
 */
function mallApi<T = any>(
	path: string,
	method: 'GET' | 'POST',
	data?: UTSJSONObject,
	needLogin: boolean = false,
	showError: boolean = true
): Promise<ApiResponse<T>> {
	return request<T>({
		url: path,
		method,
		data: data as AnyRecord,
		baseUrl: apiBase,
		withToken: true,
		showError,
		redirectOnUnauthorized: needLogin,
		unauthorizedCodes: [401, 403]
	})
}

/**
 * 公开接口（无需登录）
 */
function publicApi<T = any>(
	path: string,
	method: 'GET' | 'POST',
	data?: UTSJSONObject
): Promise<ApiResponse<T>> {
	return request<T>({
		url: path,
		method,
		data: data as AnyRecord,
		baseUrl: apiBase,
		withToken: true,
		showError: true,
		redirectOnUnauthorized: false
	})
}

// ========== 公开接口（无需登录）==========

/** 根据广告位编码查询广告 */
export function selectByAdvertisingCode(params: UTSJSONObject) {
	return publicApi('/v1/common/location/selectByAdvertisingCode', 'GET', params)
}

/** 获取藏品列表 */
export function collectionList(params: UTSJSONObject) {
	return publicApi('/v1/collection/list', 'POST', params)
}

/** 获取文章列表 */
export function articleList(params: UTSJSONObject) {
	return publicApi('/v1/article/articleList', 'POST', params)
}

/** 商品列表（正在出售） */
export function productListPage(params: UTSJSONObject) {
	return publicApi('/api/v1/storeProduct/productList', 'GET', params)
}

/** 藏品详情 */
export function collectionDetails(id: string) {
	return publicApi(`/v1/collection/${id}`, 'GET')
}

/** 藏品证书查询 */
export function selectController(params: UTSJSONObject) {
	return publicApi('/v1/collection/selectController', 'GET', params)
}

/** 文章详情 */
export function articleDetails(id: string) {
	return publicApi(`/v1/article/article/${id}`, 'GET')
}

/** 区域列表（省市区） */
export function storeToolAreaList(params?: UTSJSONObject) {
	return publicApi('/v1/common/common/storeToolAreaList', 'GET', params)
}

/** 发送验证码 type: 1注册 2登录 3修改密码 */
export function mallSendSmsCode(params: UTSJSONObject) {
	return publicApi('/v1/common/common/smsCode', 'POST', params)
}

/** 账号注册 */
export function accountRegister(params: UTSJSONObject) {
	return publicApi('/v1/common/login/accountRegister', 'POST', params)
}

/** 找回密码 */
export function findPassword(params: UTSJSONObject) {
	return publicApi('/v1/common/login/findPassword', 'POST', params)
}

/** 检查版本更新 */
export function checkUpdate(currentVersionCode: number) {
	return publicApi(config.api.update.checkUpdate, 'GET', {
		currentVersionCode: currentVersionCode
