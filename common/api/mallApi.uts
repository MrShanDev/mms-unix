}

// ========== 登录相关（无需跳转登录页）==========

/** token 登录（静默校验） */
export function tokenLogin(params: UTSJSONObject) {
	return request({
		url: '/v1/common/login/tokenLogin',
		method: 'GET',
		data: params as AnyRecord,
		baseUrl: apiBase,
		withToken: true,
		showError: false,
		redirectOnUnauthorized: false
	})
}

/** 微信手机号登录/注册 */
export function weixinLogin(params: UTSJSONObject) {
	return request({
		url: '/v1/common/login/codeGetPhoneRegisterOrLogin',
		method: 'GET',
		data: params as AnyRecord,
		baseUrl: apiBase,
		withToken: false,
		showError: true,
		redirectOnUnauthorized: false
	})
}

/** 账号+密码登录 */
export function mallAccountLogin(params: UTSJSONObject) {
	return request({
		url: '/v1/common/login/accountLogin',
		method: 'POST',
		data: params as AnyRecord,
		baseUrl: apiBase,
		withToken: false,
		showError: true,
		redirectOnUnauthorized: false
	})
}

/** 手机号+验证码登录 */
export function phoneSmsLogin(params: UTSJSONObject) {
	return request({
		url: '/v1/common/login/login',
		method: 'POST',
		data: params as AnyRecord,
		baseUrl: apiBase,
		withToken: false,
		showError: true,
		redirectOnUnauthorized: false
	})
}

