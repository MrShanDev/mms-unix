// ========== 电子合同相关 ==========

/** 创建合同 - 立即签署（需登录） */
export function createContract(params: UTSJSONObject) {
	return mallRequest('/api/mall/contract/create', 'POST', params, true)
}

/** 查询订单签署状态（需登录） */
export function getContractStatus(orderId: string) {
	return mallRequest('/api/mall/contract/status', 'GET', { orderId: orderId }, true)
}

/** 获取合同列表（需登录） */
export function getContractList(params: UTSJSONObject) {
	return mallRequest('/api/mall/contract/list', 'GET', params, true)
}

/** 获取合同详情（需登录） */
export function getContractDetail(id: string) {
	return mallRequest('/api/mall/contract/detail', 'GET', { id: id }, true)
}

/** 下载合同PDF（需登录） */
export function downloadContractPdf(id: string) {
	const base = config.mallBaseUrl != '' ? config.mallBaseUrl : config.baseUrl
	return base + '/api/mall/contract/download?id=' + id
}

// ========== 版本更新检测 ==========

/** 检查版本更新 */
export function checkUpdate(currentVersionCode: number) {
	return mallRequest(config.api.update.checkUpdate, 'GET', {
		currentVersionCode: currentVersionCode
	}, false)
}
