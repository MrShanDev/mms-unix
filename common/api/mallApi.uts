// ========== 电子合同相关 ==========

/** 创建合同 - 立即签署 */
export function createContract(params: UTSJSONObject) {
	return mallApi('/api/mall/contract/create', 'POST', params, true)
}

/** 查询订单签署状态 */
export function getContractStatus(orderId: string) {
	return mallApi('/api/mall/contract/status', 'GET', { orderId: orderId } as UTSJSONObject, true)
}

/** 获取合同列表 */
export function getContractList(params: UTSJSONObject) {
	return mallApi('/api/mall/contract/list', 'GET', params, true)
}

/** 获取合同详情 */
export function getContractDetail(id: string) {
	return mallApi('/api/mall/contract/detail', 'GET', { id: id } as UTSJSONObject, true)
}

/** 下载合同PDF */
export function downloadContractPdf(id: string): string {
	const base = config.baseUrl
	return base + '/api/mall/contract/download?id=' + id
}