<template>
	<view class="page">
		<view class="content-wrap">
			<view class="p-20">
				<rich-text v-if="detail.articleHtml" class="content" :nodes="detail.articleHtml"></rich-text>
				<view v-if="!loading && !detail.articleTitle && !detail.articleHtml" class="empty-tip">暂无内容</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { articleDetails } from '@/common/api/mallApi'

	const id = ref('')
	const detail = ref<Record<string, any>>({})
	const loading = ref(false)

	function goBack() {
		uni.navigateBack()
	}

	function constrainImagesInHtml(html : string) : string {
		if (html == null || html == '') return html
		return html.replace(/\<img\s/gi, '<img style="max-width:100%!important;height:auto!important;display:block;" ')
	}

	function getArticleDetails() {
		if (id.value == '') return
		loading.value = true
		articleDetails(id.value).then((res) => {
			if (res.code == 200 && res.data != null) {
				const data = res.data as Record<string, any>
				const rawHtml = data['articleHtml']
				if (rawHtml != null && typeof rawHtml == 'string') {
					data['articleHtml'] = constrainImagesInHtml(rawHtml as string)
				}
				detail.value = data
			}
		}).catch(() => {}).finally(() => { loading.value = false })
	}

	onLoad((options) => {
		id.value = options['id'] ?? ''
		getArticleDetails()
	})
</script>

<style lang="scss" scoped>
.page { min-height: 100vh; background-color: #f5f5f5; }
.content-wrap {
	background-color: #fff;
	overflow-x: hidden;
	max-width: 100%;
}
.p-20 { padding: 40rpx; }
.content {
	font-size: 28rpx;
	color: #666;
	line-height: 2;
	width: 100%;
	overflow-x: hidden;
	word-break: break-all;
}
.empty-tip { text-align: center; padding: 60rpx; font-size: 28rpx; color: #999; }
</style>
