// 引入根组件
import App from './App.uvue'
// 引入 Vue SSR 应用创建函数
import { createSSRApp } from 'vue'
// 引入 mms-unix 组件库
import mmsUnix from '@/uni_modules/mms-unix'

/**
 * 创建应用入口函数
 * 由 uni-app 框架调用，返回应用实例
 */
export function createApp() {
	// 创建 Vue 应用实例
	const app = createSSRApp(App)
	// 安装 mms-unix 组件库
	app.use(mmsUnix)
	// 返回应用实例给框架
	return {
		app
	}
}