	display: flex;
	flex-direction: row;
	align-items: center;
}

.section-more-text {
	font-size: 26rpx;
	color: #9e9b98;
}

.section-more-arrow {
	font-size: 30rpx;
	color: #b6b0ab;
	line-height: 1;
	margin-left: 6rpx;
}

.recommend-grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
}

.recommend-card {
	width: 31.5%;
	display: flex;
	flex-direction: column;
}

.recommend-card-space {
	margin-bottom: 24rpx;
}

/* 藏品热卖 - 一行2个 */
.product-grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
}

.product-card {
	width: 48%;
	display: flex;
	flex-direction: column;
}

.product-card-space {
	margin-bottom: 24rpx;
}

.product-image {
	width: 100%;
	height: 196rpx;
	border-radius: 6rpx;
	background-color: #ece8df;
}

.product-name {
	font-size: 24rpx;
	color: #111;
	font-weight: 600;
	line-height: 1.4;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
	margin-top: 12rpx;
}

.recommend-image {
	width: 100%;
	height: 196rpx;
	border-radius: 6rpx;
	background-color: #ece8df;
}

.recommend-name {
	font-size: 24rpx;
	color: #111;
	font-weight: 600;
	line-height: 1.4;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
	margin-top: 12rpx;
}

.recommend-meta {
	display: flex;
	flex-direction: row;
