	display: flex;
	flex-direction: row;
	align-items: center;
}

.avatar {
	width: 120rpx;
	height: 120rpx;
	border-radius: 60rpx;
	overflow: hidden;
	border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-image {
	width: 100%;
	height: 100%;
}

.info {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	flex: 1;
	margin-left: 24rpx;
	align-items: stretch;
}

.nickname {
	font-size: 36rpx;
	font-weight: bold;
	color: #ffffff;
	margin-bottom: 8rpx;
}

.follow {
	font-size: 26rpx;
	color: rgba(255, 255, 255, 0.8);
}

.not-login {
	font-size: 32rpx;
	color: #ffffff;
}

.demo-entry {
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: #ffffff;
	margin: 20rpx;
	padding: 30rpx;
	border-radius: 16rpx;
}

.demo-text {
	flex: 1;
	font-size: 32rpx;
	color: #333333;
	margin-left: 20rpx;
}

.service {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	background-color: #ffffff;
	margin: 20rpx;
	border-radius: 16rpx;
	padding: 20rpx 0;
}

.service_item {
	width: 25%;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 20rpx 0;
}

.service-icon {
	width: 80rpx;
	height: 80rpx;
	margin-bottom: 12rpx;
}

.service-text {
	font-size: 26rpx;
	color: #333333;
}
</style>