	background-color: #c43b40;
	display: flex;
	flex-direction: column;
	padding: 0 24rpx 18rpx;
}

.header-status-spacer {
	width: 100%;
}

.header-bar {
	height: 84rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
}

.header-title {
	font-size: 36rpx;
	font-weight: 700;
	color: #fff4ef;
	letter-spacing: 2rpx;
}

