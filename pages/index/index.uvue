	width: 1rpx;
	height: 24rpx;
	background-color: rgba(255, 255, 255, 0.55);
}

.capsule-circle-wrap {
	width: 58rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.capsule-circle {
	width: 18rpx;
	height: 18rpx;
	border-radius: 999rpx;
	border-width: 4rpx;
	border-style: solid;
	border-color: #111111;
	background-color: #c43b40;
}

.hero-wrap {
	background-color: #f1ede4;
}

.hero-swiper {
	height: 420rpx;
}

.hero-swiper-image {
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
}

.notice-wrap {
	margin: 0 0 14rpx;
	background-color: #fff5dc;
}

.notice-inner {
	height: 72rpx;
	padding: 0 24rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: #fff5dc;
}

.notice-icon-wrap {
	width: 32rpx;
	height: 32rpx;
	margin-right: 14rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.notice-icon-dot {
	width: 10rpx;
	height: 10rpx;
	border-radius: 999rpx;
	background-color: #d4583e;
}

.notice-icon-line {
	width: 18rpx;
	height: 4rpx;
	border-radius: 999rpx;
	background-color: #d4583e;
	margin-top: 4rpx;
}

.notice-swiper {
	flex: 1;
	height: 44rpx;
}

.notice-swiper-item {
	height: 44rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.notice-text {
	font-size: 26rpx;
	color: #9a6a22;
	line-height: 1.4;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.page-content {
	display: flex;
	flex-direction: column;
	padding: 0 24rpx;
}

.section-wrap {
	display: flex;
	flex-direction: column;
	margin-top: 24rpx;
}

.section-wrap-last {
	padding-bottom: 20rpx;
}

.section-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-top: 4rpx;
