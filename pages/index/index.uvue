	position: absolute;
	right: 0;
	top: 10rpx;
	width: 142rpx;
	height: 50rpx;
	border-radius: 999rpx;
	border-width: 1rpx;
	border-style: solid;
	border-color: rgba(255, 255, 255, 0.8);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background-color: rgba(255, 255, 255, 0.08);
}

.capsule-dots-wrap {
	width: 58rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.capsule-dot {
	width: 6rpx;
	height: 6rpx;
	border-radius: 999rpx;
	background-color: #ffffff;
}

