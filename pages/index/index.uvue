<template>
	<scroll-view
		class="page-scroll"
		style="flex: 1; height: 100vh;"
		scroll-y="true"
		:lower-threshold="120"
		@scrolltolower="handleReachBottom"
	>
		<view class="page-shell">
			<view class="hero-wrap">
				<swiper
					class="hero-swiper"
					:indicator-dots="bannerIndicatorDots"
					:autoplay="bannerAutoplay"
					:circular="bannerCircular"
					:interval="bannerInterval"
					:duration="bannerDuration"
					indicator-color="rgba(255,255,255,0.36)"
					indicator-active-color="#ffffff"
				>
					<swiper-item v-for="(item, index) in bannerList" :key="index">
						<image class="hero-swiper-image" :src="item.imageUrl" mode="aspectFill"></image>
					</swiper-item>
				</swiper>
			</view>

			<view class="notice-wrap" v-if="noticeTextList.length > 0">
				<view class="notice-inner">
					<view class="notice-icon-wrap">
						<view class="notice-icon-dot"></view>
						<view class="notice-icon-line"></view>
					</view>
					<swiper
						class="notice-swiper"
						vertical="true"
						:autoplay="noticeAutoplay"
						:circular="noticeCircular"
						:interval="noticeInterval"
						:duration="noticeDuration"
						:disable-touch="noticeDisableTouch"
					>
						<swiper-item v-for="(item, index) in noticeTextList" :key="index">
							<view class="notice-swiper-item">
								<text class="notice-text">{{ item }}</text>
							</view>
						</swiper-item>
					</swiper>
				</view>
			</view>

			<view class="page-content">
				<view class="section-wrap">
					<view class="section-head">
						<view class="section-title">最新托管</view>
						<view class="section-more" @tap="openSectionMore('hosted')">
							<text class="section-more-text">查看更多</text>
							<text class="section-more-arrow">›</text>
						</view>
					</view>
					<view class="recommend-grid">
						<view
							v-for="(item, index) in latestHostedList"
							:key="item.id + '-' + index"
							:class="index < latestHostedList.length - 1 ? 'recommend-card recommend-card-space' : 'recommend-card'"
							@tap="jumpTo(item.routeUrl)"
						>
							<image class="recommend-image" :src="item.imageUrl" mode="aspectFill"></image>
							<view class="recommend-name">{{ item.title }}</view>
						</view>
					</view>
				</view>

				<view class="section-wrap" v-if="latestProductList.length > 0">
					<view class="section-head">
						<view class="section-title">藏品热卖</view>
						<view class="section-more" @tap="openSectionMore('product')">
							<text class="section-more-text">查看更多</text>
							<text class="section-more-arrow">›</text>
						</view>
					</view>
					<view class="product-grid">
						<view
							v-for="(item, index) in latestProductList"
							:key="item.id + '-' + index"
							:class="index < latestProductList.length - 1 ? 'product-card product-card-space' : 'product-card'"
							@tap="jumpTo(item.routeUrl)"
						>
							<image class="product-image" :src="item.imageUrl" mode="aspectFill"></image>
							<view class="product-name">{{ item.title }}</view>
							<view class="recommend-meta">
								<text class="meta-item" v-if="item.valueStr">价值 <text class="meta-num">{{ item.valueStr }}</text></text>
								<text class="meta-item" v-if="item.priceStr">售价 <text class="meta-num">{{ item.priceStr }}</text></text>
							</view>
						</view>
					</view>
				</view>

				<view class="museum-wrap" v-if="showImage">
					<image class="museum-image" :src="museumData" mode="aspectFill"></image>
				</view>

				<view class="section-wrap" v-if="partnerList.length > 0">
					<view class="section-head">
						<view class="section-title">合作机构</view>
						<view class="section-more" @tap="openSectionMore('partner')">
							<text class="section-more-text">查看更多</text>
							<text class="section-more-arrow">›</text>
						</view>
					</view>
					<view class="partner-grid">
						<view v-for="(item, index) in partnerList" :key="item.id" :class="index < partnerList.length - 1 ? 'partner-card partner-card-space' : 'partner-card'">
							<view class="partner-logo-box">
								<image class="partner-logo" :src="item.imageUrl" mode="aspectFit"></image>
							</view>
							<view class="partner-name">{{ item.name }}</view>
						</view>
					</view>
				</view>

				<view class="section-wrap section-wrap-last">
					<view class="section-head">
						<view class="feed-tabs">
							<view
								v-for="(item, index) in feedTabs"
								:key="item.key"
								:class="contentTab == index ? (index < feedTabs.length - 1 ? 'feed-tab feed-tab-gap feed-tab-active' : 'feed-tab feed-tab-active') : (index < feedTabs.length - 1 ? 'feed-tab feed-tab-gap' : 'feed-tab')"
								@tap="switchContentTab(index)"
							>
								<view class="feed-tab-text">{{ item.label }}</view>
								<view :class="contentTab == index ? 'feed-tab-line feed-tab-line-active' : 'feed-tab-line'"></view>
							</view>
						</view>
						<view class="section-more" @tap="openSectionMore('feed')">
							<text class="section-more-text">查看更多</text>
							<text class="section-more-arrow">›</text>
						</view>
					</view>

					<view class="feed-list">
						<view v-if="currentFeedList.length == 0" class="feed-empty">暂无内容</view>
						<view
							v-for="(item, index) in currentFeedList"
							:key="item.id"
							:class="index < currentFeedList.length - 1 ? 'feed-card feed-card-space' : 'feed-card'"
							@tap="jumpTo(item.routeUrl)"
						>
							<image class="feed-image" :src="item.imageUrl" mode="aspectFill"></image>
							<view class="feed-body">
								<!-- <view class="feed-tag">{{ item.tag }}</view> -->
								<view class="feed-title">{{ item.title }}</view>
								<view class="feed-subtitle">{{ item.subtitle }}</view>
								<view class="feed-meta">{{ item.meta }}</view>
							</view>
						</view>
						<view class="feed-loading" v-if="articleLoading">正在加载更多...</view>
						<view class="feed-loading" v-if="articleNoMoreData && articleListData.length > 0">没有更多数据了</view>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { jumpTo } from '@/common/utils/ut'
	import { articleList, collectionList, productListPage, selectByAdvertisingCode } from '@/common/api/mallApi'

	type HomeCard = {
		id: string
		title: string
		imageUrl: string
		routeUrl: string
	}

	type PartnerCard = {
		id: string
		name: string
		imageUrl: string
	}

	type FeedTab = {
		key: string
		label: string
		cateId?: string
	}

	type FeedItem = {
		id: string
		tag: string
		title: string
		subtitle: string
		meta: string
		imageUrl: string
		routeUrl: string
	}

	const adData = ref<any[]>([])
	const cooperationList = ref<any[]>([])
	const hostedList = ref<any[]>([])
	const saleProductList = ref<any[]>([])
	const articleListData = ref<any[]>([])
	const noticeList = ref<any[]>([])
	const museumData = ref('')
	const showImage = ref(true)
	const imageUrl = 'https://ssca-1364461867.cos.ap-beijing.myqcloud.com/mms/upload/68f72f91cad408e14b73d40b.png'
	const cateId = ref('1951174930320920577')
	const title = ref('公司动态')
	const articlePageNum = ref(1)
	const articlePageSize = 5
	const articleTotal = ref(0)
	const articleLoading = ref(false)
	const articleNoMoreData = ref(false)
	const contentTab = ref(0)
	const statusBarHeight = uni.getWindowInfo().statusBarHeight
	const scrollBounces = false
	const showScrollbar = false
	const bannerIndicatorDots = true
	const bannerAutoplay = true
	const bannerCircular = true
	const bannerInterval = 3200
	const bannerDuration = 500
	const noticeCircular = true
	const noticeDisableTouch = true
	const noticeInterval = 2800
	const noticeDuration = 400
	const feedTabs: FeedTab[] = [
		{ key: 'news1', label: '公司动态', cateId: '1951174930320920577' },
		{ key: 'news2', label: '入库公告', cateId: '1951174473330528258' },
		{ key: 'news3', label: '行业动态', cateId: '1951175029075808257' },
	]

	const bannerList = computed(() => {
		return adData.value.length > 0 ? adData.value : [{ imageUrl }]
	})

	const noticeTextList = computed(() => {
		const rows = noticeList.value.map((item: any) => item.articleTitle != null ? item.articleTitle : '')
		return rows.length > 0 ? rows : ['暂无公告']
	})

	const noticeAutoplay = computed((): boolean => {
		return noticeTextList.value.length > 1
	})

	/** 最新托管 - 来自 collectionList，仅托管藏品 */
	const latestHostedList = computed((): HomeCard[] => {
		const cards: HomeCard[] = []
		hostedList.value.forEach((item: any, idx: number) => {
			if (cards.length < 6) {
				cards.push({
					id: String(item.id != null ? item.id : idx),
					title: item.tgTitle != null ? item.tgTitle : '藏品名称',
					imageUrl: item.tgMainImage != null && item.tgMainImage != '' ? item.tgMainImage : imageUrl,
					routeUrl: `/pages_Hosting/case_details/case_details?id=${item.id}`,
				})
			}
		})
		return cards
	})

	type ProductCard = HomeCard & { valueStr?: string; priceStr?: string }

	/** 藏品热卖 - 来自 productListPage，含藏品价值、出售价格 */
	const latestProductList = computed((): ProductCard[] => {
		const cards: ProductCard[] = []
		saleProductList.value.forEach((item: any, idx: number) => {
			if (cards.length < 6) {
				const targetId = item.collectionId != null ? item.collectionId : item.id
				const appraisalVal = item.tgAppraisalValue != null ? item.tgAppraisalValue : (item.appraisalValue != null ? item.appraisalValue : null)
				const valueStr = appraisalVal != null ? formatWan(appraisalVal) : ''
				const marketPriceVal = item.marketPrice != null ? item.marketPrice : (item.price != null ? item.price : null)
				const priceStr = marketPriceVal != null ? formatWan(marketPriceVal) : ''
				cards.push({
					id: String(targetId != null ? targetId : idx),
					title: item.title != null ? item.title : '藏品名称',
					imageUrl: item.mainImage != null && item.mainImage != '' ? item.mainImage : (item.imageUrl != null && item.imageUrl != '' ? item.imageUrl : imageUrl),
					routeUrl: `/pages_Hosting/product_details/product_details?id=${targetId}`,
					valueStr: valueStr != '' ? valueStr : undefined,
					priceStr: priceStr != '' ? priceStr : undefined,
				})
			}
		})
		return cards
	})

	const partnerList = computed((): PartnerCard[] => {
		let cards: PartnerCard[] = []
		cooperationList.value.forEach((item: any) => {
			cards.push({
				id: String(item.id != null ? item.id : cards.length),
				name: item.extendedParameterOne != null && item.extendedParameterOne != '' ? item.extendedParameterOne : '合作机构',
				imageUrl: item.imageUrl != null && item.imageUrl != '' ? item.imageUrl : imageUrl,
			})
		})
		return cards
	})

	const newsFeedList = computed((): FeedItem[] => {
		let rows: FeedItem[] = []
		articleListData.value.forEach((item: any) => {
			rows.push({
				id: String(item.id != null ? item.id : rows.length),
				tag: title.value,
				title: item.articleTitle != null ? item.articleTitle : '新闻公告',
				subtitle: item.articleSummary != null && item.articleSummary != '' ? item.articleSummary : '点击查看详情',
				meta: item.createdTime != null ? item.createdTime : '近期更新',
				imageUrl: item.articleLitpic != null && item.articleLitpic != '' ? item.articleLitpic : imageUrl,
				routeUrl: `/pages_Article/articleDetails/articleDetails?id=${item.id}`,
			})
		})
		return rows
	})

	const currentFeedList = computed((): FeedItem[] => {
		return newsFeedList.value
	})

	function formatWan(val: number | string): string {
		const n = typeof val === 'number' ? val : parseFloat(String(val))
		if (isNaN(n)) return ''
		return (n / 10000).toFixed(1) + '万'
	}

	function navTo(url: string) {
		uni.switchTab({ url })
	}

	function switchContentTab(index: number) {
		contentTab.value = index
		if (index >= 0 && index < feedTabs.length) {
			const tab = feedTabs[index]
			if (tab.cateId != null && tab.cateId != '') {
				cateId.value = tab.cateId
				title.value = tab.label
				articlePageNum.value = 1
				articleNoMoreData.value = false
				getArticleList()
			}
		}
	}

	function openSectionMore(section: string) {
		if (section == 'hosted' || section == 'recommend') {
			uni.setStorageSync('mms_cases_default_tab', 'randomly')
			navTo('/pages/cases/cases')
			return
		}
		if (section == 'product') {
			uni.setStorageSync('mms_cases_default_tab', 'transaction')
			navTo('/pages/cases/cases')
			return
		}
		if (section == 'partner') {
			jumpTo('/pages_Hosting/cooperate_institution/cooperate_institution')
			return
		}
		jumpTo(`/pages_Article/articleList/articleList?cateId=${cateId.value}&title=${title.value}`)
	}

	function selectByAdvertisingHttp() {
		selectByAdvertisingCode({ advertisingCode: 'APPLE_INDEX', size: 5 }).then(res => {
			if (res.code == 200) adData.value = res.data
		})
		selectByAdvertisingCode({ advertisingCode: 'APPLE_MUSEUM', size: 5 }).then(res => {
			const dataList = res.data as any[]
			if (dataList != null && dataList.length > 0) museumData.value = dataList[0].imageUrl
			else showImage.value = false
		})
		selectByAdvertisingCode({ advertisingCode: 'APPLE_COOPERATE', size: 10 }).then(res => {
			if (res.code == 200) cooperationList.value = res.data
		})
	}

	function getHostedList() {
		collectionList({ pageSize: 10, pageNum: 1, selectType: 'randomly', hasProduct: 0 }).then(res => {
			if (res.code == 200 && res.data != null) {
				const data = res.data as UTSJSONObject
				if (data['rows'] != null) hostedList.value = data['rows'] as any[]
			}
		}).catch(() => {
			collectionList({ pageSize: 10, pageNum: 1, selectType: 'randomly' }).then(res => {
				if (res.code == 200 && res.data != null) {
					const data = res.data as UTSJSONObject
					if (data['rows'] != null) hostedList.value = data['rows'] as any[]
				}
			})
		})
	}

	function getSaleProductList() {
		productListPage({ pageSize: 10, pageNum: 1 }).then(res => {
			if (res.code == 200 && res.data != null) {
				const data = res.data as UTSJSONObject
				if (data['rows'] != null) saleProductList.value = data['rows'] as any[]
			} else if ((res as any).rows != null) {
				saleProductList.value = (res as any).rows
			}
		}).catch(() => {
			saleProductList.value = []
		})
	}

	function getNoticeList() {
		articleList({ pageSize: 5, pageNum: 1, cateId: '1951174473330528258' }).then(res => {
			if (res.code == 200 && res.data != null) {
				const data = res.data as UTSJSONObject
				noticeList.value = data['rows'] != null ? (data['rows'] as any[]) : []
			}
		}).catch(() => {})
	}

	function getArticleList() {
		if (articleLoading.value || articleNoMoreData.value) return
		articleLoading.value = true
		articleList({
			pageSize: articlePageSize,
			pageNum: articlePageNum.value,
			cateId: cateId.value,
		}).then(res => {
			if (res.code == 200) {
				const data = res.data as UTSJSONObject
				const rows = data['rows'] as any[] | null
				if (rows != null) {
					if (articlePageNum.value === 1) articleListData.value = rows
					else articleListData.value = articleListData.value.concat(rows)
					articleTotal.value = data['total'] != null ? (data['total'] as number) : 0
					if (articleListData.value.length >= articleTotal.value) articleNoMoreData.value = true
				} else {
					articleNoMoreData.value = true
				}
			}
		}).catch(() => {
		}).finally(() => {
			articleLoading.value = false
		})
	}

	function handleReachBottom() {
		if (!articleLoading.value && !articleNoMoreData.value) {
			articlePageNum.value = articlePageNum.value + 1
			getArticleList()
		}
	}

	onLoad(() => {
		selectByAdvertisingHttp()
		getHostedList()
		getSaleProductList()
		getArticleList()
		getNoticeList()
	})

	onReachBottom(() => {
		handleReachBottom()
	})
</script>

<style lang="scss" scoped>
