<template>
	<view class="page-root">
	<scroll-view class="page-scroll" scroll-y :style="scrollViewStyle">
		<view class="demo-container">
		<view class="demo-header">
			<image class="demo-logo" src="/static/logo.png" mode="aspectFit"></image>
			<text class="demo-title">mUnix 组件演示</text>
			<text class="demo-desc">按分类浏览，点击进入示例页</text>
		</view>

		<view class="demo-section" v-for="(cat, cidx) in componentCategories" :key="cidx">
			<text class="section-title" :style="'border-left-color:' + cat.color">{{ cat.title }}</text>
			<view class="demo-grid">
				<view class="demo-item" v-for="(item, index) in cat.items" :key="index" @tap="navigateTo(item.path)">
					<m-icon :name="item.icon" size="48rpx" :color="cat.color"></m-icon>
					<text class="item-name">{{ item.name }}</text>
				</view>
			</view>
		</view>
		<!-- 尾部占位：保证「业务」等最后一组能滚到 TabBar 之上（各端 Tab 高度差异大） -->
		<view class="tabbar-spacer"></view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	type ComponentItem = {
		name: string
		path: string
		icon: string
	}

	type ComponentCategory = {
		title: string
		color: string
		items: ComponentItem[]
	}

	const scrollViewStyle = ref('')

	function applyScrollHeight() {
		const w = uni.getWindowInfo()
		let winH = w.windowHeight as number
		if (winH == null || winH <= 0) {
			winH = 600
		}
		let safeBottom = 0
		const insets = w.safeAreaInsets
		if (insets != null) {
			const b = insets.bottom
			if (b != null && b > 0) {
				safeBottom = b
			}
		}
		// TabBar 高度按 rpx 转 px（120rpx 约等于栏高+余量），避免算小导致内容压在菜单下
		let tabBarPx = 88
		const u = uni.rpx2px(120)
		if (u != null && u > 0) {
			tabBarPx = u
		}
		const h = Math.max(120, winH - tabBarPx - safeBottom)
		scrollViewStyle.value = 'height:' + h + 'px'
	}

	onLoad(() => {
		applyScrollHeight()
	})

	onReady(() => {
		applyScrollHeight()
	})

	onShow(() => {
		applyScrollHeight()
	})

	/**
	 * 分类与 uni_modules/m-unix 组件能力对齐（列表仅展示中文名；增删演示页时同步改此表与 pages.json）：
	 * 1 基础组件（含过渡动画样式演示） 2 表单与输入 3 反馈与提示 4 数据展示
	 * 5 导航与布局 6 分页与通告 7 列表与内容 8 浮层与交互 9 业务示例
	 */
	const componentCategories: ComponentCategory[] = [
		{
			title: '基础组件',
			color: '#ff0844',
			items: [
				{ name: '过渡动画', path: '/pages_demo/animate/animate', icon: 'dynamic-filling' },
				{ name: '按钮', path: '/pages_demo/button/button', icon: 'add-circle' },
				{ name: '单元格', path: '/pages_demo/cell/cell', icon: 'browse' },
				{ name: '图标', path: '/pages_demo/icon/icon', icon: 'picture-filling' },
				{ name: '标签', path: '/pages_demo/tag/tag', icon: 'tag' },
				{ name: '卡片', path: '/pages_demo/card/card', icon: 'picture' },
			],
		},
		{
			title: '表单与输入',
			color: '#1890ff',
			items: [
				{ name: '搜索', path: '/pages_demo/search/search', icon: 'search' },
				{ name: '表单', path: '/pages_demo/form/form', icon: 'survey' },
				{ name: '输入框', path: '/pages_demo/form/input', icon: 'edit' },
				{ name: '多行输入', path: '/pages_demo/textarea/textarea', icon: 'text' },
				{ name: '单选框', path: '/pages_demo/radio/radio', icon: 'check-item-filling' },
				{ name: '多选框', path: '/pages_demo/checkbox/checkbox', icon: 'check' },
				{ name: '开关', path: '/pages_demo/switch/switch', icon: 'switch-filling' },
				{ name: '上传', path: '/pages_demo/upload/upload', icon: 'upload' },
				{ name: '下拉列表', path: '/pages_demo/ext/dropdown/dropdown', icon: 'arrow-down' },
				{ name: '步进器', path: '/pages_demo/ext/number-box/number-box', icon: 'adjust' },
				{ name: '评分', path: '/pages_demo/ext/rate/rate', icon: 'star' },
				{ name: '级联选择', path: '/pages_demo/ext/cascade/cascade', icon: 'location' },
				{ name: '联动选择器', path: '/pages_demo/ext/picker/picker', icon: 'calendar' },
				{ name: '日期时间', path: '/pages_demo/ext/datetime-picker/datetime-picker', icon: 'time' },
				{ name: '气泡菜单', path: '/pages_demo/ext/bubble-popup/bubble-popup', icon: 'comment-filling' },
				{ name: '验证码输入', path: '/pages_demo/ext/code-input/code-input', icon: 'lock' },
				{ name: '图形验证码', path: '/pages_demo/ext/vcode/vcode', icon: 'security' },
				{ name: '金额大写', path: '/pages_demo/ext/amount-inwords/amount-inwords', icon: 'wallet' },
			],
		},
		{
			title: '反馈与提示',
			color: '#52c41a',
			items: [
				{ name: '对话框', path: '/pages_demo/dialog/dialog', icon: 'help' },
				{ name: '弹出层', path: '/pages_demo/popup/popup', icon: 'arrow-up-filling' },
				{ name: '轻提示', path: '/pages_demo/toast/toast', icon: 'notification' },
				{ name: '加载中', path: '/pages_demo/loading/loading', icon: 'loading' },
				{ name: '提示条', path: '/pages_demo/ext/tips/tips', icon: 'prompt-filling' },
			],
		},
		{
			title: '数据展示',
			color: '#722ed1',
			items: [
				{ name: '空状态', path: '/pages_demo/empty/empty', icon: 'folder-close' },
				{ name: '价格', path: '/pages_demo/price/price', icon: 'wallet' },
				{ name: '倒计时', path: '/pages_demo/countdown/countdown', icon: 'time' },
				{ name: '验证码倒计时', path: '/pages_demo/smsCountdown/smsCountdown', icon: 'time' },
				{ name: '宫格', path: '/pages_demo/grid/grid', icon: 'layers' },
				{ name: '轮播图', path: '/pages_demo/ext/swiper/swiper', icon: 'picture' },
				{ name: '二维码', path: '/pages_demo/qrcode/qrcode', icon: 'scanning' },
				{ name: '水印', path: '/pages_demo/watermark/watermark', icon: 'lock' },
				{ name: '加载更多', path: '/pages_demo/ext/loadmore/loadmore', icon: 'arrow-double-right' },
			],
		},
		{
			title: '导航与布局',
			color: '#13c2c2',
			items: [
				{ name: '吸顶', path: '/pages_demo/ext/sticky/sticky', icon: 'layout-filling' },
				{ name: '底部导航', path: '/pages_demo/ext/bottom-nav/bottom-nav', icon: 'apps' },
				{ name: '标签页', path: '/pages_demo/ext/tabs/tabs', icon: 'sorting' },
				{ name: '布局辅助', path: '/pages_demo/ext/layout-helpers/layout-helpers', icon: 'column-horizontal' },
				{ name: '底部固定栏', path: '/pages_demo/ext/sticky-bottom/sticky-bottom', icon: 'arrow-down-filling' },
			],
		},
		{
			title: '分页与通告',
			color: '#fa541c',
			items: [
				{ name: '分页器', path: '/pages_demo/ext/pagination/pagination', icon: 'arrow-double-right' },
				{ name: '分段器', path: '/pages_demo/ext/segmented-control/segmented-control', icon: 'category' },
				{ name: '通告栏', path: '/pages_demo/ext/notice-bar/notice-bar', icon: 'notification-filling' },
				{ name: '纵向通告', path: '/pages_demo/ext/notice-vertical/notice-vertical', icon: 'listview' },
				{ name: '滚动资讯', path: '/pages_demo/ext/rolling-news/rolling-news', icon: 'news-filling' },
			],
		},
		{
			title: '列表与内容',
			color: '#eb2f96',
			items: [
				{ name: '时间轴', path: '/pages_demo/ext/time-axis/time-axis', icon: 'time' },
				{ name: '折叠面板', path: '/pages_demo/ext/collapse/collapse', icon: 'minus-circle' },
				{ name: '骨架屏', path: '/pages_demo/ext/skeleton/skeleton', icon: 'loading' },
				{ name: '步骤条', path: '/pages_demo/ext/steps/steps', icon: 'task' },
				{ name: '滑动操作', path: '/pages_demo/ext/swipe-action/swipe-action', icon: 'move' },
				{ name: '区块标题', path: '/pages_demo/ext/section/section', icon: 'comment' },
				{ name: '留白', path: '/pages_demo/ext/wing-blank/wing-blank', icon: 'column-horizontal' },
				{ name: '富文本', path: '/pages_demo/ext/richtext/richtext', icon: 'edit-filling' },
				{ name: '文本', path: '/pages_demo/ext/text/text', icon: 'text' },
				{ name: '链接', path: '/pages_demo/ext/link/link', icon: 'link' },
				{ name: '弧形横幅', path: '/pages_demo/ext/banner-arc/banner-arc', icon: 'top-filling' },
				{ name: '图片裁剪', path: '/pages_demo/ext/cropper/cropper', icon: 'picture' },
				{ name: '树形', path: '/pages_demo/ext/tree/tree', icon: 'folder' },
			],
		},
		{
			title: '浮层与交互',
			color: '#faad14',
			items: [
				{ name: '数字键盘', path: '/pages_demo/ext/keyboard/keyboard', icon: 'telephone' },
				{ name: '操作菜单', path: '/pages_demo/ext/action-sheet/action-sheet', icon: 'menu' },
				{ name: '提醒弹框', path: '/pages_demo/ext/alert/alert', icon: 'prompt-filling' },
				{ name: '剪贴板', path: '/pages_demo/ext/clipboard/clipboard', icon: 'select' },
				{ name: '悬浮按钮', path: '/pages_demo/ext/fab/fab', icon: 'add-bold' },
				{ name: '区域截图', path: '/pages_demo/ext/screenshot/screenshot', icon: 'scanning' },
			],
		},
		{
			title: '业务示例',
			color: '#fa8c16',
			items: [
				{ name: '登录', path: '/pages_demo/login/login', icon: 'user' },
				{ name: '应用更新', path: '/pages_demo/ext/app-update/app-update', icon: 'download' },
				{ name: '微信登录', path: '/pages_demo/ext/wx-login/wx-login', icon: 'comment-filling' },
			],
		},
	]

	function navigateTo(url: string) {
		if (url == null || url === '') {
			return
		}
		uni.navigateTo({
			url: url,
			fail: (err: any) => {
				let msg = '页面打开失败'
				if (err != null) {
					const em = err['errMsg']
					if (em != null && ('' + em).length > 0) {
						msg = '' + em
					}
				}
				uni.showToast({ title: msg, icon: 'none', duration: 2500 })
			}
		})
	}
</script>

<style lang="scss">
	.page-root {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 100%;
	}

	.page-scroll {
		flex: 1;
		width: 100%;
	}

	.demo-container {
		background-color: #f5f5f5;
		padding: 20rpx;
		padding-bottom: 32rpx;
	}

	/* 与 TabBar、Home Indicator 之间的硬留白（可滚动区域内） */
	.tabbar-spacer {
		width: 100%;
		height: 280rpx;
		flex-shrink: 0;
	}

	.demo-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		background-color: #ff0844;
		border-radius: 16rpx;
		padding: 36rpx 30rpx 40rpx;
		margin-bottom: 30rpx;
	}

	.demo-logo {
		width: 128rpx;
		height: 128rpx;
		margin-bottom: 20rpx;
		flex-shrink: 0;
	}

	.demo-title {
		font-size: 44rpx;
		font-weight: bold;
		color: #ffffff;
		margin-bottom: 12rpx;
		text-align: center;
	}

	.demo-desc {
		font-size: 28rpx;
		color: rgba(255, 255, 255, 0.8);
		text-align: center;
		line-height: 1.5;
	}

	.demo-section {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 30rpx;
		margin-bottom: 24rpx;
	}

	.section-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #333333;
		margin-bottom: 24rpx;
		padding-left: 16rpx;
		border-left-width: 6rpx;
		border-left-style: solid;
		border-left-color: #ff0844;
	}

	.demo-grid {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.demo-item {
		width: 25%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 24rpx 0;
	}

	.item-name {
