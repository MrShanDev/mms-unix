<template>
	<view class="page">
		<view class="header">
			<text class="title">页面模版</text>
			<text class="sub">业务场景示例，可在此基础上改造</text>
		</view>

		<view class="list">
			<view v-for="(item, index) in items" :key="index" :class="rowClass(index)" @tap="go(item.path)">
				<view class="item-main">
					<text class="item-title">{{ item.title }}</text>
					<text class="item-desc">{{ item.desc }}</text>
				</view>
				<mms-icon name="arrow-right" size="32rpx" color="#cccccc"></mms-icon>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	type TemplateItem = {
		title: string
		desc: string
		path: string
	}

	const items: TemplateItem[] = [
		{ title: '文章列表', desc: '列表与导航到详情', path: '/pages_Article/articleList/articleList' },
		{ title: '登录', desc: '账号 / 验证码登录', path: '/pages_Me/login/login' },
		{ title: '注册', desc: '新用户注册', path: '/pages_Me/register' },
		{ title: '关于我们', desc: '静态介绍页', path: '/pages_Me/about_me/about_me' },
	]

	function rowClass(index: number): string {
		const last = items.length - 1
		if (index < last) {
			return 'item item-line'
		}
		return 'item'
	}

	function go(url: string) {
		uni.navigateTo({ url })
	}
</script>

<style lang="scss">
	.page {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		background-color: #f5f5f5;
		padding: 24rpx;
		padding-bottom: 200rpx;
	}

	.header {
		background-color: #ff2727;
		border-radius: 16rpx;
		padding: 36rpx 28rpx;
		margin-bottom: 24rpx;
	}

	.title {
		font-size: 40rpx;
		font-weight: bold;
		color: #ffffff;
		margin-bottom: 8rpx;
	}

	.sub {
		font-size: 26rpx;
		color: rgba(255, 255, 255, 0.88);
	}

	.list {
		background-color: #ffffff;
		border-radius: 16rpx;
		overflow: hidden;
	}

	.item {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 28rpx 24rpx;
	}

	.item-line {
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f0f0f0;
	}

	.item-main {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.item-title {
		font-size: 30rpx;
		color: #333333;
		font-weight: 500;
		margin-bottom: 8rpx;
	}

	.item-desc {
		font-size: 24rpx;
		color: #999999;
	}
</style>
