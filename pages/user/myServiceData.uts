/**
 * 「我的」页菜单：个人介绍、开源与演示、联系与业务等（路径须与 pages.json 一致）
 * requireLogin: true 时需登录后进入
 */
export type UserServiceItem = {
	/** mms-icon 图标名，与 mms-cell 的 icon 一致 */
	iconName: string
	title: string
	pages: string
	requireLogin: boolean
}

export function getUserServiceItems(): UserServiceItem[] {
	return [
		{ iconName: 'user-filling', title: '介绍自己', pages: '/pages_Me/user_info/index', requireLogin: true },
		{ iconName: 'share', title: '开源项目', pages: '/pages_Me/about_me/about_me', requireLogin: false },
		{ iconName: 'layout-filling', title: '组件演示', pages: '/pages_demo/index', requireLogin: false },
		{ iconName: 'telephone', title: '联系我们', pages: '/pages_Me/contact/contact', requireLogin: false },
		{ iconName: 'browse', title: '案例展示', pages: '/pages_Article/articleList/articleList', requireLogin: false },
		{ iconName: 'work-filling', title: '公司业务', pages: '/pages/templates/templates', requireLogin: false },
		{ iconName: 'task-filling', title: '系统开发承接', pages: '/pages/tools/tools', requireLogin: false },
	]
}
