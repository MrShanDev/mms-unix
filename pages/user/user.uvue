<template>
	<view class="container">
		<scroll-view class="page-scroll" scroll-y :show-scrollbar="false">
			<view class="page-inner">
				<view class="header-banner">
					<m-banner-arc
						arc-variant="bottom-concave"
						height="260"
						:percent="130"
						background="linear-gradient(180deg, #ff6b88 0%, #ff0844 100%)"
						arc-color="#f5f5f5"
						:arc-height="96"
					></m-banner-arc>
					<view class="profile-wrap">
						<m-card :shadow="true" :border="false">
							<view class="profile-row" @tap.stop="onProfileTap">
								<view class="avatar">
									<image class="avatar-image" :src="userInfo.headPortrait || defaultFace" mode="aspectFill"></image>
								</view>
								<view class="profile-text">
									<text v-if="hasLogin" class="profile-name">{{ userInfo.nickname || '暂无昵称' }}</text>
									<text v-if="hasLogin" class="profile-sub">{{ profilePhone }}</text>
									<text v-else class="profile-name profile-name--muted">点击登录 / 完善资料</text>
								</view>
								<m-icon name="arrow-right" size="32rpx" color="#c0c4cc"></m-icon>
							</view>
						</m-card>
					</view>
				</view>
				<m-cell-group v-if="menuConfig.style === 'list'" :title="menuConfig.title" class="menu-group">
					<m-cell
						v-for="(item, index) in serviceBar"
						:key="index"
						:title="item.title"
						:icon="item.iconName"
						:isLink="true"
						:border="index < serviceBar.length - 1"
						@click="onServiceTap(item)"
					></m-cell>
				</m-cell-group>
				<view v-else class="menu-grid-wrap menu-group">
					<text class="menu-grid-title">{{ menuConfig.title }}</text>
					<m-grid :column="menuConfig.gridColumns" :border="true">
						<m-grid-item
							v-for="(item, index) in serviceBar"
							:key="index"
							:icon="item.iconName"
							:text="item.title"
							iconColor="#ff0844"
							iconSize="48rpx"
							@click="onServiceTap(item)"
						></m-grid-item>
					</m-grid>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { getMUiConfig } from '@/uni_modules/m-unix/config.uts'
	import { jumpTo } from '@/uni_modules/m-unix/components/m-tools/Ut.uts'
	import { storage } from '@/uni_modules/m-unix/components/m-tools/Storage.uts'
	import { tokenLogin } from '@/common/api/mallApi'
	import { getUserServiceItems, getUserServiceMenuConfig } from './myServiceData'
	import type { UserServiceItem } from './myServiceData'

	const defaultFace = computed((): string => getMUiConfig().avatarDefault)
	const serviceBar = computed(() => getUserServiceItems())
	const menuConfig = computed(() => getUserServiceMenuConfig())
	const hasLogin = ref(storage.getToken() != '' || storage.getUserInfo() != null)
	const userInfo = ref(storage.getUserInfo() ?? {} as UTSJSONObject)

	const profilePhone = computed((): string => {
		const p = userInfo.value['phone']
		if (p == null || p === '') {
			return ''
		}
		return `${p}`
	})

	function checkLoginAndNav(url: string, requireLogin: boolean = false) {
		if (!hasLogin.value) {
			if (requireLogin) {
				setTimeout(() => {
					uni.showModal({
						title: '提示',
						content: '未登录，是否立即登录？',
						showCancel: true,
						cancelText: '取消',
						confirmText: '去登录',
						success: (res) => {
							if (res.confirm) {
								jumpTo('/pages_Me/login/login', 'to')
							}
						},
					})
				}, 50)
			} else {
				jumpTo(url)
			}
		} else {
			jumpTo(url)
		}
	}

	function onProfileTap() {
		checkLoginAndNav('/pages_Me/user_info/index', true)
	}

	function onServiceTap(item: UserServiceItem) {
		const cfg = menuConfig.value
		const needLogin = cfg.loginGuard === true && item.requireLogin === true
		checkLoginAndNav(item.pages, needLogin)
	}

	onShow(() => {
		const info = storage.getUserInfo()
		if (info != null) {
			userInfo.value = info
		}
		hasLogin.value = storage.getToken() != '' || storage.getUserInfo() != null
		tokenLogin({})
			.then((res) => {
				if (res.code == 200 && res.data != null) {
					const data = res.data as UTSJSONObject
					storage.setToken(data['token'] != null ? (data['token'] as string) : '')
					storage.setUserInfo(res.data)
					hasLogin.value = true
					userInfo.value = data
				} else {
					storage.clearAuth()
					hasLogin.value = false
					userInfo.value = {} as UTSJSONObject
				}
			})
			.catch(() => {})
	})
</script>

<style lang="scss" scoped>
.container {
	min-height: 100vh;
	background-color: #f5f5f5;
	box-sizing: border-box;
}

.page-scroll {
	height: 100vh;
	box-sizing: border-box;
}

.page-inner {
	position: relative;
	padding-bottom: 160rpx;
}

.header-banner {
	position: relative;
	width: 100%;
}

.profile-wrap {
	margin-top: -104rpx;
	padding: 0 24rpx 24rpx;
	position: relative;
	z-index: 3;
}

.profile-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.avatar {
	overflow: hidden;
	width: 120rpx;
	height: 120rpx;
	border-radius: 60rpx;
	margin-right: 24rpx;
	flex-shrink: 0;
	border: 4rpx solid #fff;
	box-sizing: border-box;
}

.avatar-image {
	width: 100%;
	height: 100%;
}

.profile-text {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	justify-content: center;
}

.profile-name {
	font-size: 34rpx;
	font-weight: 600;
	color: #303133;
	margin-bottom: 8rpx;
}

.profile-name--muted {
	font-weight: 500;
	color: #606266;
}

.profile-sub {
	font-size: 26rpx;
	color: #909399;
}

.menu-group {
	margin: 0 24rpx;
}

.menu-grid-wrap {
	background-color: #ffffff;
	border-radius: 8rpx;
	overflow: hidden;
}

.menu-grid-title {
	display: block;
	padding: 24rpx 32rpx 8rpx;
	font-size: 28rpx;
	color: #333333;
	font-weight: 600;
}
</style>
