<template>
	<view class="container">
		<scroll-view class="page-scroll" scroll-y :show-scrollbar="false">
			<view class="page-inner">
				<view class="header-bg"></view>
				<view class="profile-wrap">
					<mms-card :shadow="true" :border="false">
						<view class="profile-row" @tap.stop="onProfileTap">
							<view class="avatar">
								<image class="avatar-image" :src="userInfo.headPortrait || defaultFace" mode="aspectFill"></image>
							</view>
							<view class="profile-text">
								<text v-if="hasLogin" class="profile-name">{{ userInfo.nickname || '暂无昵称' }}</text>
								<text v-if="hasLogin" class="profile-sub">{{ profilePhone }}</text>
								<text v-else class="profile-name profile-name--muted">点击登录 / 完善资料</text>
							</view>
							<mms-icon name="arrow-right" size="32rpx" color="#c0c4cc"></mms-icon>
						</view>
					</mms-card>
				</view>
				<mms-cell-group title="服务与内容" class="menu-group">
					<mms-cell
						v-for="(item, index) in serviceBar"
						:key="index"
						:title="item.title"
						:icon="item.iconName"
						:isLink="true"
						:border="index < serviceBar.length - 1"
						@click="onServiceTap(item)"
					></mms-cell>
				</mms-cell-group>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { getMmsUiConfig } from '@/uni_modules/mms-unix/config/mms-ui-config.uts'
	import { jumpTo } from '@/uni_modules/mms-unix/components/mms-tools/Ut.uts'
	import { storage } from '@/uni_modules/mms-unix/components/mms-tools/Storage.uts'
	import { tokenLogin } from '@/common/api/mallApi'
	import { getUserServiceItems } from './myServiceData'

	const defaultFace = computed((): string => getMmsUiConfig().avatarDefault)
	const serviceBar = computed(() => getUserServiceItems())
	const hasLogin = ref(storage.getToken() != '' || storage.getUserInfo() != null)
	const userInfo = ref(storage.getUserInfo() ?? {} as UTSJSONObject)

	const profilePhone = computed((): string => {
		const p = userInfo.value['phone']
		if (p == null || p === '') {
			return ''
		}
		return `${p}`
	})

	function checkLoginAndNav(url: string, requireLogin: boolean = false) {
		if (!hasLogin.value) {
			if (requireLogin) {
				setTimeout(() => {
					uni.showModal({
						title: '提示',
						content: '未登录，是否立即登录？',
						showCancel: true,
						cancelText: '取消',
						confirmText: '去登录',
						success: (res) => {
							if (res.confirm) {
								jumpTo('/pages_Me/login/login', 'to')
							}
						},
					})
				}, 50)
			} else {
				jumpTo(url)
			}
		} else {
			jumpTo(url)
		}
	}

	function onProfileTap() {
		checkLoginAndNav('/pages_Me/user_info/index', true)
	}

	function onServiceTap(item: { iconName: string; title: string; pages: string; requireLogin: boolean }) {
		checkLoginAndNav(item.pages, item.requireLogin === true)
	}

	onShow(() => {
		const info = storage.getUserInfo()
		if (info != null) {
			userInfo.value = info
		}
		hasLogin.value = storage.getToken() != '' || storage.getUserInfo() != null
		tokenLogin({})
			.then((res) => {
				if (res.code == 200 && res.data != null) {
					const data = res.data as UTSJSONObject
					storage.setToken(data['token'] != null ? (data['token'] as string) : '')
					storage.setUserInfo(res.data)
					hasLogin.value = true
					userInfo.value = data
				} else {
					storage.clearAuth()
					hasLogin.value = false
					userInfo.value = {} as UTSJSONObject
				}
			})
			.catch(() => {})
	})
</script>

<style lang="scss" scoped>
.container {
	min-height: 100vh;
	background-color: #f5f5f5;
	box-sizing: border-box;
}

.page-scroll {
	height: 100vh;
	box-sizing: border-box;
}

.page-inner {
	position: relative;
	padding-bottom: 160rpx;
}

.header-bg {
	height: 220rpx;
	background-color: #ff0844;
}

.profile-wrap {
	margin-top: -88rpx;
	padding: 0 24rpx 24rpx;
	position: relative;
}

.profile-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.avatar {
	overflow: hidden;
	width: 120rpx;
	height: 120rpx;
	border-radius: 60rpx;
	margin-right: 24rpx;
	flex-shrink: 0;
	border: 4rpx solid #fff;
	box-sizing: border-box;
}

.avatar-image {
	width: 100%;
	height: 100%;
}

.profile-text {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	justify-content: center;
}

.profile-name {
	font-size: 34rpx;
	font-weight: 600;
	color: #303133;
	margin-bottom: 8rpx;
}

.profile-name--muted {
	font-weight: 500;
	color: #606266;
}

.profile-sub {
	font-size: 26rpx;
	color: #909399;
}

.menu-group {
	margin: 0 24rpx;
}
</style>
